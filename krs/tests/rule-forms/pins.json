  "diagnostics": {
    "owise-with-priority": [
      "error[krs::syntax::invalid-rule-key]: owise applies where no other rule or equation applies, which no priority orders; write one of them"
    ],
    "priority-out-of-range": [
      "error[krs::syntax::invalid-rule-key]: k-rust ranks rule priorities 0..=254"
    ],
    "retired-priority": [
      "error[krs::syntax::retired-attribute]: `#[k::priority(..)]` is retired; write `#[k::equation(priority = 60)]`"
    ],
    "owise-simplification": [
      "error[krs::syntax::invalid-rule-key]: a simplification has its own `priority = N`, a simplifier hint; owise has no meaning there"
    ],
    "priority-alias": [
      "error[krs::syntax::invalid-rule-key]: a static production's clauses rewrite each of its applications into one term as it is read, so they never overlap and none is chosen against another: an order (`owise`, `priority`, `nondet`) means nothing on a clause"
    ],
    "unannotated-overlap": [
      "error[krs::analysis::overlapping-rule-heads]: rules `heads` and `tails` can both apply to the same configuration at the same priority; K would take either one (nondeterminism). If that is intended, put both in one group with `#[k::rule(nondet = NAME)]`; otherwise refine a pattern, add disjoint `where` sorts or complementary requires guards, or order them with `owise` or `priority = N`."
    ],
    "list-unit-overlap": [
      "error[krs::analysis::overlapping-rule-heads]: rules `last_job` and `next_job` can both apply to the same configuration at the same priority; K would take either one (nondeterminism). If that is intended, put both in one group with `#[k::rule(nondet = NAME)]`; otherwise refine a pattern, add disjoint `where` sorts or complementary requires guards, or order them with `owise` or `priority = N`."
    ],
    "single-member-group": [
      "error[krs::analysis::nondet-group]: nondet group `toss` has only one rule"
    ],
    "stale-member": [
      "error[krs::analysis::nondet-group]: rule `flip` is in nondet group `toss` but overlaps no other rule of the group"
    ],
    "mixed-priorities": [
      "error[krs::analysis::nondet-group]: nondet group `toss` mixes priorities 50 and 200; rules at different priorities never compete"
    ],
    "nondet-equation": [
      "error[krs::syntax::invalid-rule-key]: a function's equations define one value per argument; a nondeterministic group would give it several"
    ],
    "anywhere-readable": [
      "error[krs::syntax::invalid-rule-key]: a `for Sort` clause rewrites its subject where it heads the computation cell, and an `anywhere` rule rewrites it wherever it occurs: the clause form states no `anywhere` rule, which a `#[k::rule(anywhere)]` fn states"
    ],
    "anywhere-cells": [
      "error[krs::syntax::invalid-rule-key]: an anywhere rule applies to any subterm; write it term-shaped with #[k::rule(anywhere)] fn"
    ],
    "anywhere-priority": [
      "error[krs::syntax::invalid-rule-key]: an anywhere rule applies to any subterm, outside rule priority and the overlap check; it takes no `owise`, `priority`, or `nondet`"
    ],
    "binder-unused": [
      "error[krs::syntax::unsupported-rule-signature]: unsupported rule signature: binder `extra` is declared but does not occur in the subject"
    ],
    "binder-partial": [
      "error[krs::syntax::unsupported-rule-signature]: unsupported rule signature: typed term parameters must declare every term binder of the subject and function context, in first-occurrence order (hole binders included; `_`, remainders, HERE, instance labels and local binders excluded); a term sentence declares no binders or all of them, here `left, right`"
    ],
    "binder-misordered": [
      "error[krs::syntax::unsupported-rule-signature]: unsupported rule signature: typed term parameters must declare every term binder of the subject and function context, in first-occurrence order (hole binders included; `_`, remainders, HERE, instance labels and local binders excluded); a term sentence declares no binders or all of them, here `left, right`"
    ],
    "binder-incompatible": [
      "error[krs::analysis::incompatible-binder]: binder `value` is declared `Bool`, but an occurrence needs `Exp`"
    ],
    "fresh-no-generator": [
      "error[krs::analysis::no-fresh-generator]: fresh binder `l` has sort `Loc`, which has no generator; declare `#[k::function(total, fresh_generator, sort = Loc, syntax = \"..\")]` with one Int field (Int and Id have K's own)"
    ],
    "fresh-two-generators": [
      "error[krs::analysis::duplicate-fresh-generator]: sort `Loc` has two `fresh_generator` functions, `FreshLoc` and `OtherLoc`; K draws its fresh values from exactly one"
    ],
    "fresh-partial-generator": [
      "error[krs::analysis::invalid-fresh-generator]: `FreshLoc` is a `fresh_generator`, so it must be `total`: K calls it on every counter value"
    ],
    "desugar-mode-mismatch": [
      "error[krs::analysis::invalid-static-clause]: desugar clause `flip` expands `Static::Flip`, which is marked `#[k::alias]`: a clause takes its production's mode, so write `#[k::alias]` on the clause, or `#[k::desugar]` on the production"
    ],
    "desugar-without-clause": [
      "error[krs::analysis::invalid-static-clause]: `Static::Flip` is marked `#[k::desugar]` but no `#[k::desugar]` clause expands it, so nothing expands it; add a `#[k::desugar] fn` whose pattern is headed by `Static::Flip`"
    ],
    "desugar-requires": [
      "error[krs::syntax::invalid-rule-key]: a desugar clause has no `#[k::requires]`: K rewrites the definition and the program with it once, before anything runs, so there is nothing to test a condition against"
    ],
    "desugar-clause-payload": [
      "error[krs::syntax::invalid-rule-key]: recursion is a property of the production: write `recursive` on the production's `#[k::alias]` or `#[k::desugar]` marker, and a plain marker on its clauses"
    ],
    "local-rewrite-nested": [
      "error[krs::syntax::invalid-local-rewrite]: `k::rewrite!` (K's local =>) marks what changes inside the subject of a single-body rule or the hole of a context, once and outside any local pattern; here it stands in a `k::rewrite!` in the subject of a single-body `cells!` rule"
    ],
    "local-rewrite-unbound": [
      "error[krs::syntax::invalid-local-rewrite]: `other` on the right of `k::rewrite!` is not bound by the rule's left image (its subject with each rewrite replaced by its left side); bind it in the pattern, or qualify a unit constructor"
    ],
    "local-rewrite-outside": [
      "error[krs::syntax::invalid-local-rewrite]: `k::rewrite!` (K's local =>) is valid only inside the `k::cells!` or `k::term!` subject of a single-body `#[k::rule]` fn (one that returns `()`) or of a `#[k::context]` fn"
    ],
    "local-rewrite-with-result": [
      "error[krs::syntax::invalid-local-rewrite]: `k::rewrite!` belongs to a single-body rule, which returns `()`; a rule with a result already states the whole after-state"
    ],
    "local-rewrite-unchanged": [
      "error[krs::analysis::rule-changes-no-cell]: rule `assign` changes no cell: every cell it names keeps its content, so if it applies, it applies again to the configuration it leaves, forever, and changes nothing"
    ],
    "heat-cool-hole-not-left": [
      "error[krs::analysis::invalid-heat-cool]: a heat rule must match its hole on the left side; K adds 'requires notBool isKResult(HOLE)', a condition on that subterm, and `x` does not occur there"
    ],
    "heat-cool-hole-twice": [
      "error[krs::analysis::invalid-heat-cool]: the hole `h` of a heat rule names one subterm, but the left side binds it 2 times; bind the other occurrences with another name"
    ],
    "context-hole-outside-k": [
      "error[krs::analysis::invalid-context]: the context's hole `h` lies in the `focus` cell, but heating moves the hole to the front of k; constrain other cells, but put the hole in k"
    ],
    "context-bad-rewrite": [
      "error[krs::analysis::invalid-context]: a context may rewrite only its hole, to a term that contains it: K requires HOLE => term-containing-HOLE, here `k::rewrite!(h => f(h))`"
    ],
    "context-hole-absent": [
      "error[krs::analysis::invalid-context]: a context names the subterm K evaluates with `hole = x`, but `x` does not occur in its pattern; K requires exactly one HOLE"
    ],
    "alias-without-clause": [
      "error[krs::analysis::invalid-static-clause]: `Static::Flip` is marked `#[k::alias]` but no `#[k::alias]` clause expands it, so nothing expands it; add a `#[k::alias] fn` whose pattern is headed by `Static::Flip`"
    ],
    "owise-after-priority": [
      "error[krs::analysis::priority-after-owise]: rule `flip_low` has priority 250 and can apply where the `owise` rule `flip_high` does; `owise` comes after every other rule that applies, but the emitted `owise` attribute fixes no rank against priorities 200 to 254, so the two rules have no single order"
    ],
    "owise-equation-after-priority": [
      "error[krs::analysis::priority-after-owise]: equation `grade_a` of `Grade` has priority 200 beside the `owise` equation `grade_f`; `owise` gives the value only where no other equation of `Grade` applies, but the emitted `owise` attribute fixes no rank against priorities 200 to 254, so a route that tries equations in order may try the `owise` one first"
    ]
