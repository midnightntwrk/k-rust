    "collection-without-type": [
      "error[krs::syntax::invalid-cell-attribute]: invalid `cell` attribute: a `multiplicity = \"*\"` collection needs `cell_type = \"Set\"`, `\"Map\"`, or `\"List\"`"
    ],
    "collection-siblings": [
      "error[krs::analysis::collection-siblings]: the collection cell `job` shares its parent with other cells; K requires a `multiplicity = \"*\"` cell to be its parent's only child, so give it a `#[k::cell]` struct of its own"
    ],
    "optional-plain-field": [
      "error[krs::syntax::unsupported-configuration-field]: unsupported fixed configuration field: a `multiplicity = \"?\"` cell is declared `Option<T>`, T its leaf sort or nested cell struct"
    ],
    "optional-without-multiplicity": [
      "error[krs::syntax::unsupported-configuration-field]: unsupported fixed configuration field: an Option field is an optional cell: add `multiplicity = \"?\"` to its `#[k::cell(..)]`"
    ],
    "optional-none-template": [
      "error[krs::syntax::unsupported-initializer-body]: unsupported declarative initializer body: `None` gives the `?` cell no template, which K needs to know what a created cell looks like; write `k::absent!(..)` with its template for a cell that starts absent, or `Some(..)` with its value for one that starts present"
    ],
    "unknown-instance-label": [
      "error[krs::analysis::invalid-record-update]: the entry of the cell `job` updates a record (`..base`) whose base the sentence does not match: an update takes the fields of a record of its own constructor that the subject names `base @ ..`, such as an instance its subject's instance list labels; no subject instance is labelled `ghost @`; label the one the result updates where the subject matches it, `ghost @ Job { .. }`, or create the instance from a record of its own"
    ],
    "list-braces": [
      "error[krs::analysis::collection-entry]: the cell `job` is a List collection, whose instances are positional: they stand in brackets, at the front before `..` and at the back after it, not in braces; write its entry as `[Job { .. }, ..]`"
