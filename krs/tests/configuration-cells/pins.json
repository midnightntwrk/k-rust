  "diagnostics": {
    "unguarded-framed-rule": [
      "error[krs::analysis::always-enabled-rule]: rule `burn` is always enabled, so execution never terminates: it leaves the computation cell out, every cell pattern is a variable or `_` of the cell's sort, and it has no requires guard"
    ],
    "identity-framed-rule": [
      "error[krs::analysis::rule-changes-no-cell]: rule `idle` changes no cell: every cell it names keeps its content and it leaves the computation cell out, so applying it changes nothing"
    ],
    "group-and-leaf": [
      "error[krs::analysis::group-and-descendant]: rule `peek` selects the nested cell `frame` and the cell `pc` inside it; the whole-cell entry `frame` already names every cell below it, so select one or the other"
    ],
    "reused-cell-declaration": [
      "error[krs::analysis::ambiguous-cell-sort]: cell declaration `Frame` is the content of more than one cell field (`current`, `saved`), so its K cell sort is ambiguous; declare one struct per nested cell"
    ],
    "group-literal": [
      "error[krs::syntax::invalid-state-macro]: invalid `cells!` payload: nested cell entries are a binder, `_`, or fragment!"
    ],
    "cell-bag": [
      "error[krs::syntax::invalid-cell-attribute]: invalid `cell` attribute: cell bags are unsupported by K's LLVM and Haskell backends; use cell_type = \"Set\", \"Map\", or \"List\""
    ],
    "collection-without-type": [
      "error[krs::syntax::invalid-cell-attribute]: invalid `cell` attribute: a `multiplicity = \"*\"` collection needs `cell_type = \"Set\"`, `\"Map\"`, or `\"List\"`"
    ],
    "collection-siblings": [
      "error[krs::analysis::collection-siblings]: the collection cell `job` shares its parent with other cells; K requires a `multiplicity = \"*\"` cell to be its parent's only child, so give it a `#[k::cell]` struct of its own"
    ],
    "optional-plain-field": [
      "error[krs::syntax::unsupported-configuration-field]: unsupported fixed configuration field: a `multiplicity = \"?\"` cell is declared `Option<T>`, T its leaf sort or nested cell struct"
    ],
    "optional-without-multiplicity": [
      "error[krs::syntax::unsupported-configuration-field]: unsupported fixed configuration field: an Option field is an optional cell: add `multiplicity = \"?\"` to its `#[k::cell(..)]`"
    ],
    "optional-none-template": [
      "error[krs::syntax::unsupported-initializer-body]: unsupported declarative initializer body: K needs a template for a `?` cell; write Some(<template>) and add `initial` if the cell starts present"
    ],
    "unknown-instance-label": [
      "error[krs::analysis::unknown-instance-label]: `..ghost` names no instance of `job` labelled `ghost @` in the pattern"
    ],
    "list-braces": [
      "error[krs::analysis::collection-entry]: List collections are positional: write `job: [ .. ]`, with instances at the front before `..` and at the back after it"
    ],
    "list-both-ends": [
      "error[krs::analysis::collection-entry]: this entry names instances at both ends of the List collection `job`; a KRS rule changes either the front (before `..`) or the back (after it), so split it into two rules"
    ],
    "map-created-without-key": [
      "error[krs::analysis::map-collection-key]: a new instance of the Map collection `job` states its key: write `id: ..`, its first child"
    ],
    "stream-in-optional": [
      "error[krs::analysis::console-cell]: stream cell `output` is inside the repeated cell `console`; K connects a stream to one cell, so it must be outside every multiplicity cell"
    ],
    "optional-config-var": [
      "error[krs::analysis::collection-config-var-without-initial]: the `multiplicity = \"?\"` cell `counter` reads a configuration variable, so it starts present although it is not `initial`; add `initial` to its `#[k::cell]` to say so"
    ]
