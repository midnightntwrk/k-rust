[package]
name = "krs-grammar-removed-syntax-root"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
k = { package = "krs", path = @KRS_CRATE_PATH@ }

[package.metadata.krs]
k-namespace = "KRS-REMOVED-SYNTAX-ROOT"

[package.metadata.krs.definitions.main]
syntax-root = "crate"

[workspace]
resolver = "3"
