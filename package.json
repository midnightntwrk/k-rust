{
  "name": "k-in-k2-reconnaissance",
  "private": true,
  "type": "module",
  "scripts": {
    "oracle": "bun run oracle/src/cli.ts",
    "oracle:smoke": "bun run oracle/src/cli.ts smoke oracle/suites/smoke.json --out oracle/results/smoke",
    "check:types": "tsc --noEmit",
    "test": "bun test oracle/test",
    "p1": "bun run p1/src/probe.ts",
    "p2": "bun run p2/src/probe.ts",
    "p3": "bun run p3/src/probe.ts",
    "r2:g:transport": "bash spine/definition-transport/replay.sh",
    "r2:g:patch": "bash spine/definition-transport/patch-replay.sh",
    "r2:g:transaction": "bash spine/definition-transport/transaction-replay.sh",
    "r2:g:pre-cf-seam": "bash investigations/r2-g-04-pre-cf-observation-seam/verify.sh",
    "r2:g:pre-cf-hook": "bash investigations/r2-g-05-pre-cf-hook-prototype/verify.sh",
    "r2:g:configuration": "bash spine/configuration-augmentation/verify.sh",
    "r2:g:observation": "bash spine/rule-observation/verify.sh",
    "r3:g:rule-applied-trace": "bash spine/rule-applied-trace/verify.sh",
    "r3:g:trace-configuration": "bash spine/trace-configuration-composition/verify.sh",
    "r3:g:rule-applied-head-match": "bash spine/rule-applied-head-match/verify.sh",
    "r3:g:rule-applied-next-event": "bash spine/rule-applied-next-event/verify.sh",
    "r3:g:rule-applied-allowlist": "bash spine/rule-applied-allowlist/verify.sh",
    "check": "bun run check:types && bun test oracle/test p1/test p2/test p3/test"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^26.1.2",
    "typescript": "^5.9.2"
  }
}
