{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "types": ["bun", "node"]
  },
  "include": [
    "oracle/src/**/*.ts", "oracle/test/**/*.ts",
    "p1/src/**/*.ts", "p1/test/**/*.ts",
    "p2/src/**/*.ts", "p2/test/**/*.ts",
    "p3/src/**/*.ts", "p3/test/**/*.ts"
  ]
}
