[package]
name = "krs-cli-oracle-claims"
version = "0.0.0"
edition = "2024"
publish = false

[dependencies]
krs = { path = @KRS_CRATE_PATH@ }

[package.metadata.krs]
k-namespace = "ORG-KRS-CLI-CLAIMS"

[package.metadata.krs.definitions.main]
root = "crate"
syntax-root = "crate"

[workspace]
resolver = "3"
