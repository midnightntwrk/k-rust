    refine Eval.clause (cl := elBotCl) (σ := enumFrom 0 [.ctor 412 []]) mkElDef_lookup (List.mem_cons_self ..)
      (ws_enum (.cons ht .nil))
      (.cons (.as (.ctor ctor_412 .nil) rfl) .nil)
