    rcases hm with rfl | rfl
    · exact absurd hp (by decide)
    · exact absurd hp (by decide)
  · next hn1 =>
      -- el-def
      refine Eval.clause (cl := elDefCl) (σ := enumFrom 0 [t]) mkElDef_lookup (List.mem_cons_of_mem _ (List.mem_cons_self ..))
