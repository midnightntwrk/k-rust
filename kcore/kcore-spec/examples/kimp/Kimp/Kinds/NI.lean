set_option autoImplicit false
set_option maxRecDepth 1000000

namespace Kimp
open KCore

/-- The policy: the positions of the cells kept secret, then the keyed positions of the maps whose
entries are secret except at the observed keys. -/
noncomputable def high : NI.HPaths := NI.highOf defn.pres [] ++ NI.keyedOf defn.pres ["env"]

theorem high_eq : high = [[1, 0, 1000000]] := by decide +kernel

/-- The rules the decided condition does not cover:
- 19 (`CALC.var`): the left-hand side reads a secret position
-/
def niObl : List Nat := [19]

theorem ni_cond : Kind.decides (Kind.listCond c.rules (NI.cellsCond c high)) niObl (List.range c.rules.length) = true := by
  decide +kernel

/-- **Noninterference** for the secret cells, given the listed rules, for every interpretation of the parameters and every set of observed keys `lo`. -/
theorem noninterference (H : HookParams) (lo : GroundTerm → Prop)
    (h19 : ∀ r, c.rules[19]? = some r → NI.RuleUnwinds (c.withHooks H) (NI.LowEq (c.withHooks H) lo high) r) :
    NI.TINI (c.withHooks H) (NI.LowEq (c.withHooks H) lo high) (NI.Stuck (c.withHooks H))
      (NI.LowEq (c.withHooks H) lo high) :=
  Kind.of_decided (NI.cellsKindAll c lo high H (fun _ _ _ h h' => deterministic H h h'))
    (NI.cellsDeciderAll c lo high H) niObl ni_cond (List.forall_mem_cons.mpr ⟨h19, fun _ h => nomatch h⟩)

end Kimp
