import KcoreSpec.Tie
import Peano.Tie.Wf
import Peano.Tie.Parse
import Peano.Tie.Emit
/- Generated by `kcore gen` (kcore-spec/KcoreGen.lean); not edited by hand. The KORE is tied: `defn` is its parse, well formed, and its `emit` is the KORE up to sentence order. -/
set_option autoImplicit false
set_option maxRecDepth 1000000

namespace Peano

theorem tied : KCore.Tied kore := KCore.Tied.of_parts parse_defn wf_defn emit_defn

#eval show Lean.CoreM Unit from do
  let axs ← Lean.collectAxioms ``tied
  unless axs.all ([``propext, ``Classical.choice, ``Quot.sound].contains ·) do
    throwError "axioms: {axs}"

end Peano
