theorem term_run : checkRun c 100 term_start term_steps term_final = true := by decide +kernel

/-- krust's run is a run of `Step`, for every interpretation of the parameters. -/
theorem term_reaches (H : HookParams) : ∃ (hs : (c.withHooks H).sortOf term_start = some topCellSort)
    (hf : (c.withHooks H).sortOf term_final = some topCellSort),
    Reach (Step (c.withHooks H)) ⟨_, hs⟩ ⟨_, hf⟩ :=
  checkRun_sound ok srReady matchReady term_run H

theorem term_stuck : stuckCheck c 100 term_final = true := by decide +kernel

/-- The run's last configuration has no successor, for every interpretation of the parameters. -/
theorem term_ends (H : HookParams) (hf : (c.withHooks H).sortOf term_final = some topCellSort) :
    ∀ y, ¬ Step (c.withHooks H) ⟨_, hf⟩ y :=
  stuckCheck_sound ok srReady matchReady H (coherent_withHooks H) (x := ⟨_, hf⟩) term_stuck

end Peano.Certs
