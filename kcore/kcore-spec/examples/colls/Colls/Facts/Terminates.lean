import Colls.Facts
import KcoreSpec.Terminates
import KcoreSpec.Totals
/- Generated by `kcore gen` (kcore-spec/KcoreGen.lean); not edited by hand. Termination and totality of the functions: 0 named for termination (calling a later function, or a self call the certificate does not show to decrease), 1 `[total]` functions named for totality (not confirmed by `totalOK`). -/
set_option autoImplicit false
set_option maxRecDepth 1000000

namespace Colls
open KCore

/-- The functions whose termination is named (`orderObligations`, the certificate's
`obligations`: the first conjunct of `KCore.Obligations`). -/
theorem named_terminates : defn.sem.orderObligations ++ defn.cert.obligations defn.sem = [] := by
  decide +kernel

/-- **Every function terminates** (`KCore.Terminates`: a result at every argument list of its
argument sorts), the sort predicates among them: no function is named. -/
theorem terminates : ∀ f, Terminates c f :=
  terminates_of_nil okAll srReady (Semantics.ovlCase_of (by decide +kernel)) defn.cert named_terminates

/-- The functions declared `[total]` whose totality is named (`totalObligations`: the second
conjunct of `KCore.Obligations`). -/
theorem named_totals : defn.sem.totalObligations = [419] := by decide +kernel

/-- **Every function declared `[total]` is total** (`KCore.Total`: a value at every argument list
of its argument sorts), the sort predicates among them, given the named ones' totality. -/
theorem totals (htot : ∀ g ∈ ([419] : List Sym), Total c g) :
    ∀ f fn, c.lookupFn f = some fn → fn.total = true → Total c f :=
  totals_of_order okAll srReady (Semantics.ovlCase_of (by decide +kernel)) terminates (by rw [named_totals]; exact htot)

end Colls
