    (k := ⟨KCore.topLabel, [Colls.Srt.«KCell», Colls.Srt.«StackCell», Colls.Srt.«SumCell», Colls.Srt.«AcctsCell», KCore.Srt.counter], KCore.Srt.top⟩) h (by kernel_defeq)
  exact ⟨p.1, p.2.1, p.2.2.1, p.2.2.2.1, p.2.2.2.2.1⟩

