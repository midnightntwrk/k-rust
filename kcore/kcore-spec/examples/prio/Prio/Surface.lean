/-! ## What a step by `fire` reads of the definition -/

/-- No rule has a priority below 40: a rule of priority 40 waits on no other. -/
theorem prio_floor : c.rules.all (fun r => Nat.ble 40 r.prio) = true := by decide +kernel

/-- The facts `fire` (KcoreSpec/FireTac.lean) reads of the definition (`KCore.FireFacts`). -/
instance fireFacts : FireFacts c := ⟨ok, srReady, matchReady, 40, prio_floor⟩

