import KcoreSpec.Tie
import CollsList.Facts.Ok
import CollsList.Facts.Lazy
import CollsList.Wf.Faith
import CollsList.Wf.SortNames
import CollsList.Wf.SymNames
/- Generated by `kcore gen` (kcore-spec/KcoreGen.lean); not edited by hand. `wf defn`, conjunct by conjunct: the names' distinctness by codes, `ok` from the facts, the rest by the kernel. -/
set_option autoImplicit false
set_option maxRecDepth 1000000

namespace CollsList
open KCore

theorem names_rest : (defn.sem.hooksApart && defn.sem.predsApart && defn.sem.idsOK) = true := by decide +kernel
theorem cert_ok : defn.cert.ok defn.sem = true := by decide +kernel
theorem pres_ok : defn.pres.ok defn.sem = true := by decide +kernel
theorem params_ok : defn.paramsOK = true := by decide +kernel
theorem overloads_ok : defn.sem.overloadsOK = true := by decide +kernel

/-- The named obligations `wf` does not decide (`KCore.Obligations`): the functions calling a later
one, the self-calling functions with no decreasing argument, and the `[total]` functions `totalOK`
does not confirm. -/
theorem obligations : defn.sem.orderObligations = [] ∧ defn.cert.obligations defn.sem = [] ∧
    defn.sem.totalObligations = [] := by decide +kernel

/-- The functions whose equations `fnExclusiveOK` does not show to agree: that each two of one
priority are coherent, in both orders (`ClausesAgree`, `Coherent`), is a named obligation
(`KCore.Obligations`). -/
theorem agree_obligations : defn.sem.agreeObligations = [] := by decide +kernel

/-- The clauses whose patterns `clauseFixed` does not show to fix their variables, as (function,
index of the clause): that each is coherent with itself (`MatchIndependent`) is a named obligation
(`KCore.Obligations`). The lazy obligations are `lazy_obligations` (`CollsList.Facts.Lazy`). -/
theorem match_obligations : defn.sem.matchObligations = [] := by decide +kernel

/-- No obligation is named: `KCore.Obligations` holds of the definition. -/
theorem obligations_nil : Obligations defn :=
  Obligations.of_nil (by rw [obligations.1, obligations.2.1]; rfl) obligations.2.2 agree_obligations
    match_obligations lazy_obligations

theorem wf_defn : wf defn = true := wf_of_parts_all sorts_distinct syms_distinct names_rest okAll cert_ok pres_ok params_ok faith_ok overloads_ok

end CollsList
