/-- No rule has a priority below 50: a rule of priority 50 waits on no other. -/
theorem prio_floor : c.rules.all (fun r => Nat.ble 50 r.prio) = true := by decide +kernel

/-- The facts `fire` (KcoreSpec/FireTac.lean) reads of the definition (`KCore.FireFacts`). -/
