/-- Every rule is one of the rules above: a case split gives one case per rule, whose data is its
lemma's. -/
theorem rules_cases {r : Rule} (h : r ∈ c.rules) :
    c.rules[0]? = some r ∨
    c.rules[1]? = some r ∨
    c.rules[2]? = some r ∨
    c.rules[3]? = some r ∨
    c.rules[4]? = some r :=
  atOneOf_of_mem (n := 5) (by decide +kernel) h

