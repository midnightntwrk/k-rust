import Vault.Kinds.Det
import KcoreSpec.NICells
/- Generated by `kcore gen` (kcore-spec/KcoreGen.lean); not edited by hand. Noninterference for the secret cells `sec`: from configurations equal outside them, runs that both stop end equal outside them; for every interpretation of the parameters. -/
set_option autoImplicit false
set_option maxRecDepth 1000000

namespace Vault
open KCore

/-- The policy: the positions of the cells kept secret, then the keyed positions of the maps whose
entries are secret except at the observed keys. -/
noncomputable def high : NI.HPaths := NI.highOf defn.pres ["sec"] ++ NI.keyedOf defn.pres []

theorem high_eq : high = [[2, 0]] := by decide +kernel

/-- The rules the decided condition does not cover (none). -/
def niObl : List Nat := []

theorem ni_cond : Kind.decides (Kind.listCond c.rules (NI.cellsCond c high)) niObl (List.range c.rules.length) = true := by
  decide +kernel

/-- **Noninterference** for the secret cells, for every interpretation of the parameters and every set of observed keys `lo`. -/
theorem noninterference (H : HookParams) (lo : GroundTerm → Prop) :
    NI.TINI (c.withHooks H) (NI.LowEq (c.withHooks H) lo high) (NI.Stuck (c.withHooks H))
      (NI.LowEq (c.withHooks H) lo high) :=
  Kind.of_decided (NI.cellsKindAll c lo high H (fun _ _ _ h h' => deterministic H h h'))
    (NI.cellsDeciderAll c lo high H) niObl ni_cond (fun _ h => nomatch h)

end Vault
