namespace Kryp

/-- **A configuration's cells have their sorts**: the arguments of the top cell of a term of the
configuration sort have the top cell's argument sorts. -/
theorem top_sorts {x0 x1 : KCore.GroundTerm}
    (h : c.sortOf (.ctor KCore.topLabel [x0, x1]) = some KCore.topCellSort) :
    c.sortOf x0 = some Kryp.Srt.«KCell» ∧ c.sortOf x1 = some KCore.Srt.counter := by
  have p := KCore.sortsAre_of_ctor (c := c) (ts := [x0, x1])
    (k := ⟨KCore.topLabel, [Kryp.Srt.«KCell», KCore.Srt.counter], KCore.Srt.top⟩) h (by kernel_defeq)
  exact ⟨p.1, p.2.1⟩

end Kryp
