import KcoreSpec.Tie
import Kryp.Core
/- Generated by `kcore gen` (kcore-spec/KcoreGen.lean); not edited by hand. The emitted KORE's 354 symbol and alias names are distinct (their codes, sorted, ascend). -/
set_option autoImplicit false
set_option maxRecDepth 1000000

namespace Kryp

theorem syms_distinct : KoreAML.Distinct.codesDistinct 9 (defn.emit.symbolDecls.map (·.name) ++ defn.emit.aliasNames) = true := by decide +kernel

end Kryp
