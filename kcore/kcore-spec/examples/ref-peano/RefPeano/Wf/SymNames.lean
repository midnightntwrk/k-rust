import KcoreSpec.Tie
import RefPeano.Core
/- Generated by `kcore gen` (kcore-spec/KcoreGen.lean); not edited by hand. The emitted KORE's 97 symbol and alias names are distinct (their codes, sorted, ascend). -/
set_option autoImplicit false
set_option maxRecDepth 1000000

namespace RefPeano

theorem syms_distinct : KoreAML.Distinct.codesDistinct 7 (defn.emit.symbolDecls.map (·.name) ++ defn.emit.aliasNames) = true := by decide +kernel

end RefPeano
