theorem gSymCodes_eq :
    (kernelSyms c).map (fun k => KoreAML.Distinct.strCode (c.symName k.name)) = gSymCodes := by
  decide +kernel

/-- Two names are equal exactly where their codes are (`strCode_inj`). -/
theorem symCode_beq (a b : String) :
    (KoreAML.Distinct.strCode a == KoreAML.Distinct.strCode b) = (a == b) := by
  apply Bool.eq_iff_iff.mpr
  simp only [beq_iff_eq]
  exact ⟨fun h => KoreAML.Distinct.strCode_inj h, fun h => h ▸ rfl⟩

/-- Γ has a symbol under the name `n`. -/
noncomputable def hasSym (n : String) : Bool := (kernelSyms c).any fun k => c.symName k.name == n

noncomputable def plainSorts : List SortDecl := kore.sortDecls.filter (·.params.isEmpty)
noncomputable def plainSyms : List SymbolDecl := kore.symbolDecls.filter fun sd => sd.params.isEmpty && hasSym sd.name
noncomputable def declItems : List Item := plainSorts.map sortConstantItem ++ plainSyms.map arityItem

/-- The item is one of `sigItems c`, pattern for pattern. -/
noncomputable def inSigItems (it : Item) : Bool := (sigItems c).any (·.pat == it.pat)

/-- `hasSym` read from the literal: the code of `n` is one of Γ's names' codes. -/
noncomputable def hasSymL (n : String) : Bool := gSymCodes.any (· == KoreAML.Distinct.strCode n)

theorem hasSymL_eq : hasSymL = hasSym := by
  funext n
  unfold hasSymL hasSym
  rw [← gSymCodes_eq]
  simp only [List.any_map, Function.comp_def, symCode_beq]

noncomputable def plainSymsL : List SymbolDecl :=
  kore.symbolDecls.filter fun sd => sd.params.isEmpty && hasSymL sd.name
noncomputable def declItemsL : List Item := plainSorts.map sortConstantItem ++ plainSymsL.map arityItem

theorem plainSymsL_eq : plainSymsL = plainSyms := by unfold plainSymsL plainSyms; rw [hasSymL_eq]
theorem declItemsL_eq : declItemsL = declItems := by unfold declItemsL declItems; rw [plainSymsL_eq]

theorem declsE_0 : (((declItemsL).drop 0).take 25).all inSigItems = true := by decide +kernel
theorem declsE_25 : (((declItemsL).drop 25).take 25).all inSigItems = true := by decide +kernel
theorem declsE_50 : (((declItemsL).drop 50).take 25).all inSigItems = true := by decide +kernel
theorem declsE_75 : (((declItemsL).drop 75).take 25).all inSigItems = true := by decide +kernel
theorem declsE_100 : (((declItemsL).drop 100).take 25).all inSigItems = true := by decide +kernel
theorem declsE_125 : (((declItemsL).drop 125).take 25).all inSigItems = true := by decide +kernel
theorem declsE_150 : (((declItemsL).drop 150).take 25).all inSigItems = true := by decide +kernel
theorem declsE_175 : (((declItemsL).drop 175).take 25).all inSigItems = true := by decide +kernel
theorem declsE_200 : (((declItemsL).drop 200).take 25).all inSigItems = true := by decide +kernel
theorem declsE_225 : (((declItemsL).drop 225).take 25).all inSigItems = true := by decide +kernel
theorem declsE_250 : ((declItemsL).drop 250).all inSigItems = true := by decide +kernel

theorem decls_in_sig : declItems.all inSigItems = true := by
  rw [← declItemsL_eq]
  exact tieAllE_whole (p := inSigItems) <|
      tieAllE_range (a := 0) (n := 25) declsE_0 <|
      tieAllE_range (a := 25) (n := 25) declsE_25 <|
      tieAllE_range (a := 50) (n := 25) declsE_50 <|
      tieAllE_range (a := 75) (n := 25) declsE_75 <|
      tieAllE_range (a := 100) (n := 25) declsE_100 <|
      tieAllE_range (a := 125) (n := 25) declsE_125 <|
      tieAllE_range (a := 150) (n := 25) declsE_150 <|
      tieAllE_range (a := 175) (n := 25) declsE_175 <|
      tieAllE_range (a := 200) (n := 25) declsE_200 <|
      tieAllE_range (a := 225) (n := 25) declsE_225 <|
      declsE_250

/-- **E for the declarations**: Γ entails the item of each declaration without sort parameters of
a symbol Γ has, for every H. -/
theorem decls_entailed (H : HookParams) : ∀ it ∈ declItems, Γ (cH H) ⊧ it.pat := by
  intro it hit M _ I hI
  have h1 : (sigItems c).any (·.pat == it.pat) = true := List.all_eq_true.mp decls_in_sig it hit
  obtain ⟨it', hit', he⟩ := List.any_eq_true.mp h1
  rw [← of_decide_eq_true he]
  exact sat_sigItem hI (by rw [sigItems_withHooks]; exact hit')

end KCore.TieE2CellsStreamIn

#check @KCore.TieE2CellsStreamIn.decls_entailed
#print axioms KCore.TieE2CellsStreamIn.decls_entailed
