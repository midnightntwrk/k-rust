theorem gInjCodes_eq : injCodesOf c = gInjCodes := by decide +kernel

/-- No code of Γ's symbol names holds the byte of `{`, so the decoder reads none of the names as an
instance (`noInst_of_codes`). -/
theorem gSymCodes_noInst : gSymCodes.all (fun x => !Faithful.instCoded x) = true := by decide +kernel

/-- `gammaHasHead_coded` at this text. -/
theorem heads_coded : gammaHasHead c = hasHeadCoded gSymCodes gInjCodes :=
  gammaHasHead_coded gSymCodes_eq gInjCodes_eq gSymCodes_noInst

/-- The literal's equation in the form `symCodesOf` states. -/
theorem symCodes_eq : symCodesOf c = gSymCodes := gSymCodes_eq

/-- Heads of each kind, decided on the codes. -/
theorem coded_cases :
    hasHeadCoded gSymCodes gInjCodes ("kseq", []) = true ∧
    hasHeadCoded gSymCodes gInjCodes ("inj", [srt "KCell", srt "KCellOpt"]) = true ∧
    hasHeadCoded gSymCodes gInjCodes ("inj", [srt "KCellOpt", srt "KCell"]) = false ∧
    hasHeadCoded gSymCodes gInjCodes ("kseq", [srt "K"]) = false ∧
    hasHeadCoded gSymCodes gInjCodes ("LblnoSuchSymbol", []) = false := by decide +kernel

/-- The same heads, of `gammaHasHead c`. -/
theorem gamma_cases :
    gammaHasHead c ("kseq", []) = true ∧
    gammaHasHead c ("inj", [srt "KCell", srt "KCellOpt"]) = true ∧
    gammaHasHead c ("inj", [srt "KCellOpt", srt "KCell"]) = false ∧
    gammaHasHead c ("kseq", [srt "K"]) = false ∧
    gammaHasHead c ("LblnoSuchSymbol", []) = false := by
  rw [heads_coded]; exact coded_cases

/-! ## The bridges at this text -/

theorem noInst : (kernelSyms c).all (fun k => (instDecode? (c.symName k.name)).isNone) = true :=
  noInst_of_codes gSymCodes_eq gSymCodes_noInst

theorem anySym_kseq : (kernelSyms c).any (fun k => c.symName k.name == "kseq") = true := by
  rw [anySym_codes_tc symCodes_eq]; decide +kernel

theorem hasSymL_kseq : gSymCodes.any (· == KoreAML.Distinct.strCode "kseq") =
    (kernelSyms c).any (fun k => c.symName k.name == "kseq") := hasSymL_codes_tc symCodes_eq "kseq"

theorem contains_kseq : ["dotk", "kseq"].contains "kseq" =
    (["dotk", "kseq"].map KoreAML.Distinct.strCode).contains (KoreAML.Distinct.strCode "kseq") :=
  contains_strCode _ _

theorem headCode_kseq : (KoreAML.Distinct.strCode "kseq" == KoreAML.Distinct.strCode "dotk" &&
    decide (([] : List Kore.KSort) = [])) = decide (("kseq", ([] : List Kore.KSort)) = ("dotk", [])) :=
  headCode_eq_tc ("kseq", []) ("dotk", [])

theorem symCode_kseq :
    (KoreAML.Distinct.strCode "kseq" == KoreAML.Distinct.strCode "dotk") = ("kseq" == "dotk") :=
  symCode_beq_tc _ _

theorem srt_code : srt "KCell" = .ctor ⟨⟨"SortKCell"⟩⟩ [] ↔
    sortCode? (.ctor ⟨⟨"SortKCell"⟩⟩ []) = some (KoreAML.Distinct.strCode ("Sort" ++ "KCell")) :=
  srt_eq_iff_code _ _

