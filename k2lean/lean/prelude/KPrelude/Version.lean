import Lean

/-! The release of the `k2lean` package, and the check that a generated library is built against
the release that generated it (PKG-5). Lake uses the root package's revision of a package that
several packages require under one name, without a word when another requires a different one,
so the generated library checks it itself. -/

namespace KPrelude

/-- The k2lean release this package is: `dev` in the k-rust checkout; set by the release. -/
def version : String := "dev"

open Lean Elab Command in
/-- `#k2l_check_prelude "V"`: fail unless this package is k2lean `V`, or either is `dev`. A generated
library's statements are about the hook models of the release that generated it (`contract.md`
§2), so it is built against that release only. -/
elab "#k2l_check_prelude " v:str : command => do
  let want := v.getString
  unless want == "dev" || version == "dev" || want == version do
    throwError m!"generated by k2lean {want}, built against the k2lean package {version}: regenerate the library, or require k2lean at {want} in the root package"

end KPrelude
