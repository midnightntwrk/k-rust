import KPrelude.InvColl
import KPrelude.Tactic

/-!
# K list folds as element-wise predicates

A K invariant over a collection is usually written as a fold:

```k
rule allValues(.List) => true
rule allValues(ListItem(V) L) => isValue(V) andBool allValues(L)
```

Its generated Lean definition is `Option`-valued and well-founded recursive, so neither `simp`
nor a preservation lemma can see through it. Lists are freely generated by `.List` and
`ListItem(X) L`, so the two equations determine the function on every list:
`f l = some true` exactly when every element `x` of `l` satisfies `φ x = true`
(`ListHook.all_iff_of_eqns`). With that, the collection lemmas of `KPrelude.InvColl` apply.

- `ListHook.all_iff_of_eqns` (`φ(X) andBool f(L)`) and `ListHook.all_iff_of_eqns'`
  (`f(L) andBool φ(X)`) take the two K equations as hypotheses.
- `k2l_fold_eqn f` proves either equation of a generated fold `f` from its definition (one
  unfolding, then the cases of the list match).
- `ListHook.elemsOn_values_iff` (`@[k2l_pres]`) turns a predicate on `values(M)` into one on the
  bindings of `M`, so `MapHook.entriesOn_update` and its siblings apply.

This module is imported by the generated `Invariants.lean` only, so the `@[k2l_pres]` lemma here
does not change `k2l_preserve` elsewhere.
-/

namespace KPrelude

namespace ListHook

open ListIso

variable {L E : Type} [ListIso L E]

/-- `ListItem(X) REST` is never `.List`. -/
theorem concat_element_ne_unit (x : E) (t : L) : concat (element x) t ≠ (unit : L) := by
  intro h
  have := congrArg toList h
  simp [concat, element, unit, toList_ofList] at this

/-- `ListItem(X) REST` is the list `X :: REST`. -/
theorem concat_element_ofList (x : E) (xs : List E) :
    concat (element x) (ofList xs : L) = ofList (x :: xs) := by
  unfold concat element
  rw [toList_ofList, toList_ofList]
  rfl

private theorem bind_and_eq_some_true {o : Option Bool} {b : Bool} :
    (o.bind fun r => some (BoolHook.and b r)) = some true ↔ b = true ∧ o = some true := by
  cases o with
  | none => simp
  | some r => cases b <;> cases r <;> simp [BoolHook.and]

private theorem bind_and'_eq_some_true {o : Option Bool} {b : Bool} :
    (o.bind fun r => some (BoolHook.and r b)) = some true ↔ b = true ∧ o = some true := by
  cases o with
  | none => simp
  | some r => cases b <;> cases r <;> simp [BoolHook.and]

/-- A function on lists that satisfies the two equations of the K fold
`f(.List) => true` and `f(ListItem(X) L) => φ(X) andBool f(L)` is `true` exactly on the lists
whose every element satisfies `φ`. -/
theorem all_iff_of_eqns {f : L → Option Bool} {φ : E → Bool}
    (h1 : f unit = some true)
    (h2 : ∀ (l : L) (x : E), f (concat (element x) l) = (f l).bind fun r => some (BoolHook.and (φ x) r))
    (l : L) : f l = some true ↔ ElemsOn (fun x => φ x = true) l := by
  rw [← ofList_toList l]
  unfold ElemsOn
  rw [toList_ofList]
  induction toList l with
  | nil => simpa [unit] using h1
  | cons x xs ih =>
    rw [← concat_element_ofList, h2, bind_and_eq_some_true, ih]
    simp

/-- As `all_iff_of_eqns`, for the fold `f(ListItem(X) L) => f(L) andBool φ(X)`. -/
theorem all_iff_of_eqns' {f : L → Option Bool} {φ : E → Bool}
    (h1 : f unit = some true)
    (h2 : ∀ (l : L) (x : E), f (concat (element x) l) = (f l).bind fun r => some (BoolHook.and r (φ x)))
    (l : L) : f l = some true ↔ ElemsOn (fun x => φ x = true) l := by
  rw [← ofList_toList l]
  unfold ElemsOn
  rw [toList_ofList]
  induction toList l with
  | nil => simpa [unit] using h1
  | cons x xs ih =>
    rw [← concat_element_ofList, h2, bind_and'_eq_some_true, ih]
    simp

/-- `values(M)` holds exactly the values of `M`'s bindings. -/
@[k2l_pres] theorem elemsOn_values_iff {M K : Type} [Ord K] [ListIso M (K × E)] [MapRepr M K E]
    {Q : E → Prop} {m : M} :
    ElemsOn Q (MapHook.values m : L) ↔ MapHook.EntriesOn (fun p => Q p.2) m := by
  unfold ElemsOn MapHook.values MapHook.EntriesOn
  rw [toList_ofList]
  simp only [List.mem_map]
  exact ⟨fun h p hp => h p.2 ⟨p, hp, rfl⟩, fun h x ⟨p, hp, hx⟩ => hx ▸ h p hp⟩

end ListHook

/-- `k2l_fold_eqn f`: an equation of the generated list fold `f` (`f .List = …` or
`f (ListItem(X) L) = …`), from its definition: unfold `f` once on the left-hand side, decide the
`.List` test, case on the list match (`ListItem(X) L` is `X` and `L`), then close. -/
macro "k2l_fold_eqn " f:ident : tactic => do
  let e := Lean.mkIdent (f.getId.str "eq_def")
  `(tactic| (
    conv => lhs; rw [$e:ident]
    simp only [KPrelude.ListHook.concat_element_ne_unit, dite_false, dite_true]
    repeat' (first | split | k2l_split_hyps)
    all_goals (simp only [KPrelude.ListHook.uncons_concat_element, KPrelude.ListHook.unsnoc_concat_element,
      Option.some.injEq, Prod.mk.injEq, reduceCtorEq] at *)
    all_goals (subst_vars; first | rfl | simp_all)))

end KPrelude
