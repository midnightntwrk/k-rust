import KPrelude.InvColl
import KPrelude.Tactic

/-!
# K list folds as element-wise predicates

A K invariant over a collection is usually written as a fold:

```k
rule allValues(.List) => true
rule allValues(ListItem(V) L) => isValue(V) andBool allValues(L)
```

Its generated Lean definition is `Option`-valued and well-founded recursive, so neither `simp`
nor a preservation lemma can see through it. Lists are freely generated by `.List` and
`ListItem(X) L`, so the two equations determine the function on every list:
`f l = some true` exactly when every element `x` of `l` satisfies `φ x = true`
(`ListHook.all_iff_of_eqns`). With that, the collection lemmas of `KPrelude.InvColl` apply.

- `ListHook.all_iff_of_eqns` (`φ(X) andBool f(L)`) and `ListHook.all_iff_of_eqns'`
  (`f(L) andBool φ(X)`) take the two K equations as hypotheses.
- `ListHook.any_eq_of_eqns` and `ListHook.any_eq_of_eqns'` are their `orBool` duals
  (`f(.List) => false`, `φ(X) orBool f(L)`): the value `f l = some (anyB φ l)`, which
  `anyB_eq_true` and `anyB_eq_false` read as `ElemsSome` (some element passes) or `ElemsOn` (none
  does), so an invariant may use the fold under `notBool` as well as it is.
- `k2l_fold_eqn f` proves either equation of a generated fold `f` from its definition (one
  unfolding, then the cases of the list match).
- `ListHook.elemsOn_values_iff` and `ListHook.elemsOn_keysList_iff` (`@[k2l_pres]`) turn a
  predicate on `values(M)` or `keys_list(M)` into one on the bindings of `M`, so
  `MapHook.entriesOn_update` and its siblings apply.
- `bind_bool_eq_some_true` splits a chain of `Option.bind`s over partial `Bool` calls equated to
  `some true` (a function of a tree of cells whose right-hand side is `A andBool B`) one call at a
  time; the generator names it in the unfolding set of such a function only.

The `@[k2l_pres]` lemmas here are part of `k2l_preserve`'s unfolding set wherever this module is
imported: in the generated `Equations.lean` and `InvariantDefs.lean`, and in a kind 2 project that
imports either.
-/

namespace KPrelude

namespace ListHook

open ListIso

variable {L E : Type} [ListIso L E]

/-- `uncons` takes `ListItem(X) REST` apart, and only it: what the fallback of a generated
monotonicity proof needs to refute the definition's `uncons` arm where no list pattern matched. -/
theorem uncons_eq_some_iff {l t : L} {x : E} : uncons l = some (x, t) ↔ l = concat (element x) t :=
  ⟨fun h => (concat_element_of_uncons h).symm, fun h => h ▸ uncons_concat_element x t⟩

/-- `ListItem(X) REST` is never `.List`. -/
theorem concat_element_ne_unit (x : E) (t : L) : concat (element x) t ≠ (unit : L) := by
  intro h
  have := congrArg toList h
  simp [concat, element, unit, toList_ofList] at this

/-- `ListItem(X) REST` is the list `X :: REST`. -/
theorem concat_element_ofList (x : E) (xs : List E) :
    concat (element x) (ofList xs : L) = ofList (x :: xs) := by
  unfold concat element
  rw [toList_ofList, toList_ofList]
  rfl

private theorem bind_and_eq_some_true {o : Option Bool} {b : Bool} :
    (o.bind fun r => some (BoolHook.and b r)) = some true ↔ b = true ∧ o = some true := by
  cases o with
  | none => simp
  | some r => cases b <;> cases r <;> simp [BoolHook.and]

private theorem bind_and'_eq_some_true {o : Option Bool} {b : Bool} :
    (o.bind fun r => some (BoolHook.and r b)) = some true ↔ b = true ∧ o = some true := by
  cases o with
  | none => simp
  | some r => cases b <;> cases r <;> simp [BoolHook.and]

/-- A function on lists that satisfies the two equations of the K fold
`f(.List) => true` and `f(ListItem(X) L) => φ(X) andBool f(L)` is `true` exactly on the lists
whose every element satisfies `φ`. -/
theorem all_iff_of_eqns {f : L → Option Bool} {φ : E → Bool}
    (h1 : f unit = some true)
    (h2 : ∀ (l : L) (x : E), f (concat (element x) l) = (f l).bind fun r => some (BoolHook.and (φ x) r))
    (l : L) : f l = some true ↔ ElemsOn (fun x => φ x = true) l := by
  rw [← ofList_toList l]
  unfold ElemsOn
  rw [toList_ofList]
  induction toList l with
  | nil => simpa [unit] using h1
  | cons x xs ih =>
    rw [← concat_element_ofList, h2, bind_and_eq_some_true, ih]
    simp

/-- As `all_iff_of_eqns`, for the fold `f(ListItem(X) L) => f(L) andBool φ(X)`. -/
theorem all_iff_of_eqns' {f : L → Option Bool} {φ : E → Bool}
    (h1 : f unit = some true)
    (h2 : ∀ (l : L) (x : E), f (concat (element x) l) = (f l).bind fun r => some (BoolHook.and r (φ x)))
    (l : L) : f l = some true ↔ ElemsOn (fun x => φ x = true) l := by
  rw [← ofList_toList l]
  unfold ElemsOn
  rw [toList_ofList]
  induction toList l with
  | nil => simpa [unit] using h1
  | cons x xs ih =>
    rw [← concat_element_ofList, h2, bind_and'_eq_some_true, ih]
    simp

private theorem bind_bind_and_eq_some_true' {a b : Option Bool} :
    (a.bind fun r => b.bind fun r' => some (BoolHook.and r r')) = some true ↔
      a = some true ∧ b = some true := by
  cases a with
  | none => simp
  | some x => cases b with
    | none => simp
    | some y => cases x <;> cases y <;> simp [BoolHook.and]

/-- As `all_iff_of_eqns`, for a fold whose test of one element is partial (a function of the
fold's mutual group, well-founded and `Option`-valued: SIMPLE's `listIn` and `itemIn`), as its
equation binds it: `f(ListItem(X) L) => g(X) andBool f(L)`. -/
theorem all_iff_of_eqns_partial {f : L → Option Bool} {g : E → Option Bool}
    (h1 : f unit = some true)
    (h2 : ∀ (l : L) (x : E), f (concat (element x) l) = (g x).bind fun r => (f l).bind fun r' =>
      some (BoolHook.and r r'))
    (l : L) : f l = some true ↔ ElemsOn (fun x => g x = some true) l := by
  rw [← ofList_toList l]
  unfold ElemsOn
  rw [toList_ofList]
  induction toList l with
  | nil => simpa [unit] using h1
  | cons x xs ih =>
    rw [← concat_element_ofList, h2, bind_bind_and_eq_some_true', ih]
    simp

/-! ### `orBool` folds

`f(.List) => false` and `f(ListItem(X) L) => φ(X) orBool f(L)` determine `f` on every list in the
same way: `f l = some b` with `b` true exactly when some element passes `φ`. That is a value, not
only a test for `true`, so an invariant may read the fold under `notBool` (no element passes, an
`ElemsOn` fact) or as it is (some element passes, an `ElemsSome` fact). -/

/-- Some element of `l` satisfies `Q`. -/
def ElemsSome (Q : E → Prop) (l : L) : Prop := ∃ x ∈ toList l, Q x

/-- Whether some element of `l` passes `φ`: the value of an `orBool` fold. -/
def anyB (φ : E → Bool) (l : L) : Bool := (toList l).any φ

@[k2l_pres] theorem anyB_eq_true {φ : E → Bool} {l : L} :
    anyB φ l = true ↔ ElemsSome (fun x => φ x = true) l := by
  simp [anyB, ElemsSome, List.any_eq_true]

@[k2l_pres] theorem anyB_eq_false {φ : E → Bool} {l : L} :
    anyB φ l = false ↔ ElemsOn (fun x => φ x = false) l := by
  simp [anyB, ElemsOn, List.any_eq_false]

@[k2l_pres] theorem elemsSome_unit_iff {Q : E → Prop} : ElemsSome Q (unit : L) ↔ False := by
  simp [ElemsSome, unit, toList_ofList]

@[k2l_pres] theorem elemsSome_element_iff {Q : E → Prop} {x : E} :
    ElemsSome Q (element x : L) ↔ Q x := by
  simp [ElemsSome, element, toList_ofList]

@[k2l_pres] theorem elemsSome_concat_iff {Q : E → Prop} {a b : L} :
    ElemsSome Q (concat a b) ↔ ElemsSome Q a ∨ ElemsSome Q b := by
  unfold ElemsSome concat
  rw [toList_ofList]
  simp only [List.mem_append]
  constructor
  · rintro ⟨x, hx | hx, hq⟩
    · exact .inl ⟨x, hx, hq⟩
    · exact .inr ⟨x, hx, hq⟩
  · rintro (⟨x, hx, hq⟩ | ⟨x, hx, hq⟩)
    · exact ⟨x, .inl hx, hq⟩
    · exact ⟨x, .inr hx, hq⟩

/-- A function on lists that satisfies the two equations of the K fold `f(.List) => false` and
`f(ListItem(X) L) => φ(X) orBool f(L)` has the value `anyB φ l` on every list `l`. -/
theorem any_eq_of_eqns {f : L → Option Bool} {φ : E → Bool}
    (h1 : f unit = some false)
    (h2 : ∀ (l : L) (x : E), f (concat (element x) l) = (f l).bind fun r => some (BoolHook.or (φ x) r))
    (l : L) : f l = some (anyB φ l) := by
  rw [← ofList_toList l]
  unfold anyB
  rw [toList_ofList]
  induction toList l with
  | nil => simpa [unit] using h1
  | cons x xs ih =>
    rw [← concat_element_ofList, h2, ih]
    simp [BoolHook.or, List.any_cons]

/-- As `any_eq_of_eqns`, for the fold `f(ListItem(X) L) => f(L) orBool φ(X)`. -/
theorem any_eq_of_eqns' {f : L → Option Bool} {φ : E → Bool}
    (h1 : f unit = some false)
    (h2 : ∀ (l : L) (x : E), f (concat (element x) l) = (f l).bind fun r => some (BoolHook.or r (φ x)))
    (l : L) : f l = some (anyB φ l) := by
  rw [← ofList_toList l]
  unfold anyB
  rw [toList_ofList]
  induction toList l with
  | nil => simpa [unit] using h1
  | cons x xs ih =>
    rw [← concat_element_ofList, h2, ih]
    simp [BoolHook.or, List.any_cons, Bool.or_comm]

/-- `values(M)` holds exactly the values of `M`'s bindings. -/
@[k2l_pres] theorem elemsOn_values_iff {M K : Type} [Ord K] [ListIso M (K × E)] [MapRepr M K E]
    {Q : E → Prop} {m : M} :
    ElemsOn Q (MapHook.values m : L) ↔ MapHook.EntriesOn (fun p => Q p.2) m := by
  unfold ElemsOn MapHook.values MapHook.EntriesOn
  rw [toList_ofList]
  simp only [List.mem_map]
  exact ⟨fun h p hp => h p.2 ⟨p, hp, rfl⟩, fun h x ⟨p, hp, hx⟩ => hx ▸ h p hp⟩

/-- `keys_list(M)` holds exactly the keys of `M`'s bindings. -/
@[k2l_pres] theorem elemsOn_keysList_iff {M V : Type} [Ord E] [ListIso M (E × V)] [MapRepr M E V]
    {Q : E → Prop} {m : M} :
    ElemsOn Q (MapHook.keysList m : L) ↔ MapHook.EntriesOn (fun p => Q p.1) m := by
  unfold ElemsOn MapHook.keysList MapHook.EntriesOn
  rw [toList_ofList]
  simp only [List.mem_map]
  exact ⟨fun h p hp => h p.1 ⟨p, hp, rfl⟩, fun h x ⟨p, hp, hx⟩ => hx ▸ h p hp⟩

end ListHook

/-- `k2l_fold_eqn f`: an equation of the generated list fold `f` (`f .List = …` or
`f (ListItem(X) L) = …`), from its definition: unfold `f` once on the left-hand side, decide the
`.List` test, case on the list match (`ListItem(X) L` is `X` and `L`), then close. -/
macro "k2l_fold_eqn " f:ident : tactic => do
  let e := Lean.mkIdent (f.getId.str "eq_def")
  `(tactic| (
    conv => lhs; rw [$e:ident]
    simp only [KPrelude.ListHook.concat_element_ne_unit, dite_false, dite_true]
    repeat' (first | split | k2l_split_hyps)
    all_goals (simp only [KPrelude.ListHook.uncons_concat_element, KPrelude.ListHook.unsnoc_concat_element,
      Option.some.injEq, Prod.mk.injEq, reduceCtorEq] at *)
    all_goals (subst_vars; first | rfl | simp_all)))

/-- Two partial `Bool` calls joined by `andBool`, as an equation states them (each call bound in
turn): `true` exactly when both are. -/
theorem bind_bind_and_eq_some_true {a b : Option Bool} :
    (a.bind fun r => b.bind fun r' => some (BoolHook.and r r')) = some true ↔
      a = some true ∧ b = some true := by
  cases a with
  | none => simp
  | some x => cases b with
    | none => simp
    | some y => cases x <;> cases y <;> simp [BoolHook.and]

/-- A K function of a tree of cells whose right-hand side combines partial `Bool` calls
(`A andBool B`, `A orBool B`) is, through `Invariant.f_cells`, a chain of `Option.bind`s; this
splits one link of the chain on the value of its call, so that `(A.bind fun r => B.bind fun r_1 =>
some (r && r_1)) = some true` becomes `A = some true ∧ B = some true`, two facts the closers read
separately. -/
theorem bind_bool_eq_some_true (o : Option Bool) (f : Bool → Option Bool) :
    o.bind f = some true ↔ (o = some true ∧ f true = some true) ∨ (o = some false ∧ f false = some true) := by
  cases o with
  | none => simp
  | some b => cases b <;> simp

/-- `k2l_mono_arm hx [m₁, …]`: one arm of a generated monotonicity proof (`Invariant.f_mono`,
`invariants.md` §3.1). The arm's equation has rewritten `hx : f x S = some true` and the goal
`f x S' = some true` into the equation's right-hand side at `S` and at `S'`, `andBool`s of calls
bound one after another; both are split into their calls, and each call of the goal is either a
hypothesis (it does not read the map) or follows from one by some `mᵢ : g y S = some true →
g y S' = some true`. -/
syntax "k2l_mono_arm " ident " [" term,* "]" : tactic

macro_rules
  | `(tactic| k2l_mono_arm $hx [$ms,*]) => `(tactic| (
      (try simp only [KPrelude.bind_bool_eq_some_true, KPrelude.BoolHook.and, Option.bind_fun_some]
        at $hx:ident ⊢)
      (try simp at $hx:ident ⊢)
      (try k2l_split_ands)
      (try and_intros)
      all_goals first
        | assumption
        $[| exact $ms (by assumption)]*))

end KPrelude
