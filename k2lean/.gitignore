# Lake's build directories, and the manifests Lake writes for the path dependencies between
# k2lean's projects (rewritten whenever a lakefile changes).
.lake/
lake-manifest.json
# the k2lean package's manifest carries `fixedToolchain` to the packages that require it (PKG-4)
!/lean/lake-manifest.json

# The generated libraries, which demos/regen.sh and tests/gate.sh regenerate from the K sources.
# A library's open-obligation lists and its hand-written invariant module are inputs of the
# generation and are tracked: open-obligations.txt (the K equations stated without a proof),
# open-invariant-cases.txt (the rule cases of a kind 1 invariant proved by hand) and
# NS/InvariantsHand.lean (those proofs), NS/DivergesHand.lean (the divergence proofs of the
# least fixed points), and open-progress-cases.txt with NS/ProgressHand.lean (the cases of
# `progress` proved or refuted by hand), open-defined-rules.txt with NS/DefinedHand.lean (the rules
# whose right-hand side is shown defined or refuted by hand, SND-20), and open-step-cases.txt with
# NS/StepPropHand.lean (the cases of a step property proved, or the property refuted, by hand,
# INV-21), which `k2lean gen` writes once and never overwrites.
/generated/*/*
!/generated/*/open-obligations.txt
!/generated/*/open-invariant-cases.txt
!/generated/*/open-progress-cases.txt
!/generated/*/open-defined-rules.txt
!/generated/*/open-step-cases.txt
!/generated/*/*/
/generated/*/*/*
!/generated/*/*/InvariantsHand.lean
!/generated/*/*/DivergesHand.lean
!/generated/*/*/ProgressHand.lean
!/generated/*/*/DefinedHand.lean
!/generated/*/*/StepPropHand.lean
/generated/*/.lake/

# What `k2lean relate` writes into the demos (demos/regen.sh and tests/gate.sh regenerate it).
/demos/*/correspondence.toml
/demos/ImpRel/ImpRel/Bisim.lean
/demos/ImpTypes/ImpTypes/Tr.lean
# What `k2lean claims --transfer` writes into the demo ImpRelClaims.
/demos/ImpRelClaims/ImpRelClaims/Transfers.lean
/demos/ImpUnrollClaims/ImpUnrollClaims/Transfers.lean
# What `k2lean soundness` writes into the type-soundness demos, around their hand module Store.lean,
# and what `k2lean gen --progress` writes into them, each language's progress under `NS.Typed`
# (SND-16 to SND-18).
/demos/ImpTypes/ImpTypes/Typing.lean
/demos/ImpTypes/ImpTypes/Typed.lean
/demos/ImpTypes/ImpTypes/Soundness.lean
/demos/ImpTypes/ImpTypes/ProgressDefs.lean
/demos/ImpTypes/ImpTypes/Progress.lean
/demos/ImpTypes/typed-unfold.txt
