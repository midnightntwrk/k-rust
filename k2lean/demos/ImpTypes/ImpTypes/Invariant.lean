import ImpTypes.Tr
import KImp.Rules

/-!
# The runtime typing `WTc G` of kimp configurations (kind 2 layout: `Invariant.lean`)

HAND-WRITTEN, stable under edits of kimp's rules: the invariant and what it is made of. It is the
first of the three files of a kind 2 invariant (`k2lean/docs/invariants.md`, §4):
- `Invariant.lean` (this file): the predicate `WTc G` and the lemmas that say how it computes;
- `Cases.lean`: one marked section per rule case that `k2l_preserve` does not close, then
  `preserved : Preserved KImp.Step (WTc G)`;
- `Run.lean`: `WTc G` at the generated initial configuration `KImp.init`, and every
  configuration reachable from it.

The definitions are over two generated libraries:
- `KImp`: kimp's semantics (`Step`, `App`), generated from `imp.k`;
- `KImpTypes`: the type checker `typeOf`/`wt`, generated from `k/imp-typing.k`, a second K
  definition over the same syntax;
- `ImpTypes.Tr` (generated by `k2lean relate --roots`): the translation of programs.

What a template would generate is marked in each section.
-/

set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace ImpTypes

open KPrelude

local notation "TY" => KImpTypes.K.«typeOf(_,_)_IMP-TYPING_Type_Expr_Map»
local notation "WTF" => KImpTypes.K.«wt(_,_)_IMP-TYPING_Bool_Stmt_Map»

abbrev Ty := KImpTypes.SortType
abbrev TEnv := KImpTypes.SortMap

/-! ## 1. The type checker, characterized (template: inversion of a function given by one
equation per constructor; the statements follow from the equations, the proofs unfold once) -/

/-- The result type of an operator whose operands must both have type `a`. -/
def bin (a r : Ty) (o₁ o₂ : Option Ty) : Option Ty := if o₁ = some a ∧ o₂ = some a then some r else none
def una (a r : Ty) (o : Option Ty) : Option Ty := if o = some a then some r else none
/-- `==` and `!=`: operands of one type. -/
def same (o₁ o₂ : Option Ty) : Option Ty := if o₁.isSome ∧ o₁ = o₂ then some .bool else none

theorem keq_type (a b : Ty) :
    KEqHook.eq (KImpTypes.SortK.kseq (KImpTypes.SortKItem.inj_Type a) .dotk) (KImpTypes.SortK.kseq (KImpTypes.SortKItem.inj_Type b) .dotk) = decide (a = b) := by
  cases a <;> cases b <;> rfl

/-- Unfold `typeOf` once at a constructor (left-hand side only), case on the types of the
operands, and decide the cascade. -/
macro "ty_unf" : tactic => `(tactic| ((conv => lhs; rw [KImpTypes.K.«typeOf(_,_)_IMP-TYPING_Type_Expr_Map».eq_def]); simp only []))
macro "ty_fin" : tactic => `(tactic| (simp only [] <;> (try split) <;> simp_all [bin, una, same, keq_type, BoolHook.and]))
set_option hygiene false in
macro "ty1" a:term : tactic => `(tactic| (ty_unf; cases _ : TY $a G <;> ty_fin))
set_option hygiene false in
macro "ty2" a:term "," b:term : tactic => `(tactic| (ty_unf; cases _ : TY $a G <;> cases _ : TY $b G <;> ty_fin))

section Char
variable (G : TEnv) (e e₁ e₂ : KImpTypes.SortExpr)

theorem TY_int (i : Int) : TY (.inj_Int i) G = some .int := by
  conv => lhs; rw [KImpTypes.K.«typeOf(_,_)_IMP-TYPING_Type_Expr_Map».eq_def]
theorem TY_bool (b : Bool) : TY (.inj_Bool b) G = some .bool := by
  conv => lhs; rw [KImpTypes.K.«typeOf(_,_)_IMP-TYPING_Type_Expr_Map».eq_def]
theorem TY_neg : TY (.inj_Expr (.«-_» e)) G = una .int .int (TY e G) := by ty1 e
theorem TY_not : TY (.inj_Expr (.«!_» e)) G = una .bool .bool (TY e G) := by ty1 e
theorem TY_add : TY (.inj_Expr (.«_+_» e₁ e₂)) G = bin .int .int (TY e₁ G) (TY e₂ G) := by ty2 e₁, e₂
theorem TY_sub : TY (.inj_Expr (.«_-_» e₁ e₂)) G = bin .int .int (TY e₁ G) (TY e₂ G) := by ty2 e₁, e₂
theorem TY_mul : TY (.inj_Expr (.«_*_» e₁ e₂)) G = bin .int .int (TY e₁ G) (TY e₂ G) := by ty2 e₁, e₂
theorem TY_div : TY (.inj_Expr (.«_/_» e₁ e₂)) G = bin .int .int (TY e₁ G) (TY e₂ G) := by ty2 e₁, e₂
theorem TY_ge : TY (.inj_Expr (.«_>=_» e₁ e₂)) G = bin .int .bool (TY e₁ G) (TY e₂ G) := by ty2 e₁, e₂
theorem TY_gt : TY (.inj_Expr (.«_>_» e₁ e₂)) G = bin .int .bool (TY e₁ G) (TY e₂ G) := by ty2 e₁, e₂
theorem TY_le : TY (.inj_Expr (.«_<=_» e₁ e₂)) G = bin .int .bool (TY e₁ G) (TY e₂ G) := by ty2 e₁, e₂
theorem TY_lt : TY (.inj_Expr (.«_<_» e₁ e₂)) G = bin .int .bool (TY e₁ G) (TY e₂ G) := by ty2 e₁, e₂
theorem TY_eq : TY (.inj_Expr (.«_==_» e₁ e₂)) G = same (TY e₁ G) (TY e₂ G) := by ty2 e₁, e₂
theorem TY_ne : TY (.inj_Expr (.«_!=_» e₁ e₂)) G = same (TY e₁ G) (TY e₂ G) := by ty2 e₁, e₂
theorem TY_and : TY (.inj_Expr (.«_&&_» e₁ e₂)) G = bin .bool .bool (TY e₁ G) (TY e₂ G) := by ty2 e₁, e₂
theorem TY_or : TY (.inj_Expr (.«_||_» e₁ e₂)) G = bin .bool .bool (TY e₁ G) (TY e₂ G) := by ty2 e₁, e₂

end Char

/-! ## 2. Runtime typing (template "typed evaluation contexts": `plug` is read off the cooling
rules, `item` types a freezer by plugging a placeholder value of the hole's type; everything here
follows from the strictness structure and the type checker) -/

def tyOf (G : TEnv) (e : KImp.SortExpr) : Option Ty := TY (tr_SortExpr e) G
def wtS (G : TEnv) (s : KImp.SortStmt) : Bool := WTF (tr_SortStmt s) G == some true

/-- A placeholder value of each type. -/
def dflt : Ty → KImp.SortExpr
  | .int => .inj_Int 0
  | .bool => .inj_Bool true

/-- The item that cooling makes of `e ~> f` (each case is the right-hand side of `f`'s cooling rule). -/
def plug : KImp.SortKItem.Own → KImp.SortExpr → Option KImp.SortKItem
  | .«#freezer-__EXPR-SYNTAX_Expr_Expr0_», e => some (.inj_Expr (.«-_» e))
  | .«#freezer!__EXPR-SYNTAX_Expr_Expr0_», e => some (.inj_Expr (.«!_» e))
  | .«#freezer_*__EXPR-SYNTAX_Expr_Expr_Expr0_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun b => .inj_Expr (.«_*_» e b)
  | .«#freezer_*__EXPR-SYNTAX_Expr_Expr_Expr1_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun a => .inj_Expr (.«_*_» a e)
  | .«#freezer_/__EXPR-SYNTAX_Expr_Expr_Expr0_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun b => .inj_Expr (.«_/_» e b)
  | .«#freezer_/__EXPR-SYNTAX_Expr_Expr_Expr1_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun a => .inj_Expr (.«_/_» a e)
  | .«#freezer_+__EXPR-SYNTAX_Expr_Expr_Expr0_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun b => .inj_Expr (.«_+_» e b)
  | .«#freezer_+__EXPR-SYNTAX_Expr_Expr_Expr1_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun a => .inj_Expr (.«_+_» a e)
  | .«#freezer_-__EXPR-SYNTAX_Expr_Expr_Expr0_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun b => .inj_Expr (.«_-_» e b)
  | .«#freezer_-__EXPR-SYNTAX_Expr_Expr_Expr1_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun a => .inj_Expr (.«_-_» a e)
  | .«#freezer_>=__EXPR-SYNTAX_Expr_Expr_Expr0_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun b => .inj_Expr (.«_>=_» e b)
  | .«#freezer_>=__EXPR-SYNTAX_Expr_Expr_Expr1_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun a => .inj_Expr (.«_>=_» a e)
  | .«#freezer_>__EXPR-SYNTAX_Expr_Expr_Expr0_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun b => .inj_Expr (.«_>_» e b)
  | .«#freezer_>__EXPR-SYNTAX_Expr_Expr_Expr1_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun a => .inj_Expr (.«_>_» a e)
  | .«#freezer_<=__EXPR-SYNTAX_Expr_Expr_Expr0_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun b => .inj_Expr (.«_<=_» e b)
  | .«#freezer_<=__EXPR-SYNTAX_Expr_Expr_Expr1_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun a => .inj_Expr (.«_<=_» a e)
  | .«#freezer_<__EXPR-SYNTAX_Expr_Expr_Expr0_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun b => .inj_Expr (.«_<_» e b)
  | .«#freezer_<__EXPR-SYNTAX_Expr_Expr_Expr1_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun a => .inj_Expr (.«_<_» a e)
  | .«#freezer_==__EXPR-SYNTAX_Expr_Expr_Expr0_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun b => .inj_Expr (.«_==_» e b)
  | .«#freezer_==__EXPR-SYNTAX_Expr_Expr_Expr1_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun a => .inj_Expr (.«_==_» a e)
  | .«#freezer_!=__EXPR-SYNTAX_Expr_Expr_Expr0_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun b => .inj_Expr (.«_!=_» e b)
  | .«#freezer_!=__EXPR-SYNTAX_Expr_Expr_Expr1_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun a => .inj_Expr (.«_!=_» a e)
  | .«#freezer_&&__EXPR-SYNTAX_Expr_Expr_Expr0_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun b => .inj_Expr (.«_&&_» e b)
  | .«#freezer_||__EXPR-SYNTAX_Expr_Expr_Expr0_» (.kseq y .dotk), e => (KImp.proj_KItem_Expr y).map fun b => .inj_Expr (.«_||_» e b)
  | .«#freezer_=_;_CALC-SYNTAX_Stmt_Id_Expr1_» (.kseq y .dotk), e => (KImp.proj_KItem_Id y).map fun x => .inj_Stmt (.«_=_;» x e)
  | .«#freezerif(_)_else__IMP-SYNTAX_Stmt_Expr_Stmt_Stmt0_» (.kseq y₁ .dotk) (.kseq y₂ .dotk), e =>
      (KImp.proj_KItem_Stmt y₁).bind fun s₁ => (KImp.proj_KItem_Stmt y₂).map fun s₂ => .inj_Stmt (.«if(_)_else_» e s₁ s₂)
  | _, _ => none

/-- An item with no pending value: what it leaves for the next item (`some none` for a statement,
`some (some t)` for an expression or value of type `t`); `none` when ill-typed. -/
def item0 (G : TEnv) : KImp.SortKItem → Option (Option Ty)
  | .inj_Int _ => some (some .int)
  | .inj_Bool _ => some (some .bool)
  | .inj_Id x => (tyOf G (.inj_Id x)).map some
  | .inj_Expr e => (tyOf G (.inj_Expr e)).map some
  | .inj_Stmt s => if wtS G s then some none else none
  | _ => none

/-- An item that receives a pending value of type `i`: only a freezer can. -/
def item (G : TEnv) : Option Ty → KImp.SortKItem → Option (Option Ty)
  | none, it => item0 G it
  | some t, .inj_KItem f => (plug f (dflt t)).bind (item0 G)
  | some _, _ => none

/-- A well-typed continuation: each item consumes what the previous one leaves, and nothing is
left at the end. -/
def kty (G : TEnv) : Option Ty → KImp.SortK → Bool
  | i, .dotk => i.isNone
  | i, .kseq it k => match item G i it with
    | some o => kty G o k
    | none => false

/-- The type of a runtime value. -/
def valTy : KImp.SortKItem → Option Ty
  | .inj_Int _ => some .int
  | .inj_Bool _ => some .bool
  | _ => none

/-- The store holds a value of its type for every identifier the typing environment types. -/
def envTy (G : TEnv) (E : KImp.SortMap) : Prop :=
  MapHook.WF E ∧ ∀ x t, tyOf G (.inj_Id x) = some t → ∃ v, MapHook.lookup E (KImp.SortKItem.inj_Id x) = some v ∧ valTy v = some t

def kOf : KImp.SortGeneratedTopCell → KImp.SortK
  | .«<generatedTop>» (.«<k>» k) _ _ => k
def envOf : KImp.SortGeneratedTopCell → KImp.SortEnvCell
  | .«<generatedTop>» _ e _ => e
def envTyC (G : TEnv) : KImp.SortEnvCell → Prop
  | .«<env>» E => envTy G E

/-- A well-typed configuration. -/
def WTc (G : TEnv) (c : KImp.SortGeneratedTopCell) : Prop := kty G none (kOf c) = true ∧ envTyC G (envOf c)

/-! ## 3. The typing of programs, at kimp's terms (from section 1 through `tr`, by `rfl`) -/

@[simp] theorem tyOf_int (G : TEnv) (i : Int) : tyOf G (.inj_Int i) = some .int := TY_int G i
@[simp] theorem tyOf_bool (G : TEnv) (b : Bool) : tyOf G (.inj_Bool b) = some .bool := TY_bool G b
@[simp] theorem tyOf_neg (G : TEnv) (a : KImp.SortExpr) : tyOf G (.inj_Expr (.«-_» a)) = una .int .int (tyOf G a) := TY_neg G _
@[simp] theorem tyOf_not (G : TEnv) (a : KImp.SortExpr) : tyOf G (.inj_Expr (.«!_» a)) = una .bool .bool (tyOf G a) := TY_not G _
@[simp] theorem tyOf_add (G : TEnv) (a b : KImp.SortExpr) : tyOf G (.inj_Expr (.«_+_» a b)) = bin .int .int (tyOf G a) (tyOf G b) := TY_add G _ _
@[simp] theorem tyOf_sub (G : TEnv) (a b : KImp.SortExpr) : tyOf G (.inj_Expr (.«_-_» a b)) = bin .int .int (tyOf G a) (tyOf G b) := TY_sub G _ _
@[simp] theorem tyOf_mul (G : TEnv) (a b : KImp.SortExpr) : tyOf G (.inj_Expr (.«_*_» a b)) = bin .int .int (tyOf G a) (tyOf G b) := TY_mul G _ _
@[simp] theorem tyOf_div (G : TEnv) (a b : KImp.SortExpr) : tyOf G (.inj_Expr (.«_/_» a b)) = bin .int .int (tyOf G a) (tyOf G b) := TY_div G _ _
@[simp] theorem tyOf_ge (G : TEnv) (a b : KImp.SortExpr) : tyOf G (.inj_Expr (.«_>=_» a b)) = bin .int .bool (tyOf G a) (tyOf G b) := TY_ge G _ _
@[simp] theorem tyOf_gt (G : TEnv) (a b : KImp.SortExpr) : tyOf G (.inj_Expr (.«_>_» a b)) = bin .int .bool (tyOf G a) (tyOf G b) := TY_gt G _ _
@[simp] theorem tyOf_le (G : TEnv) (a b : KImp.SortExpr) : tyOf G (.inj_Expr (.«_<=_» a b)) = bin .int .bool (tyOf G a) (tyOf G b) := TY_le G _ _
@[simp] theorem tyOf_lt (G : TEnv) (a b : KImp.SortExpr) : tyOf G (.inj_Expr (.«_<_» a b)) = bin .int .bool (tyOf G a) (tyOf G b) := TY_lt G _ _
@[simp] theorem tyOf_eq (G : TEnv) (a b : KImp.SortExpr) : tyOf G (.inj_Expr (.«_==_» a b)) = same (tyOf G a) (tyOf G b) := TY_eq G _ _
@[simp] theorem tyOf_ne (G : TEnv) (a b : KImp.SortExpr) : tyOf G (.inj_Expr (.«_!=_» a b)) = same (tyOf G a) (tyOf G b) := TY_ne G _ _
@[simp] theorem tyOf_and (G : TEnv) (a b : KImp.SortExpr) : tyOf G (.inj_Expr (.«_&&_» a b)) = bin .bool .bool (tyOf G a) (tyOf G b) := TY_and G _ _
@[simp] theorem tyOf_or (G : TEnv) (a b : KImp.SortExpr) : tyOf G (.inj_Expr (.«_||_» a b)) = bin .bool .bool (tyOf G a) (tyOf G b) := TY_or G _ _

macro "wt_unf" : tactic => `(tactic| ((conv => lhs; rw [KImpTypes.K.«wt(_,_)_IMP-TYPING_Bool_Stmt_Map».eq_def]) <;> (try simp only [])))
macro "wt_fin" : tactic => `(tactic| (simp only [] <;> (try split) <;> (try split) <;> simp_all [keq_type, BoolHook.and]))

section WtCharB
variable (G : TEnv) (s s₁ s₂ : KImpTypes.SortStmt) (c e : KImpTypes.SortExpr) (x : KImpTypes.SortId)
theorem WT_skip : WTF .«{}» G = some true := by wt_unf
theorem WT_block : WTF (.«{_}» s) G = WTF s G := by wt_unf; all_goals (cases _ : WTF s G <;> wt_fin)
theorem WT_assign : WTF (.«_=_;» x e) G = if (TY (.inj_Id x) G).isSome ∧ TY (.inj_Id x) G = TY e G then some true else some false := by
  wt_unf; all_goals (cases _ : TY (.inj_Id x) G <;> cases _ : TY e G <;> wt_fin)
theorem WT_seq : WTF (.__ s₁ s₂) G = (match WTF s₁ G, WTF s₂ G with | some a, some b => some (a && b) | _, _ => none) := by
  wt_unf; all_goals (cases _ : WTF s₁ G <;> cases _ : WTF s₂ G <;> wt_fin)
theorem WT_ife : WTF (.«if(_)_else_» c s₁ s₂) G = if TY c G = some .bool then (match WTF s₁ G, WTF s₂ G with | some a, some b => some (a && b) | _, _ => none) else some false := by
  wt_unf; all_goals (cases _ : TY c G <;> cases _ : WTF s₁ G <;> cases _ : WTF s₂ G <;> wt_fin)
theorem WT_if : WTF (.«if(_)_» c s) G = if TY c G = some .bool then WTF s G else some false := by
  wt_unf; all_goals (cases _ : TY c G <;> cases _ : WTF s G <;> wt_fin)
theorem WT_while : WTF (.«while(_)_» c s) G = if TY c G = some .bool then WTF s G else some false := by
  wt_unf; all_goals (cases _ : TY c G <;> cases _ : WTF s G <;> wt_fin)
end WtCharB

macro "wts" : tactic => `(tactic| ((simp only [wtS, tyOf, tr_SortStmt, tr_SortExpr, WT_skip, WT_block, WT_assign, WT_seq, WT_ife, WT_if, WT_while]) <;> (repeat' split) <;> simp_all))

section WtChar
variable (G : TEnv) (s s₁ s₂ : KImp.SortStmt) (c e : KImp.SortExpr) (x : KImp.SortId)
@[simp] theorem wtS_skip : wtS G .«{}» = true := by wts
@[simp] theorem wtS_block : wtS G (.«{_}» s) = wtS G s := by wts
@[simp] theorem wtS_assign : wtS G (.«_=_;» x e) = decide (∃ t, tyOf G (.inj_Id x) = some t ∧ tyOf G e = some t) := by
  simp only [wtS, tyOf, tr_SortStmt, tr_SortExpr, WT_assign]
  split <;> rename_i h
  · have hx : ∃ t, TY (.inj_Id (tr_SortId x)) G = some t ∧ TY (tr_SortExpr e) G = some t := by
      obtain ⟨h₁, h₂⟩ := h
      obtain ⟨t, ht⟩ := Option.isSome_iff_exists.1 h₁
      exact ⟨t, ht, h₂ ▸ ht⟩
    simp [hx]
  · have hx : ¬ ∃ t, TY (.inj_Id (tr_SortId x)) G = some t ∧ TY (tr_SortExpr e) G = some t := by
      rintro ⟨t, h₁, h₂⟩
      exact h ⟨by simp [h₁], h₁.trans h₂.symm⟩
    simp [hx]
@[simp] theorem wtS_seq : wtS G (.__ s₁ s₂) = (wtS G s₁ && wtS G s₂) := by
  simp only [wtS, tr_SortStmt, WT_seq]
  cases WTF (tr_SortStmt s₁) G <;> cases WTF (tr_SortStmt s₂) G <;> simp
@[simp] theorem wtS_ife : wtS G (.«if(_)_else_» c s₁ s₂) = (decide (tyOf G c = some .bool) && wtS G s₁ && wtS G s₂) := by
  simp only [wtS, tyOf, tr_SortStmt, WT_ife]
  split <;> cases WTF (tr_SortStmt s₁) G <;> cases WTF (tr_SortStmt s₂) G <;> simp_all
@[simp] theorem wtS_if : wtS G (.«if(_)_» c s) = (decide (tyOf G c = some .bool) && wtS G s) := by
  simp only [wtS, tyOf, tr_SortStmt, WT_if]; split <;> simp_all
@[simp] theorem wtS_while : wtS G (.«while(_)_» c s) = (decide (tyOf G c = some .bool) && wtS G s) := by
  simp only [wtS, tyOf, tr_SortStmt, WT_while]; split <;> simp_all
end WtChar

/-! ## 4. Computing the typing through a rule's two sides (the unfolding set of `k2l_preserve`
in `Cases.lean`, and `ty_simp` for `Progress.lean`) -/

/-! Typing through the injections, without casing on the injected value. -/

@[simp] theorem item0_inj_Expr (G : TEnv) (e : KImp.SortExpr) : item0 G (KImp.inj_Expr_KItem e) = (tyOf G e).map some := by
  cases e <;> simp [item0, KImp.inj_Expr_KItem]
@[simp] theorem item0_inj_Stmt (G : TEnv) (s : KImp.SortStmt) : item0 G (KImp.inj_Stmt_KItem s) = if wtS G s then some none else none := rfl
@[simp] theorem tyOf_dflt (G : TEnv) (t : Ty) : tyOf G (dflt t) = some t := by cases t <;> simp [dflt]

section ItemEqs
variable (G : TEnv)
theorem item0_int (i : Int) : item0 G (.inj_Int i) = some (some .int) := rfl
theorem item0_bool (b : Bool) : item0 G (.inj_Bool b) = some (some .bool) := rfl
theorem item0_id (x : KImp.SortId) : item0 G (.inj_Id x) = (tyOf G (.inj_Id x)).map some := rfl
theorem item0_expr (e : KImp.SortExpr.Own) : item0 G (.inj_Expr e) = (tyOf G (.inj_Expr e)).map some := rfl
theorem item0_stmt (s : KImp.SortStmt) : item0 G (.inj_Stmt s) = if wtS G s then some none else none := rfl
theorem item0_frz (f : KImp.SortKItem.Own) : item0 G (.inj_KItem f) = none := rfl
theorem item_none (it : KImp.SortKItem) : item G none it = item0 G it := by cases it <;> rfl
theorem item_frz (t : Ty) (f : KImp.SortKItem.Own) : item G (some t) (.inj_KItem f) = (plug f (dflt t)).bind (item0 G) := rfl
theorem kty_dotk (i : Option Ty) : kty G i .dotk = i.isNone := rfl
theorem kty_kseq (i : Option Ty) (it : KImp.SortKItem) (k : KImp.SortK) :
    kty G i (.kseq it k) = (match item G i it with | some o => kty G o k | none => false) := rfl
end ItemEqs

/-- The simp set that computes a continuation's typing (and uses the hypotheses, which record
the cases taken so far). -/
macro "ty_simp" : tactic => `(tactic| simp only [WTc, kOf, envOf, kty_dotk, kty_kseq, item_none, item_frz, item0_int,
    item0_bool, item0_id, item0_expr, item0_stmt, item0_frz, plug, dflt, bin, una, same,
    KImp.proj_inj_KItem_Expr, KImp.proj_inj_KItem_Id, KImp.proj_inj_KItem_Stmt, item0_inj_Expr, item0_inj_Stmt, tyOf_dflt,
    tyOf_int, tyOf_bool, tyOf_neg, tyOf_not, tyOf_add, tyOf_sub, tyOf_mul, tyOf_div, tyOf_ge, tyOf_gt, tyOf_le, tyOf_lt,
    tyOf_eq, tyOf_ne, tyOf_and, tyOf_or, wtS_skip, wtS_block, wtS_assign, wtS_seq, wtS_ife, wtS_if, wtS_while,
    Option.map_some, Option.map_none, Option.bind_some, Option.bind_none, Bool.and_true, Bool.true_and,
    Bool.and_false, Bool.false_and, ite_true, ite_false, ↓reduceIte, and_self, and_true, true_and, *])

/-- A lookup after an update at another key (sorted association lists; no sortedness needed). -/
theorem SAL_lookup_insert_ne {α β : Type} [Ord α] [Std.TransOrd α] [Std.LawfulEqOrd α] {k k' : α} (v : β) (hne : k' ≠ k) :
    ∀ (m : List (α × β)), SAL.lookup k' (SAL.insert k v m) = SAL.lookup k' m
  | [] => by
    simp only [SAL.insert, SAL.lookup]
    cases hc : compare k' k
    · rfl
    · exact absurd (SAL.eq_of_cmp hc) hne
    · rfl
  | (k₁, v₁) :: t => by
    simp only [SAL.insert]
    cases h₁ : compare k k₁
    · simp only [SAL.lookup]
      cases hc : compare k' k
      · simp only [SAL.lookup_of_lt (m := (k₁, v₁) :: t), SAL.lookup]
        rw [SAL.lt_trans hc h₁]
      · exact absurd (SAL.eq_of_cmp hc) hne
      · rfl
    · have := SAL.eq_of_cmp h₁; subst this
      simp only [SAL.lookup]
      cases hc : compare k' k
      · rfl
      · exact absurd (SAL.eq_of_cmp hc) hne
      · rfl
    · simp only [SAL.lookup]
      cases compare k' k₁
      · rfl
      · rfl
      · exact SAL_lookup_insert_ne v hne t

theorem tyOf_value (G : TEnv) (V : KImp.SortValue) : tyOf G (KImp.inj_Value_Expr V) = valTy (KImp.inj_Value_KItem V) := by
  cases V <;> simp [KImp.inj_Value_Expr, KImp.inj_Value_KItem, valTy, tyOf_int, tyOf_bool]
end ImpTypes
