import ImpTypes.Typing

/-!
# The store typing of kimp, and the rules that read or write the store

HAND-WRITTEN: the part of kimp's type soundness that is specific to its store. Everything else is
generated by `k2lean soundness` (`k2lean/docs/design.md`, §3.3) from `imp.k` and the type checker
`k/imp-typing.k`: the runtime typing of `<k>` and `WTc` (`Typing.lean`), and preservation,
progress and `soundness` (`Soundness.lean`), which cite this file's names:
- `envTy`, the store typing (`k2lean soundness --store-typing envTy`): the store holds a value of
  the declared type for every identifier the typing environment types;
- `hand.r`, the preservation case of each rule `r` that reads or writes the store, as the generated
  `KImp.Step.Case.r (WTc envTy G)`;
- `hand.progress.r`, the progress case of each rule `r` that reads the store, as the generated
  `Progress.Case.r envTy`.
-/

namespace ImpTypes

open KPrelude

/-- The type of a runtime value. -/
def valTy : KImp.SortKItem → Option Ty
  | .inj_Int _ => some .int
  | .inj_Bool _ => some .bool
  | _ => none

/-- The store holds a value of its type for every identifier the typing environment types. -/
def envTy (G : TEnv) (E : KImp.SortMap) : Prop :=
  MapHook.WF E ∧ ∀ x t, typeOf G (.inj_Id x) = some t →
    ∃ v, MapHook.lookup E (KImp.SortKItem.inj_Id x) = some v ∧ valTy v = some t

theorem typeOf_value (G : TEnv) (V : KImp.SortValue) :
    typeOf G (KImp.inj_Value_Expr V) = valTy (KImp.inj_Value_KItem V) := by
  cases V <;> simp [KImp.inj_Value_Expr, KImp.inj_Value_KItem, valTy, typeOf.inj_Int, typeOf.inj_Bool]

namespace hand

/-- `CALC.var`: `<k> X:Id => V ...</k> <env> X |-> V ...</env>`. The looked-up value is the
store's value at `X`, which the store typing says has the type of `X`. -/
theorem «CALC.var» (G : TEnv) : KImp.Step.Case.«CALC.var» (WTc envTy G) := by
  intro X K g m v D hm
  rintro ⟨hk, he⟩
  simp only [WTc, kOf, envOf, envCellTy] at hk he ⊢
  refine ⟨?_, he⟩
  simp only [kty_kseq, item_none, item0_inj_Id] at hk ⊢
  cases ht : typeOf G (.inj_Id X) with
  | none => simp [ht] at hk
  | some t =>
    simp only [ht, Option.map_some] at hk
    obtain ⟨v', hl, hv⟩ := he.2 X t ht
    rw [MapHook.lookup_of_concat_element hm] at hl
    obtain rfl := Option.some.inj hl
    cases v <;> simp_all [valTy, item0_inj_Int, item0_inj_Bool, typeOf.inj_Int, typeOf.inj_Bool]

/-- `CALC.assign`: `<k> X = V:Value ; => .K ...</k> <env> E => E [ X <- V ] </env>`. A well-typed
assignment stores a value of `X`'s type at `X`; the other keys keep their values. -/
theorem «CALC.assign» (G : TEnv) : KImp.Step.Case.«CALC.assign» (WTc envTy G) := by
  intro X y K E g V hp
  rintro ⟨hk, he⟩
  simp only [WTc, kOf, envOf, envCellTy] at hk he ⊢
  rw [KImp.proj_eq_some_Expr_Value] at hp
  subst hp
  simp only [kty_kseq, item_none, item0_inj_Stmt, wt.«_=_;»] at hk
  rcases h₁ : typeOf G (.inj_Id X) with _ | t₁ <;> rcases h₂ : typeOf G (KImp.inj_Value_Expr V) with _ | t₂ <;>
    simp only [h₁, h₂] at hk <;> try simp at hk
  by_cases hxt : t₁ = t₂
  case neg => simp [hxt] at hk
  subst hxt
  simp only [ite_true] at hk
  refine ⟨hk, MapHook.wf_update he.1, ?_⟩
  intro x t hx
  by_cases hxX : x = X
  · subst hxX
    refine ⟨KImp.inj_Value_KItem V, MapHook.lookup_update_self _ _ _, ?_⟩
    rw [← typeOf_value, h₂, ← h₁, hx]
  · obtain ⟨v, hl, hv⟩ := he.2 x t hx
    refine ⟨v, ?_, hv⟩
    rwa [MapHook.lookup_update_ne]
    intro h; exact hxX (by cases h; rfl)

namespace progress

/-- `CALC.var` applies to a typed identifier: the store typing gives it a value. -/
theorem «CALC.var» : Progress.Case.«CALC.var» envTy := by
  rintro G x K E g ⟨hk, he⟩
  simp only [kOf, envOf, envCellTy, kty_kseq, item_none, item0_inj_Id] at hk he
  cases ht : typeOf G (.inj_Id x) with
  | none => simp [ht] at hk
  | some t =>
    obtain ⟨v, hl, -⟩ := he.2 x t ht
    exact KImp.App.«CALC.var» x K g E v _ (MapHook.concat_element_remove he.1 hl)

end progress

end hand

#k2l_assert_axioms typeOf_value hand.«CALC.var» hand.«CALC.assign» hand.progress.«CALC.var»

end ImpTypes
