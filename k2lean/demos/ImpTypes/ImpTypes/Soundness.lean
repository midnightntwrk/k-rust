import ImpTypes.Cases
import ImpTypes.Progress

/-!
# Type soundness of kimp for the K type checker `imp-typing.k`

HAND-WRITTEN, over two generated libraries:
- `KImp`: kimp's semantics (`Step`, `App`), generated from `imp.k`;
- `KImpTypes`: the type checker `typeOf`/`wt`, generated from `k/imp-typing.k`, a second K
  definition over the same syntax;
- `ImpTypes.Tr` (generated by `k2lean relate --roots`): the translation of programs.

The runtime typing `WTc G` and its preservation are a kind 2 invariant in the layout that
`k2lean new-invariant` writes (`k2lean/docs/invariants.md`, §4): `Invariant.lean` (sections 1–4),
`Cases.lean` (`preserved`, with the two store rules as hand cases) and `Run.lean`. Progress is in
`Progress.lean`. This file states the two theorems of type soundness: `preservation`, restated
from `preserved`, and `soundness`, which combines it with `progress`.
-/

set_option maxHeartbeats 0
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace ImpTypes

open KPrelude

/-! ## 4. Preservation (from the kind 2 layout, `Cases.lean`) -/

theorem preservation {G : TEnv} {c c' : KImp.SortGeneratedTopCell} (h : KImp.Step c c') : WTc G c → WTc G c' :=
  fun hw => preserved G c c' hw h

/-! ## 6. Type soundness (template: generated from preservation and progress) -/

/-- The initial configuration of program `P` with store `E`, as `krun` builds it. -/
def init (P : KImp.SortStmt) (E : KImp.SortMap) (g : KImp.SortGeneratedCounterCell) : KImp.SortGeneratedTopCell :=
  .«<generatedTop>» (.«<k>» (.kseq (.inj_Stmt P) .dotk)) (.«<env>» E) g

theorem wt_init {G : TEnv} {P : KImp.SortStmt} {E : KImp.SortMap} {g} (hP : wtS G P = true) (hE : envTy G E) :
    WTc G (init P E g) := by
  refine ⟨?_, hE⟩
  simp [init, kOf, kty_kseq, item_none, item0_stmt, hP, kty_dotk]

theorem wt_stepsN {G : TEnv} : ∀ {n : Nat} {c c' : KImp.SortGeneratedTopCell}, StepsN KImp.Step n c c' → WTc G c → WTc G c'
  | _, _, _, .refl _, h => h
  | _, _, _, .step hs rest, h => wt_stepsN rest (preservation hs h)

/-- **Type soundness.** A program that the K type checker `imp-typing.k` accepts, started with a
store that holds a value of the declared type for every typed identifier, never gets stuck in
kimp: every reachable configuration has terminated or has a rule that applies (a step, or an
undefined result such as `x / 0`). -/
theorem soundness {G : TEnv} {P : KImp.SortStmt} {E : KImp.SortMap} {g : KImp.SortGeneratedCounterCell}
    (hP : KImpTypes.K.«wt(_,_)_IMP-TYPING_Bool_Stmt_Map» (tr_SortStmt P) G = some true) (hE : envTy G E)
    {n : Nat} {c : KImp.SortGeneratedTopCell} (h : StepsN KImp.Step n (init P E g) c) :
    Final c ∨ KImp.App c :=
  progress c (wt_stepsN h (wt_init (by simp [wtS, hP]) hE))

#k2l_assert_axioms preservation progress soundness

end ImpTypes
