import ImpNI.Tr
import KImp.Preserves
import KPrelude.Scaffold

/-! The hand module of `ImpNI`: what the noninterference statement of `NI.lean` (generated by
`k2lean noninterference`) is about. A program is `secure` at a labelling `G` (identifiers to
`lo`, `hi`) when the security checker `k/imp-sec.k` accepts its translation; two stores are
`lowEq` when they agree on every identifier `G` labels `lo`. -/

namespace ImpNI

open KPrelude

/-- The checker accepts the program at the labelling `G`. -/
def secure (G : KImpSec.SortMap) (P : KImp.SortStmt) : Prop :=
  KImpSec.K.«sec(_,_)_IMP-SEC_Bool_Stmt_Map» (tr_SortStmt P) G = some true

/-- The two stores agree on the identifiers `G` labels `lo`. -/
def lowEq (G : KImpSec.SortMap) (E₁ E₂ : KImp.SortMap) : Prop :=
  ∀ X : KImp.SortId,
    MapHook.lookup G (KImpSec.SortKItem.inj_Id (tr_SortId X)) =
      some (KImpSec.SortKItem.inj_Level KImpSec.SortLevel.lo) →
    MapHook.lookup E₁ (KImp.SortKItem.inj_Id X) = MapHook.lookup E₂ (KImp.SortKItem.inj_Id X)

end ImpNI
