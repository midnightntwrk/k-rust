import MeasureBench.Programs

/-! Generated by k2lean; do not edit. `Measure-run NAME [FUEL]`. -/

open Measure MeasureBench KPrelude

def main (args : List String) : IO UInt32 := do
  match args with
  | [] | ["--list"] =>
    for (n, _) in programs do IO.println n
    return 0
  | name :: rest =>
    let fuel := (rest.head? >>= String.toNat?).getD 1000000000
    match programs.find? (·.1 == name) with
    | none => IO.eprintln s!"unknown program {name}"; return 2
    | some (_, c) =>
      let t0 ← IO.monoNanosNow
      -- `IO.lazyPure` keeps the run inside the timed region
      let r ← IO.lazyPure fun _ => run fuel c
      if r.steps == 0 && r.status == .outOfFuel then IO.eprintln "no step taken"
      let steps := r.steps
      let t1 ← IO.monoNanosNow
      let st := match r.status with
        | .stuck => "stuck" | .final => "final" | .undefined n => s!"undefined {n}" | .outOfFuel => "out-of-fuel"
      IO.println s!"status: {st}"
      IO.println s!"steps: {steps}"
      IO.println s!"time_ms: {(t1 - t0).toFloat / 1000000.0}"
      IO.println s!"config: {toK_SortGeneratedTopCell r.config}"
      return 0
