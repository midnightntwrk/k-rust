theorem SortWorkerCellMap.sizeOf_eraseR {k : SortWidCell} {v : SortWorkerCell} : ∀ {m : SortWorkerCellMap}, SortWorkerCellMap.lookupR k m = some v → sizeOf (SortWorkerCellMap.eraseR k m) < sizeOf m
  | .nil, h => by simp [SortWorkerCellMap.lookupR] at h
  | .cons k' v' t, h => by
    unfold SortWorkerCellMap.lookupR at h
    unfold SortWorkerCellMap.eraseR
    cases ho : compare k k' <;> simp only [ho] at h ⊢
    · simp at h
    · simp only [SortWorkerCellMap.cons.sizeOf_spec]; omega
    · have := SortWorkerCellMap.sizeOf_eraseR h; simp only [SortWorkerCellMap.cons.sizeOf_spec]; omega

