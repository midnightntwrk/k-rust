theorem proj_eq_some_KItem_WorkersCellOpt {y : SortKItem} {x : SortWorkersCellOpt} : proj_KItem_WorkersCellOpt y = some x ↔ y = inj_WorkersCellOpt_KItem x :=
  ⟨fun h => (inj_proj_KItem_WorkersCellOpt h).symm, fun h => by subst h; exact proj_inj_KItem_WorkersCellOpt x⟩

