/-! Printing (for test reports), in a KORE-like notation with K labels. -/

mutual
def toK_SortCntCell : SortCntCell → String
  | .«<cnt>» a0 => "<cnt>" ++ "(" ++ toK_SortInt a0 ++ ")"
def toK_SortCntCellOpt : SortCntCellOpt → String
  | .inj_CntCell a0 => toK_SortCntCell a0
  | .inj_CntCellOpt a0 => toK_SortCntCellOpt_Own a0
def toK_SortCntCellOpt_Own : SortCntCellOpt.Own → String
  | .noCntCell  => "noCntCell"
def toK_SortGeneratedCounterCell : SortGeneratedCounterCell → String
  | .«<generatedCounter>» a0 => "<generatedCounter>" ++ "(" ++ toK_SortInt a0 ++ ")"
def toK_SortGeneratedCounterCellOpt : SortGeneratedCounterCellOpt → String
  | .inj_GeneratedCounterCell a0 => toK_SortGeneratedCounterCell a0
  | .inj_GeneratedCounterCellOpt a0 => toK_SortGeneratedCounterCellOpt_Own a0
def toK_SortGeneratedCounterCellOpt_Own : SortGeneratedCounterCellOpt.Own → String
  | .noGeneratedCounterCell  => "noGeneratedCounterCell"
def toK_SortGeneratedTopCell : SortGeneratedTopCell → String
  | .«<generatedTop>» a0 a1 => "<generatedTop>" ++ "(" ++ toK_SortTCell a0 ++ ", " ++ toK_SortGeneratedCounterCell a1 ++ ")"
def toK_SortGeneratedTopCellFragment : SortGeneratedTopCellFragment → String
  | .«<generatedTop>-fragment» a0 a1 => "<generatedTop>-fragment" ++ "(" ++ toK_SortTCellOpt a0 ++ ", " ++ toK_SortGeneratedCounterCellOpt a1 ++ ")"
def toK_SortK : SortK → String
  | .dotk  => ".K"
  | .kseq a0 a1 => toK_SortKItem a0 ++ " ~> " ++ toK_SortK a1
def toK_SortKCell : SortKCell → String
  | .«<k>» a0 => "<k>" ++ "(" ++ toK_SortK a0 ++ ")"
def toK_SortKCellOpt : SortKCellOpt → String
  | .inj_KCell a0 => toK_SortKCell a0
  | .inj_KCellOpt a0 => toK_SortKCellOpt_Own a0
def toK_SortKCellOpt_Own : SortKCellOpt.Own → String
  | .noKCell  => "noKCell"
def toK_SortKItem : SortKItem → String
  | .inj_Bool a0 => toK_SortBool a0
  | .inj_CntCell a0 => toK_SortCntCell a0
  | .inj_CntCellOpt a0 => toK_SortCntCellOpt_Own a0
  | .inj_GeneratedCounterCell a0 => toK_SortGeneratedCounterCell a0
  | .inj_GeneratedCounterCellOpt a0 => toK_SortGeneratedCounterCellOpt_Own a0
  | .inj_GeneratedTopCell a0 => toK_SortGeneratedTopCell a0
  | .inj_GeneratedTopCellFragment a0 => toK_SortGeneratedTopCellFragment a0
  | .inj_Int a0 => toK_SortInt a0
  | .inj_KCell a0 => toK_SortKCell a0
  | .inj_KCellOpt a0 => toK_SortKCellOpt_Own a0
  | .inj_KConfigVar a0 => toK_SortKConfigVar a0
  | .inj_KItem a0 => toK_SortKItem_Own a0
  | .inj_List a0 => toK_SortList a0
  | .inj_MCell a0 => toK_SortMCell a0
  | .inj_MCellOpt a0 => toK_SortMCellOpt_Own a0
  | .inj_Map a0 => toK_SortMap a0
  | .inj_Pgm a0 => toK_SortPgm a0
  | .inj_Set a0 => toK_SortSet a0
  | .inj_TCell a0 => toK_SortTCell a0
  | .inj_TCellFragment a0 => toK_SortTCellFragment a0
  | .inj_TCellOpt a0 => toK_SortTCellOpt_Own a0
  | .inj_WidCell a0 => toK_SortWidCell a0
  | .inj_WidCellOpt a0 => toK_SortWidCellOpt_Own a0
  | .inj_WorkerCell a0 => toK_SortWorkerCell a0
  | .inj_WorkerCellFragment a0 => toK_SortWorkerCellFragment a0
  | .inj_WorkerCellMap a0 => toK_SortWorkerCellMap a0
  | .inj_WorkersCell a0 => toK_SortWorkersCell a0
  | .inj_WorkersCellFragment a0 => toK_SortWorkersCellFragment a0
  | .inj_WorkersCellOpt a0 => toK_SortWorkersCellOpt_Own a0
def toK_SortKItem_Own : SortKItem.Own → String
  | .«#KConfigValue» a0 => "#KConfigValue" ++ "(" ++ toK_SortK a0 ++ ")"
def toK_SortList : SortList → String
  | .nil  => ".List"
  | .cons a0 a1 => "ListItem(" ++ toK_SortKItem a0 ++ ") " ++ toK_SortList a1
def toK_SortMCell : SortMCell → String
  | .«<m>» a0 => "<m>" ++ "(" ++ toK_SortMap a0 ++ ")"
def toK_SortMCellOpt : SortMCellOpt → String
  | .inj_MCell a0 => toK_SortMCell a0
  | .inj_MCellOpt a0 => toK_SortMCellOpt_Own a0
def toK_SortMCellOpt_Own : SortMCellOpt.Own → String
  | .noMCell  => "noMCell"
def toK_SortMap : SortMap → String
  | .nil  => ".Map"
  | .cons a0 a1 a2 => toK_SortKItem a0 ++ " |-> " ++ toK_SortKItem a1 ++ " " ++ toK_SortMap a2
def toK_SortPgm : SortPgm → String
  | .go  => "go_FREEKEY-SYNTAX_Pgm"
def toK_SortSet : SortSet → String
  | .nil  => ".Set"
  | .cons a0 a1 => "SetItem(" ++ toK_SortKItem a0 ++ ") " ++ toK_SortSet a1
def toK_SortTCell : SortTCell → String
  | .«<T>» a0 a1 a2 => "<T>" ++ "(" ++ toK_SortKCell a0 ++ ", " ++ toK_SortMCell a1 ++ ", " ++ toK_SortWorkersCell a2 ++ ")"
def toK_SortTCellFragment : SortTCellFragment → String
  | .«<T>-fragment» a0 a1 a2 => "<T>-fragment" ++ "(" ++ toK_SortKCellOpt a0 ++ ", " ++ toK_SortMCellOpt a1 ++ ", " ++ toK_SortWorkersCellOpt a2 ++ ")"
def toK_SortTCellOpt : SortTCellOpt → String
  | .inj_TCell a0 => toK_SortTCell a0
  | .inj_TCellOpt a0 => toK_SortTCellOpt_Own a0
def toK_SortTCellOpt_Own : SortTCellOpt.Own → String
  | .noTCell  => "noTCell"
def toK_SortWidCell : SortWidCell → String
  | .«<wid>» a0 => "<wid>" ++ "(" ++ toK_SortInt a0 ++ ")"
def toK_SortWidCellOpt : SortWidCellOpt → String
  | .inj_WidCell a0 => toK_SortWidCell a0
  | .inj_WidCellOpt a0 => toK_SortWidCellOpt_Own a0
def toK_SortWidCellOpt_Own : SortWidCellOpt.Own → String
  | .noWidCell  => "noWidCell"
def toK_SortWorkerCell : SortWorkerCell → String
  | .«<worker>» a0 a1 => "<worker>" ++ "(" ++ toK_SortWidCell a0 ++ ", " ++ toK_SortCntCell a1 ++ ")"
def toK_SortWorkerCellFragment : SortWorkerCellFragment → String
  | .«<worker>-fragment» a0 a1 => "<worker>-fragment" ++ "(" ++ toK_SortWidCellOpt a0 ++ ", " ++ toK_SortCntCellOpt a1 ++ ")"
def toK_SortWorkerCellMap : SortWorkerCellMap → String
  | .nil  => ".Map"
  | .cons a0 a1 a2 => toK_SortWidCell a0 ++ " |-> " ++ toK_SortWorkerCell a1 ++ " " ++ toK_SortWorkerCellMap a2
def toK_SortWorkersCell : SortWorkersCell → String
  | .«<workers>» a0 => "<workers>" ++ "(" ++ toK_SortWorkerCellMap a0 ++ ")"
def toK_SortWorkersCellFragment : SortWorkersCellFragment → String
  | .«<workers>-fragment» a0 => "<workers>-fragment" ++ "(" ++ toK_SortWorkerCellMap a0 ++ ")"
def toK_SortWorkersCellOpt : SortWorkersCellOpt → String
  | .inj_WorkersCell a0 => toK_SortWorkersCell a0
  | .inj_WorkersCellOpt a0 => toK_SortWorkersCellOpt_Own a0
def toK_SortWorkersCellOpt_Own : SortWorkersCellOpt.Own → String
  | .noWorkersCell  => "noWorkersCell"
end

end FreeKey
