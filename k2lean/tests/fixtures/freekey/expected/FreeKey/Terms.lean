    simp only [serL_SortList, decL_SortList, List.cons_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, h0, ht]
theorem dec_serL_SortMap : ∀ (l : List ((Term .«SortKItem») × (Term .«SortKItem»))) (r : List Tok) (n : Nat), (serL_SortMap l).length ≤ n → decL_SortMap n (serL_SortMap l ++ r) = some (l, r)
