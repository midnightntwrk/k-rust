theorem ser_inj {s : Tag} (a b : Term s) (h : ser a = ser b) : a = b := by
  have ha := dec_ser a [] (ser a).length (Nat.le_refl _)
  have hb := dec_ser b [] (ser a).length (by simp [h])
  rw [h] at ha
  simp_all

theorem compare_append_ser_Term {s : Tag} (a b : Term s) (r r' : List Tok) :
    compare (ser a ++ r) (ser b ++ r') = (compare (ser a) (ser b)).then (compare r r') :=
  compare_append_ser (@ser s) (fun n t => dec n s t) (fun a r n h => dec_ser a r n h) a b r r'

/-! Equality by structural recursion (`Term.beq`): the kernel decides `a = b` on closed terms
without unfolding a definition by well-founded recursion; builtin values compare by `LeafEq`. -/

instance : LeafEq SortKConfigVar := LeafEq.ofVal SortKConfigVar.val (fun a b h => by cases a; cases b; cases h; rfl)

theorem idx0_inj {s : Tag} {c d : C0 s} (h : idx0 s c = idx0 s d) : c = d := by
  have e := ofIdx0_idx0 s c
  rw [h, ofIdx0_idx0] at e
  exact (Option.some.inj e).symm
theorem idx1_inj {s : Tag} {c d : C1 s} (h : idx1 s c = idx1 s d) : c = d := by
  have e := ofIdx1_idx1 s c
  rw [h, ofIdx1_idx1] at e
  exact (Option.some.inj e).symm
theorem idx2_inj {s : Tag} {c d : C2 s} (h : idx2 s c = idx2 s d) : c = d := by
  have e := ofIdx2_idx2 s c
  rw [h, ofIdx2_idx2] at e
  exact (Option.some.inj e).symm
theorem idx4_inj {s : Tag} {c d : C4 s} (h : idx4 s c = idx4 s d) : c = d := by
  have e := ofIdx4_idx4 s c
  rw [h, ofIdx4_idx4] at e
  exact (Option.some.inj e).symm
theorem idx5_inj {s : Tag} {c d : C5 s} (h : idx5 s c = idx5 s d) : c = d := by
  have e := ofIdx5_idx5 s c
  rw [h, ofIdx5_idx5] at e
  exact (Option.some.inj e).symm

mutual
def Term.beq : {s t : Tag} → Term s → Term t → Bool
  | _, _, .«b_SortBool» v, b => match b with | .«b_SortBool» w => LeafEq.beq v w | _ => false
  | _, _, .«b_SortInt» v, b => match b with | .«b_SortInt» w => LeafEq.beq v w | _ => false
  | _, _, .«b_SortKConfigVar» v, b => match b with | .«b_SortKConfigVar» w => LeafEq.beq v w | _ => false
  | _, _, @Term.c0 s c, b => match b with
    | @Term.c0 t d => decide (s = t) && (idx0 s c == idx0 t d)
    | _ => false
  | _, _, @Term.c1 s c a0, b => match b with
    | @Term.c1 t d b0 => decide (s = t) && (idx1 s c == idx1 t d && (Term.beq a0 b0))
    | _ => false
  | _, _, @Term.c2 s c a0 a1, b => match b with
    | @Term.c2 t d b0 b1 => decide (s = t) && (idx2 s c == idx2 t d && (Term.beq a0 b0 && (Term.beq a1 b1)))
    | _ => false
  | _, _, @Term.c4 s c a0 a1 a2 a3, b => match b with
    | @Term.c4 t d b0 b1 b2 b3 => decide (s = t) && (idx4 s c == idx4 t d && (Term.beq a0 b0 && (Term.beq a1 b1 && (Term.beq a2 b2 && (Term.beq a3 b3)))))
    | _ => false
  | _, _, @Term.c5 s c a0 a1 a2 a3 a4, b => match b with
    | @Term.c5 t d b0 b1 b2 b3 b4 => decide (s = t) && (idx5 s c == idx5 t d && (Term.beq a0 b0 && (Term.beq a1 b1 && (Term.beq a2 b2 && (Term.beq a3 b3 && (Term.beq a4 b4))))))
    | _ => false
  | _, _, .«coll_SortJobCellMap» l, b => match b with | .«coll_SortJobCellMap» l' => beqL_SortJobCellMap l l' | _ => false
  | _, _, .«coll_SortList» l, b => match b with | .«coll_SortList» l' => beqL_SortList l l' | _ => false
