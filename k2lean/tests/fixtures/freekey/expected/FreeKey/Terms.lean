instance : DecidableEq SortCntCell := fun a b =>
  if h : cmp_SortCntCell a b = .eq then isTrue (ser_SortCntCell_inj a b (Std.LawfulEqOrd.eq_of_compare ((cmp_SortCntCell_eq a b) ▸ h)))
  else isFalse (fun e => h (by subst e; rw [cmp_SortCntCell_eq]; exact Std.ReflOrd.compare_self))
instance : DecidableEq SortCntCellOpt := fun a b =>
  if h : cmp_SortCntCellOpt a b = .eq then isTrue (ser_SortCntCellOpt_inj a b (Std.LawfulEqOrd.eq_of_compare ((cmp_SortCntCellOpt_eq a b) ▸ h)))
