/-! Serialization: injective (`dec_ser`), it induces the order on terms. -/

mutual
def ser : {s : Tag} → Term s → List Tok
  | _, .«b_SortBool» v => ser_SortBool v
  | _, .«b_SortInt» v => ser_SortInt v
  | _, .«b_SortKConfigVar» v => ser_SortKConfigVar v
  | _, @Term.c0 s c  => .c 0 :: .c (idx0 s c) :: []
  | _, @Term.c1 s c a0 => .c 1 :: .c (idx1 s c) :: ser a0
  | _, @Term.c2 s c a0 a1 => .c 2 :: .c (idx2 s c) :: (ser a0 ++ ser a1)
  | _, @Term.c4 s c a0 a1 a2 a3 => .c 4 :: .c (idx4 s c) :: (ser a0 ++ (ser a1 ++ (ser a2 ++ ser a3)))
  | _, @Term.c5 s c a0 a1 a2 a3 a4 => .c 5 :: .c (idx5 s c) :: (ser a0 ++ (ser a1 ++ (ser a2 ++ (ser a3 ++ ser a4))))
  | _, .«coll_SortJobCellMap» l => .c 1000 :: serL_SortJobCellMap l
  | _, .«coll_SortList» l => .c 1001 :: serL_SortList l
  | _, .«coll_SortMap» l => .c 1002 :: serL_SortMap l
  | _, .«coll_SortSet» l => .c 1003 :: serL_SortSet l
  | _, .«coll_SortWorkerCellMap» l => .c 1004 :: serL_SortWorkerCellMap l
  | _, Term.inj _ l _ a => .c 999 :: .c l.ctorIdx :: ser a
def serL_SortJobCellMap : List ((Term .«SortJidCell») × (Term .«SortJobCell»)) → List Tok
  | [] => [.c 0]
  | (k, v) :: t => .c 1 :: (ser k ++ (ser v ++ serL_SortJobCellMap t))
def serL_SortList : List (Term .«SortKItem») → List Tok
  | [] => [.c 0]
  | k :: t => .c 1 :: (ser k ++ serL_SortList t)
def serL_SortMap : List ((Term .«SortKItem») × (Term .«SortKItem»)) → List Tok
  | [] => [.c 0]
  | (k, v) :: t => .c 1 :: (ser k ++ (ser v ++ serL_SortMap t))
def serL_SortSet : List ((Term .«SortKItem») × Unit) → List Tok
  | [] => [.c 0]
  | (k, ()) :: t => .c 1 :: (ser k ++ serL_SortSet t)
def serL_SortWorkerCellMap : List ((Term .«SortWidCell») × (Term .«SortWorkerCell»)) → List Tok
  | [] => [.c 0]
  | (k, v) :: t => .c 1 :: (ser k ++ (ser v ++ serL_SortWorkerCellMap t))
end

/-- An injected value of sort `s` from a decoded leaf value of tag `l`. -/
def decInj (s l : Tag) (r : Option (Term l × List Tok)) : Option (Term s × List Tok) :=
  if hs : hasLeaves s = true then
    if h : leafOK s l = true then r.map (fun p => (Term.inj hs l h p.1, p.2)) else none
  else none

mutual
def dec : Nat → (s : Tag) → List Tok → Option (Term s × List Tok)
  | 0, _, _ => none
  | n + 1, s, .c 0 :: .c i :: t => do let c ← ofIdx0 s i; pure (Term.c0 c, t)
  | n + 1, s, .c 1 :: .c i :: t => do let c ← ofIdx1 s i; let (a0, t) ← dec n (A1_0 s c) t; pure (Term.c1 c a0, t)
  | n + 1, s, .c 2 :: .c i :: t => do let c ← ofIdx2 s i; let (a0, t) ← dec n (A2_0 s c) t; let (a1, t) ← dec n (A2_1 s c) t; pure (Term.c2 c a0 a1, t)
  | n + 1, s, .c 4 :: .c i :: t => do let c ← ofIdx4 s i; let (a0, t) ← dec n (A4_0 s c) t; let (a1, t) ← dec n (A4_1 s c) t; let (a2, t) ← dec n (A4_2 s c) t; let (a3, t) ← dec n (A4_3 s c) t; pure (Term.c4 c a0 a1 a2 a3, t)
  | n + 1, s, .c 5 :: .c i :: t => do let c ← ofIdx5 s i; let (a0, t) ← dec n (A5_0 s c) t; let (a1, t) ← dec n (A5_1 s c) t; let (a2, t) ← dec n (A5_2 s c) t; let (a3, t) ← dec n (A5_3 s c) t; let (a4, t) ← dec n (A5_4 s c) t; pure (Term.c5 c a0 a1 a2 a3 a4, t)
  | n + 1, .«SortJobCellMap», .c 1000 :: t => do let (l, t) ← decL_SortJobCellMap n t; pure (.«coll_SortJobCellMap» l, t)
  | n + 1, .«SortList», .c 1001 :: t => do let (l, t) ← decL_SortList n t; pure (.«coll_SortList» l, t)
  | n + 1, .«SortMap», .c 1002 :: t => do let (l, t) ← decL_SortMap n t; pure (.«coll_SortMap» l, t)
  | n + 1, .«SortSet», .c 1003 :: t => do let (l, t) ← decL_SortSet n t; pure (.«coll_SortSet» l, t)
  | n + 1, .«SortWorkerCellMap», .c 1004 :: t => do let (l, t) ← decL_SortWorkerCellMap n t; pure (.«coll_SortWorkerCellMap» l, t)
  | n + 1, s, .c 999 :: .c i :: t => decInj s (Tag.ofNat i) (dec n (Tag.ofNat i) t)
  | n + 1, .«SortBool», t => do let (v, t) ← dec_SortBool (n + 1) t; pure (.«b_SortBool» v, t)
  | n + 1, .«SortInt», t => do let (v, t) ← dec_SortInt (n + 1) t; pure (.«b_SortInt» v, t)
  | n + 1, .«SortKConfigVar», t => do let (v, t) ← dec_SortKConfigVar (n + 1) t; pure (.«b_SortKConfigVar» v, t)
  | _, _, _ => none
def decL_SortJobCellMap : Nat → List Tok → Option (List ((Term .«SortJidCell») × (Term .«SortJobCell»)) × List Tok)
  | 0, _ => none
  | _ + 1, .c 0 :: t => pure ([], t)
  | n + 1, .c 1 :: t => do let (k, t) ← dec n .«SortJidCell» t; let (v, t) ← dec n .«SortJobCell» t; let (r, t) ← decL_SortJobCellMap n t; pure ((k, v) :: r, t)
  | _, _ => none
def decL_SortList : Nat → List Tok → Option (List (Term .«SortKItem») × List Tok)
  | 0, _ => none
  | _ + 1, .c 0 :: t => pure ([], t)
  | n + 1, .c 1 :: t => do let (k, t) ← dec n .«SortKItem» t; let (r, t) ← decL_SortList n t; pure (k :: r, t)
  | _, _ => none
def decL_SortMap : Nat → List Tok → Option (List ((Term .«SortKItem») × (Term .«SortKItem»)) × List Tok)
  | 0, _ => none
  | _ + 1, .c 0 :: t => pure ([], t)
  | n + 1, .c 1 :: t => do let (k, t) ← dec n .«SortKItem» t; let (v, t) ← dec n .«SortKItem» t; let (r, t) ← decL_SortMap n t; pure ((k, v) :: r, t)
  | _, _ => none
def decL_SortSet : Nat → List Tok → Option (List ((Term .«SortKItem») × Unit) × List Tok)
  | 0, _ => none
  | _ + 1, .c 0 :: t => pure ([], t)
  | n + 1, .c 1 :: t => do let (k, t) ← dec n .«SortKItem» t; let (r, t) ← decL_SortSet n t; pure ((k, ()) :: r, t)
  | _, _ => none
def decL_SortWorkerCellMap : Nat → List Tok → Option (List ((Term .«SortWidCell») × (Term .«SortWorkerCell»)) × List Tok)
  | 0, _ => none
  | _ + 1, .c 0 :: t => pure ([], t)
  | n + 1, .c 1 :: t => do let (k, t) ← dec n .«SortWidCell» t; let (v, t) ← dec n .«SortWorkerCell» t; let (r, t) ← decL_SortWorkerCellMap n t; pure ((k, v) :: r, t)
  | _, _ => none
end

mutual
theorem dec_ser : ∀ {s : Tag} (a : Term s) (r : List Tok) (n : Nat), (ser a).length ≤ n → dec n s (ser a ++ r) = some (a, r)
  | _, .«b_SortBool» v, r, 0, h => absurd h (by simp [ser, ser_SortBool, KPrelude.BytesHook.ser])
  | _, .«b_SortBool» v, r, n + 1, h => by
    have e := dec_ser_SortBool v r (n + 1) h
    show (dec_SortBool (n + 1) (ser_SortBool v ++ r) >>= fun (p : SortBool × List Tok) => pure (Term.«b_SortBool» p.1, p.2)) = _
    rw [e]; rfl
  | _, .«b_SortInt» v, r, 0, h => absurd h (by simp [ser, ser_SortInt, KPrelude.BytesHook.ser])
  | _, .«b_SortInt» v, r, n + 1, h => by
    have e := dec_ser_SortInt v r (n + 1) h
    show (dec_SortInt (n + 1) (ser_SortInt v ++ r) >>= fun (p : SortInt × List Tok) => pure (Term.«b_SortInt» p.1, p.2)) = _
    rw [e]; rfl
  | _, .«b_SortKConfigVar» v, r, 0, h => absurd h (by simp [ser, ser_SortKConfigVar, KPrelude.BytesHook.ser])
  | _, .«b_SortKConfigVar» v, r, n + 1, h => by
    have e := dec_ser_SortKConfigVar v r (n + 1) h
    show (dec_SortKConfigVar (n + 1) (ser_SortKConfigVar v ++ r) >>= fun (p : SortKConfigVar × List Tok) => pure (Term.«b_SortKConfigVar» p.1, p.2)) = _
    rw [e]; rfl
  | _, @Term.c0 s c , r, 0, h => absurd h (by simp [ser])
  | _, @Term.c0 s c , r, n + 1, h => by
    simp only [ser, dec, List.cons_append, List.nil_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, ofIdx0_idx0]
  | _, @Term.c1 s c a0, r, 0, h => absurd h (by simp [ser])
  | _, @Term.c1 s c a0, r, n + 1, h => by
    have hl : (ser a0).length ≤ n := by
      have e : (ser (Term.c1 c a0)).length = (ser a0).length + 2 := rfl
      omega
    have h0 := dec_ser a0 (r) n hl
    simp only [ser, dec, List.cons_append, List.nil_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, ofIdx1_idx1, h0]
  | _, @Term.c2 s c a0 a1, r, 0, h => absurd h (by simp [ser])
  | _, @Term.c2 s c a0 a1, r, n + 1, h => by
    have hl : ((ser a0 ++ ser a1)).length ≤ n := by
      have e : (ser (Term.c2 c a0 a1)).length = ((ser a0 ++ ser a1)).length + 2 := rfl
      omega
    have h0 := dec_ser a0 ((ser a1 ++ r)) n (KPrelude.len_left hl)
    have h1 := dec_ser a1 (r) n (KPrelude.len_right hl)
    simp only [ser, dec, List.cons_append, List.nil_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, ofIdx2_idx2, h0, h1]
  | _, @Term.c4 s c a0 a1 a2 a3, r, 0, h => absurd h (by simp [ser])
  | _, @Term.c4 s c a0 a1 a2 a3, r, n + 1, h => by
    have hl : ((ser a0 ++ (ser a1 ++ (ser a2 ++ ser a3)))).length ≤ n := by
      have e : (ser (Term.c4 c a0 a1 a2 a3)).length = ((ser a0 ++ (ser a1 ++ (ser a2 ++ ser a3)))).length + 2 := rfl
      omega
    have h0 := dec_ser a0 ((ser a1 ++ (ser a2 ++ (ser a3 ++ r)))) n (KPrelude.len_left hl)
    have h1 := dec_ser a1 ((ser a2 ++ (ser a3 ++ r))) n (KPrelude.len_left (KPrelude.len_right hl))
    have h2 := dec_ser a2 ((ser a3 ++ r)) n (KPrelude.len_left (KPrelude.len_right (KPrelude.len_right hl)))
    have h3 := dec_ser a3 (r) n (KPrelude.len_right (KPrelude.len_right (KPrelude.len_right hl)))
    simp only [ser, dec, List.cons_append, List.nil_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, ofIdx4_idx4, h0, h1, h2, h3]
  | _, @Term.c5 s c a0 a1 a2 a3 a4, r, 0, h => absurd h (by simp [ser])
  | _, @Term.c5 s c a0 a1 a2 a3 a4, r, n + 1, h => by
    have hl : ((ser a0 ++ (ser a1 ++ (ser a2 ++ (ser a3 ++ ser a4))))).length ≤ n := by
      have e : (ser (Term.c5 c a0 a1 a2 a3 a4)).length = ((ser a0 ++ (ser a1 ++ (ser a2 ++ (ser a3 ++ ser a4))))).length + 2 := rfl
      omega
    have h0 := dec_ser a0 ((ser a1 ++ (ser a2 ++ (ser a3 ++ (ser a4 ++ r))))) n (KPrelude.len_left hl)
    have h1 := dec_ser a1 ((ser a2 ++ (ser a3 ++ (ser a4 ++ r)))) n (KPrelude.len_left (KPrelude.len_right hl))
    have h2 := dec_ser a2 ((ser a3 ++ (ser a4 ++ r))) n (KPrelude.len_left (KPrelude.len_right (KPrelude.len_right hl)))
    have h3 := dec_ser a3 ((ser a4 ++ r)) n (KPrelude.len_left (KPrelude.len_right (KPrelude.len_right (KPrelude.len_right hl))))
    have h4 := dec_ser a4 (r) n (KPrelude.len_right (KPrelude.len_right (KPrelude.len_right (KPrelude.len_right hl))))
    simp only [ser, dec, List.cons_append, List.nil_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, ofIdx5_idx5, h0, h1, h2, h3, h4]
  | _, Term.inj hs l hl a, r, 0, h => absurd h (by simp [ser])
  | _, Term.inj hs l hl a, r, n + 1, h => by
    have e := dec_ser a r n (by simp only [ser, List.length_cons] at h; omega)
    simp only [ser, dec, List.cons_append]
    rw [Tag.ofNat_ctorIdx, e]
    simp only [decInj, hs, hl, dite_true, Option.map_some]
  | _, .«coll_SortJobCellMap» l, r, 0, h => absurd h (by simp [ser])
  | _, .«coll_SortJobCellMap» l, r, n + 1, h => by
    have e := dec_serL_SortJobCellMap l r n (by simp only [ser, List.length_cons] at h; omega)
    simp only [ser, dec, List.cons_append, List.nil_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, e]
  | _, .«coll_SortList» l, r, 0, h => absurd h (by simp [ser])
  | _, .«coll_SortList» l, r, n + 1, h => by
    have e := dec_serL_SortList l r n (by simp only [ser, List.length_cons] at h; omega)
    simp only [ser, dec, List.cons_append, List.nil_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, e]
  | _, .«coll_SortMap» l, r, 0, h => absurd h (by simp [ser])
  | _, .«coll_SortMap» l, r, n + 1, h => by
    have e := dec_serL_SortMap l r n (by simp only [ser, List.length_cons] at h; omega)
    simp only [ser, dec, List.cons_append, List.nil_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, e]
  | _, .«coll_SortSet» l, r, 0, h => absurd h (by simp [ser])
  | _, .«coll_SortSet» l, r, n + 1, h => by
    have e := dec_serL_SortSet l r n (by simp only [ser, List.length_cons] at h; omega)
    simp only [ser, dec, List.cons_append, List.nil_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, e]
  | _, .«coll_SortWorkerCellMap» l, r, 0, h => absurd h (by simp [ser])
  | _, .«coll_SortWorkerCellMap» l, r, n + 1, h => by
    have e := dec_serL_SortWorkerCellMap l r n (by simp only [ser, List.length_cons] at h; omega)
    simp only [ser, dec, List.cons_append, List.nil_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, e]
theorem dec_serL_SortJobCellMap : ∀ (l : List ((Term .«SortJidCell») × (Term .«SortJobCell»))) (r : List Tok) (n : Nat), (serL_SortJobCellMap l).length ≤ n → decL_SortJobCellMap n (serL_SortJobCellMap l ++ r) = some (l, r)
  | l, r, 0, h => absurd h (by cases l <;> simp [serL_SortJobCellMap])
  | [], r, n + 1, h => by simp [serL_SortJobCellMap, decL_SortJobCellMap]
  | (k, v) :: t, r, n + 1, h => by
    have hl : (ser k).length + (ser v).length + (serL_SortJobCellMap t).length ≤ n := by simp only [serL_SortJobCellMap, List.length_cons, List.length_append] at h; omega
    have h0 := dec_ser k ((ser v ++ (serL_SortJobCellMap t ++ r))) n (by omega)
    have h1 := dec_ser v ((serL_SortJobCellMap t ++ r)) n (by omega)
    have ht := dec_serL_SortJobCellMap t r n (by omega)
    simp only [serL_SortJobCellMap, decL_SortJobCellMap, List.cons_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, h0, h1, ht]
theorem dec_serL_SortList : ∀ (l : List (Term .«SortKItem»)) (r : List Tok) (n : Nat), (serL_SortList l).length ≤ n → decL_SortList n (serL_SortList l ++ r) = some (l, r)
  | l, r, 0, h => absurd h (by cases l <;> simp [serL_SortList])
