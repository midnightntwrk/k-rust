def bucketOf0 (c : SortGeneratedTopCell) : List (Rule SortGeneratedTopCell (App 0) (Step0 0)) :=
  mergeRank
    (
      match c with
      | SortGeneratedTopCell.«<generatedTop>» (SortTCell.«<T>» (SortKCell.«<k>» x) _ _ _) _ =>
        match x with
        | SortK.kseq _ _ =>
          match c with
          | SortGeneratedTopCell.«<generatedTop>» (SortTCell.«<T>» (SortKCell.«<k>» (SortK.kseq x _)) _ _ _) _ =>
            match x with
            | SortKItem.inj_Pgm _ =>
              match c with
              | SortGeneratedTopCell.«<generatedTop>» (SortTCell.«<T>» (SortKCell.«<k>» (SortK.kseq (SortKItem.inj_Pgm x) _)) _ _ _) _ =>
                match x with
                | SortPgm.go  =>
                  [R.sum]
                | SortPgm.go2  =>
                  [R.take]
                | SortPgm.go3  =>
                  [R.jobs]
                | SortPgm.check  =>
                  [R.check]
              | _ => []
            | _ => []
          | _ => []
        | _ => []
