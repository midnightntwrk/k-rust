      \equals{SortKItem{}, R}(
        Val:SortKItem{},
        inj{SortTCellOpt{}, SortKItem{}}(From:SortTCellOpt{})
      )
    )
    [subsort{SortTCellOpt{}, SortKItem{}}()]
endmodule []
