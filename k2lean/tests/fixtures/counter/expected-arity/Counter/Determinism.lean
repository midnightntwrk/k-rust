theorem Step.deterministic {c c₁ c₂ : SortGeneratedTopCell} (h₁ : Step c c₁) (h₂ : Step c c₂) : c₁ = c₂ := by
  obtain ⟨i, a₁, hi⟩ := Step.base h₁
  obtain ⟨j, a₂, hj⟩ := Step.base h₂
  rcases Nat.lt_trichotomy i j with h' | rfl | h'
  · exact absurd (Step0.app a₁) (hj i h')
  · exact Step0.deterministic a₁ a₂
  · exact absurd (Step0.app a₂) (hi j h')

/-- With determinism, the executable step is complete. -/
theorem step_complete {c c' : SortGeneratedTopCell} (h : Step c c') : step c = .next c' := by
  obtain ⟨c'', hc⟩ := step_progress h
  rw [hc, Step.deterministic (step_sound hc) h]

theorem step_iff {c c' : SortGeneratedTopCell} : step c = .next c' ↔ Step c c' := ⟨step_sound, step_complete⟩

