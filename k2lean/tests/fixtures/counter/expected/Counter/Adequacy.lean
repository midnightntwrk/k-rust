/-- Soundness of the executable step. -/
theorem step_sound {c c' : SortGeneratedTopCell} (h : step c = .next c') : Step c c' := by
  unfold step at h
  rcases orStuck_next h with h0 | ⟨s0, h⟩
  · exact Step0.lift (firstDefined_sound _ c none c' h0) (fun j hj => absurd hj (Nat.not_lt_zero j))
  try simp only [] at h
  exact Step0.lift (firstDefined_sound _ c none c' h) (fun j hj => match j, hj with | 0, _ => rank0_stuck s0 | _ + 1, hj => absurd hj (by omega))

/-- If some rule has a successor, the step function takes a step. -/
theorem step_progress {c c' : SortGeneratedTopCell} (h : Step c c') : ∃ c'', step c = .next c'' := by
  obtain ⟨i, h0, hhi⟩ := Step.base h
  match i, h0, hhi with
  | 0, h0, hhi =>
    obtain ⟨r, hm, hr⟩ := rules0_complete h0
    obtain ⟨c'', hc⟩ := firstDefined_next_of_mem (bucketOf0 c) c none r c' hm hr
    refine ⟨c'', ?_⟩
    unfold step; simp only [orStuck_of_stuck, hc, orStuck]
  | 1, h0, hhi =>
    obtain ⟨r, hm, hr⟩ := rules1_complete h0
    obtain ⟨c'', hc⟩ := firstDefined_next_of_mem (bucketOf1 c) c none r c' hm hr
    refine ⟨c'', ?_⟩
    unfold step; rw [rank0_none (hhi 0 (by omega))]; simp only [orStuck_of_stuck, hc, orStuck]
  | _ + 2, h0, _ => cases h0

/-- A stuck configuration: no rule of any rank applies. -/
theorem step_stuck {c : SortGeneratedTopCell} (h : step c = .stuck) : ∀ i, ¬ App i c := by
  unfold step at h
  obtain ⟨s0, h⟩ := orStuck_stuck h
  try simp only [] at h
  have s1 := h
  intro i ha
  match i, ha with
  | 0, ha => exact rank0_stuck s0 ha
  | 1, ha => exact rank1_stuck s1 ha
  | _ + 2, ha => cases ha

/-- `successors` lists exactly the `Step` successors. -/
theorem successors_iff {c c' : SortGeneratedTopCell} : c' ∈ successors c ↔ Step c c' := by
  constructor
  · intro h
    unfold successors at h
    by_cases s0 : isStuck (firstDefined (bucketOf0 c) c none) = true
    · rw [ite_eq_left s0] at h
      exact Step0.lift (succ1_sound h) (fun j hj => match j, hj with | 0, _ => rank0_stuck (isStuck_iff.1 s0) | _ + 1, hj => absurd hj (by omega))
    · rw [ite_eq_right s0] at h
      exact Step0.lift (succ0_sound h) (fun j hj => absurd hj (Nat.not_lt_zero j))
  · intro hs
    obtain ⟨i, h0, hhi⟩ := Step.base hs
    unfold successors
    match i, h0, hhi with
    | 0, h0, hhi =>
      have n0 : ¬ isStuck (firstDefined (bucketOf0 c) c none) = true := fun e => rank0_stuck (isStuck_iff.1 e) (Step0.app h0)
      rw [ite_eq_right n0]
      exact succ0_complete h0
    | 1, h0, hhi =>
      rw [ite_eq_left (isStuck_iff.2 (rank0_none (hhi 0 (by omega))))]
      exact succ1_complete h0
    | _ + 2, h0, _ => cases h0

theorem stuck_no_step {c : SortGeneratedTopCell} (h : step c = .stuck) (c' : SortGeneratedTopCell) : ¬ Step c c' := fun hs => by
  obtain ⟨i, h0, _⟩ := Step.base hs
  exact step_stuck h i (Step0.app h0)

/-- Runs are `Step` derivations. -/
theorem run_sound (fuel : Nat) (c : SortGeneratedTopCell) :
    StepsN Step (run fuel c).steps c (run fuel c).config := by
  have := (KPrelude.run_sound (step := step) (R := Step) (I := fun _ => True)
    (fun _ _ _ h => step_sound h) (fun _ _ _ _ => trivial) fuel c 0 trivial).1
  simpa [run] using this

