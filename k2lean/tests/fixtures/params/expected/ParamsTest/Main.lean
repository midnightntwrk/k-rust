import ParamsTest.Goldens
import ParamsTest.Traces
import ParamsTest.Axioms

/-! Generated by k2lean; do not edit. `lake test`. -/

namespace ParamsTest

variable [Params.Hooks]

open Params KPrelude

def goldenFuel : Nat := 10000000

def statusStr : Status → String
  | .final => "final"
  | .stuck => "stuck (no rule applies)"
  | .undefined r => s!"undefined step (rule {r})"
  | .outOfFuel => "out of fuel"

/-- `none` on success, else an explanation. -/
def check (g : Golden) : Option String :=
  let r := run goldenFuel g.init
  match g.expected with
  | .config c =>
    match r.status with
    | .stuck =>
      if r.config = c then none
      else some s!"final configuration differs after {r.steps} steps\n    Lean: {toK_SortGeneratedTopCell r.config}\n    K:    {toK_SortGeneratedTopCell c}"
    | st => some s!"K ended in a final configuration, the run ended {statusStr st} after {r.steps} steps"
  | .failure msg =>
    match r.status with
    | .undefined _ => none
    | st => some s!"K failed ({msg}), the run ended {statusStr st}"

def describe (g : Golden) : String :=
  let r := run goldenFuel g.init
  s!"{r.steps} steps, {statusStr r.status}"

/-- Compare `run i` with the recorded configuration after `i` steps. -/
def checkTrace (init : SortGeneratedTopCell) (states : List (Nat × SortGeneratedTopCell)) : List String :=
  states.filterMap fun (i, s) =>
    let r := run i init
    if r.config = s then none
    else some s!"after {i} steps: Lean ({r.steps} steps) {toK_SortGeneratedTopCell r.config}, recorded {toK_SortGeneratedTopCell s}"

def tomlStr (s : String) : String := "\"" ++ (s.replace "\\" "\\\\").replace "\"" "\\\"" ++ "\""

/-- `--toml FILE` also writes one `[[case]]` table per golden case. -/
def testMain (args : List String) : IO UInt32 := do
  let mut failed := 0
  let mut passed := 0
  let mut toml := ""
  for g in goldens do
    let r := run goldenFuel g.init
    let res := check g
    toml := toml ++ s!"[[case]]\nname = {tomlStr g.name}\ngroup = {tomlStr g.group}\npass = {res.isNone}\nsteps = {r.steps}\noutcome = {tomlStr (statusStr r.status)}\n\n"
    match res with
    | none =>
      passed := passed + 1
      IO.println s!"PASS {g.group}/{g.name}: {describe g}"
    | some why =>
      failed := failed + 1
      IO.println s!"FAIL {g.group}/{g.name}: {why}"
  match args with
  | ["--toml", path] => IO.FS.writeFile path toml
  | _ => pure ()
  IO.println s!"goldens: {passed}/{goldens.length} pass"
  for (name, engine, states) in traces do
    match goldens.find? (·.name == name) with
    | none => IO.println s!"FAIL trace {name}: no such case"; failed := failed + 1
    | some g =>
      let bad := checkTrace g.init states
      if bad.isEmpty then
        IO.println s!"PASS trace {name} vs {engine}: {states.length} configurations equal (after 0..{(states.getLast?.map (·.1)).getD 0} steps)"
      else
        failed := failed + 1
        IO.println s!"FAIL trace {name} vs {engine}: {bad.head!}"
  if failed == 0 then IO.println "PASS" else IO.println s!"FAIL ({failed})"
  return if failed == 0 then 0 else 1

end ParamsTest

