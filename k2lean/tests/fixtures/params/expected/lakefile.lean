import Lake
open Lake DSL

/-- Generated by k2lean; do not edit. -/
package «Params» where
  leanOptions := #[⟨`autoImplicit, false⟩]
  weakLeanArgs := #["-DmaxErrors=0"]

require KPrelude from "../../prelude"

/-- The generated semantics: terms, functions, rules, adequacy, determinism. -/
@[default_target]
lean_lib Params

/-- Golden cases (`k2lean goldens` writes `ParamsTest/Goldens.lean`) and the axiom guard. -/
lean_lib ParamsTest

/-- `lake test`: run every golden case through `run`. -/
@[test_driver]
lean_exe «params-test» where
  root := `ParamsTest.Main

/-- Named initial configurations (`k2lean configs` writes `ParamsBench/Programs.lean`). -/
lean_lib ParamsBench

/-- `params-run NAME [FUEL]`: run a named configuration, print steps, status, time and the result. -/
lean_exe «params-run» where
  root := `ParamsBench.Main
