def SortMap.lookupR (k : SortKItem) : SortMap → Option SortKItem
  | .nil => none
  | .cons k' v t => match compare k k' with
    | .lt => none
    | .eq => some v
    | .gt => SortMap.lookupR k t
def SortMap.insertR (k v : SortKItem) : SortMap → SortMap
  | .nil => .cons k v .nil
  | .cons k' v' t => match compare k k' with
    | .lt => .cons k v (.cons k' v' t)
    | .eq => .cons k v t
    | .gt => .cons k' v' (SortMap.insertR k v t)
def SortMap.eraseR (k : SortKItem) : SortMap → SortMap
  | .nil => .nil
  | .cons k' v' t => match compare k k' with
    | .lt => .cons k' v' t
    | .eq => t
    | .gt => .cons k' v' (SortMap.eraseR k t)
def SortMap.sortedR : SortMap → Bool
  | .nil => true
  | .cons _ _ .nil => true
  | .cons k₁ _ (.cons k₂ v₂ t) => compare k₁ k₂ == .lt && SortMap.sortedR (.cons k₂ v₂ t)
