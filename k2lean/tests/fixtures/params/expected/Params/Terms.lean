/-! Serialization: injective (`dec_ser`), it induces the order on terms. -/

mutual
def ser : {s : Tag} → Term s → List Tok
  | _, .«b_SortBool» v => ser_SortBool v
  | _, .«b_SortBytes» v => ser_SortBytes v
  | _, .«b_SortInt» v => ser_SortInt v
  | _, .«b_SortKConfigVar» v => ser_SortKConfigVar v
  | _, .«b_SortString» v => ser_SortString v
  | _, @Term.c0 s c  => .c 0 :: .c (idx0 s c) :: []
  | _, @Term.c1 s c a0 => .c 1 :: .c (idx1 s c) :: ser a0
  | _, @Term.c2 s c a0 a1 => .c 2 :: .c (idx2 s c) :: (ser a0 ++ ser a1)
  | _, .«coll_SortList» l => .c 1000 :: serL_SortList l
  | _, .«coll_SortMap» l => .c 1001 :: serL_SortMap l
  | _, .«coll_SortSet» l => .c 1002 :: serL_SortSet l
  | _, Term.inj _ l _ a => .c 999 :: .c l.ctorIdx :: ser a
def serL_SortList : List (Term .«SortKItem») → List Tok
  | [] => [.c 0]
  | k :: t => .c 1 :: (ser k ++ serL_SortList t)
def serL_SortMap : List ((Term .«SortKItem») × (Term .«SortKItem»)) → List Tok
  | [] => [.c 0]
  | (k, v) :: t => .c 1 :: (ser k ++ (ser v ++ serL_SortMap t))
def serL_SortSet : List ((Term .«SortKItem») × Unit) → List Tok
  | [] => [.c 0]
  | (k, ()) :: t => .c 1 :: (ser k ++ serL_SortSet t)
end

/-- An injected value of sort `s` from a decoded leaf value of tag `l`. -/
def decInj (s l : Tag) (r : Option (Term l × List Tok)) : Option (Term s × List Tok) :=
  if hs : hasLeaves s = true then
    if h : leafOK s l = true then r.map (fun p => (Term.inj hs l h p.1, p.2)) else none
  else none

mutual
def dec : Nat → (s : Tag) → List Tok → Option (Term s × List Tok)
  | 0, _, _ => none
  | n + 1, s, .c 0 :: .c i :: t => do let c ← ofIdx0 s i; pure (Term.c0 c, t)
  | n + 1, s, .c 1 :: .c i :: t => do let c ← ofIdx1 s i; let (a0, t) ← dec n (A1_0 s c) t; pure (Term.c1 c a0, t)
  | n + 1, s, .c 2 :: .c i :: t => do let c ← ofIdx2 s i; let (a0, t) ← dec n (A2_0 s c) t; let (a1, t) ← dec n (A2_1 s c) t; pure (Term.c2 c a0 a1, t)
  | n + 1, .«SortList», .c 1000 :: t => do let (l, t) ← decL_SortList n t; pure (.«coll_SortList» l, t)
  | n + 1, .«SortMap», .c 1001 :: t => do let (l, t) ← decL_SortMap n t; pure (.«coll_SortMap» l, t)
  | n + 1, .«SortSet», .c 1002 :: t => do let (l, t) ← decL_SortSet n t; pure (.«coll_SortSet» l, t)
  | n + 1, s, .c 999 :: .c i :: t => decInj s (Tag.ofNat i) (dec n (Tag.ofNat i) t)
  | n + 1, .«SortBool», t => do let (v, t) ← dec_SortBool (n + 1) t; pure (.«b_SortBool» v, t)
  | n + 1, .«SortBytes», t => do let (v, t) ← dec_SortBytes (n + 1) t; pure (.«b_SortBytes» v, t)
  | n + 1, .«SortInt», t => do let (v, t) ← dec_SortInt (n + 1) t; pure (.«b_SortInt» v, t)
  | n + 1, .«SortKConfigVar», t => do let (v, t) ← dec_SortKConfigVar (n + 1) t; pure (.«b_SortKConfigVar» v, t)
  | n + 1, .«SortString», t => do let (v, t) ← dec_SortString (n + 1) t; pure (.«b_SortString» v, t)
  | _, _, _ => none
def decL_SortList : Nat → List Tok → Option (List (Term .«SortKItem») × List Tok)
  | 0, _ => none
  | _ + 1, .c 0 :: t => pure ([], t)
  | n + 1, .c 1 :: t => do let (k, t) ← dec n .«SortKItem» t; let (r, t) ← decL_SortList n t; pure (k :: r, t)
  | _, _ => none
def decL_SortMap : Nat → List Tok → Option (List ((Term .«SortKItem») × (Term .«SortKItem»)) × List Tok)
  | 0, _ => none
  | _ + 1, .c 0 :: t => pure ([], t)
  | n + 1, .c 1 :: t => do let (k, t) ← dec n .«SortKItem» t; let (v, t) ← dec n .«SortKItem» t; let (r, t) ← decL_SortMap n t; pure ((k, v) :: r, t)
  | _, _ => none
def decL_SortSet : Nat → List Tok → Option (List ((Term .«SortKItem») × Unit) × List Tok)
  | 0, _ => none
  | _ + 1, .c 0 :: t => pure ([], t)
  | n + 1, .c 1 :: t => do let (k, t) ← dec n .«SortKItem» t; let (r, t) ← decL_SortSet n t; pure ((k, ()) :: r, t)
  | _, _ => none
end

mutual
theorem dec_ser : ∀ {s : Tag} (a : Term s) (r : List Tok) (n : Nat), (ser a).length ≤ n → dec n s (ser a ++ r) = some (a, r)
  | _, .«b_SortBool» v, r, 0, h => absurd h (by simp [ser, ser_SortBool, KPrelude.BytesHook.ser])
  | _, .«b_SortBool» v, r, n + 1, h => by
    have e := dec_ser_SortBool v r (n + 1) h
    show (dec_SortBool (n + 1) (ser_SortBool v ++ r) >>= fun (p : SortBool × List Tok) => pure (Term.«b_SortBool» p.1, p.2)) = _
    rw [e]; rfl
  | _, .«b_SortBytes» v, r, 0, h => absurd h (by simp [ser, ser_SortBytes, KPrelude.BytesHook.ser])
  | _, .«b_SortBytes» v, r, n + 1, h => by
    have e := dec_ser_SortBytes v r (n + 1) h
    show (dec_SortBytes (n + 1) (ser_SortBytes v ++ r) >>= fun (p : SortBytes × List Tok) => pure (Term.«b_SortBytes» p.1, p.2)) = _
    rw [e]; rfl
  | _, .«b_SortInt» v, r, 0, h => absurd h (by simp [ser, ser_SortInt, KPrelude.BytesHook.ser])
  | _, .«b_SortInt» v, r, n + 1, h => by
    have e := dec_ser_SortInt v r (n + 1) h
    show (dec_SortInt (n + 1) (ser_SortInt v ++ r) >>= fun (p : SortInt × List Tok) => pure (Term.«b_SortInt» p.1, p.2)) = _
    rw [e]; rfl
  | _, .«b_SortKConfigVar» v, r, 0, h => absurd h (by simp [ser, ser_SortKConfigVar, KPrelude.BytesHook.ser])
  | _, .«b_SortKConfigVar» v, r, n + 1, h => by
    have e := dec_ser_SortKConfigVar v r (n + 1) h
    show (dec_SortKConfigVar (n + 1) (ser_SortKConfigVar v ++ r) >>= fun (p : SortKConfigVar × List Tok) => pure (Term.«b_SortKConfigVar» p.1, p.2)) = _
    rw [e]; rfl
  | _, .«b_SortString» v, r, 0, h => absurd h (by simp [ser, ser_SortString, KPrelude.BytesHook.ser])
  | _, .«b_SortString» v, r, n + 1, h => by
    have e := dec_ser_SortString v r (n + 1) h
    show (dec_SortString (n + 1) (ser_SortString v ++ r) >>= fun (p : SortString × List Tok) => pure (Term.«b_SortString» p.1, p.2)) = _
    rw [e]; rfl
  | _, @Term.c0 s c , r, 0, h => absurd h (by simp [ser])
  | _, @Term.c0 s c , r, n + 1, h => by
    simp only [ser, dec, List.cons_append, List.nil_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, ofIdx0_idx0]
  | _, @Term.c1 s c a0, r, 0, h => absurd h (by simp [ser])
  | _, @Term.c1 s c a0, r, n + 1, h => by
    have hl : (ser a0).length ≤ n := by
      have e : (ser (Term.c1 c a0)).length = (ser a0).length + 2 := rfl
      omega
    have h0 := dec_ser a0 (r) n hl
    simp only [ser, dec, List.cons_append, List.nil_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, ofIdx1_idx1, h0]
  | _, @Term.c2 s c a0 a1, r, 0, h => absurd h (by simp [ser])
  | _, @Term.c2 s c a0 a1, r, n + 1, h => by
    have hl : ((ser a0 ++ ser a1)).length ≤ n := by
      have e : (ser (Term.c2 c a0 a1)).length = ((ser a0 ++ ser a1)).length + 2 := rfl
      omega
    have h0 := dec_ser a0 ((ser a1 ++ r)) n (KPrelude.len_left hl)
    have h1 := dec_ser a1 (r) n (KPrelude.len_right hl)
    simp only [ser, dec, List.cons_append, List.nil_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, ofIdx2_idx2, h0, h1]
  | _, Term.inj hs l hl a, r, 0, h => absurd h (by simp [ser])
  | _, Term.inj hs l hl a, r, n + 1, h => by
    have e := dec_ser a r n (by simp only [ser, List.length_cons] at h; omega)
    simp only [ser, dec, List.cons_append]
    rw [Tag.ofNat_ctorIdx, e]
    simp only [decInj, hs, hl, dite_true, Option.map_some]
  | _, .«coll_SortList» l, r, 0, h => absurd h (by simp [ser])
  | _, .«coll_SortList» l, r, n + 1, h => by
    have e := dec_serL_SortList l r n (by simp only [ser, List.length_cons] at h; omega)
    simp only [ser, dec, List.cons_append, List.nil_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, e]
  | _, .«coll_SortMap» l, r, 0, h => absurd h (by simp [ser])
  | _, .«coll_SortMap» l, r, n + 1, h => by
    have e := dec_serL_SortMap l r n (by simp only [ser, List.length_cons] at h; omega)
    simp only [ser, dec, List.cons_append, List.nil_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, e]
  | _, .«coll_SortSet» l, r, 0, h => absurd h (by simp [ser])
  | _, .«coll_SortSet» l, r, n + 1, h => by
    have e := dec_serL_SortSet l r n (by simp only [ser, List.length_cons] at h; omega)
    simp only [ser, dec, List.cons_append, List.nil_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, e]
theorem dec_serL_SortList : ∀ (l : List (Term .«SortKItem»)) (r : List Tok) (n : Nat), (serL_SortList l).length ≤ n → decL_SortList n (serL_SortList l ++ r) = some (l, r)
  | l, r, 0, h => absurd h (by cases l <;> simp [serL_SortList])
  | [], r, n + 1, h => by simp [serL_SortList, decL_SortList]
  | k :: t, r, n + 1, h => by
    have hl : (ser k).length + (serL_SortList t).length ≤ n := by simp only [serL_SortList, List.length_cons, List.length_append] at h; omega
    have h0 := dec_ser k ((serL_SortList t ++ r)) n (by omega)
    have ht := dec_serL_SortList t r n (by omega)
    simp only [serL_SortList, decL_SortList, List.cons_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, h0, ht]
theorem dec_serL_SortMap : ∀ (l : List ((Term .«SortKItem») × (Term .«SortKItem»))) (r : List Tok) (n : Nat), (serL_SortMap l).length ≤ n → decL_SortMap n (serL_SortMap l ++ r) = some (l, r)
  | l, r, 0, h => absurd h (by cases l <;> simp [serL_SortMap])
  | [], r, n + 1, h => by simp [serL_SortMap, decL_SortMap]
  | (k, v) :: t, r, n + 1, h => by
    have hl : (ser k).length + (ser v).length + (serL_SortMap t).length ≤ n := by simp only [serL_SortMap, List.length_cons, List.length_append] at h; omega
    have h0 := dec_ser k ((ser v ++ (serL_SortMap t ++ r))) n (by omega)
    have h1 := dec_ser v ((serL_SortMap t ++ r)) n (by omega)
    have ht := dec_serL_SortMap t r n (by omega)
    simp only [serL_SortMap, decL_SortMap, List.cons_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, h0, h1, ht]
theorem dec_serL_SortSet : ∀ (l : List ((Term .«SortKItem») × Unit)) (r : List Tok) (n : Nat), (serL_SortSet l).length ≤ n → decL_SortSet n (serL_SortSet l ++ r) = some (l, r)
  | l, r, 0, h => absurd h (by cases l <;> simp [serL_SortSet])
  | [], r, n + 1, h => by simp [serL_SortSet, decL_SortSet]
  | (k, ()) :: t, r, n + 1, h => by
    have hl : (ser k).length + (serL_SortSet t).length ≤ n := by simp only [serL_SortSet, List.length_cons, List.length_append] at h; omega
    have h0 := dec_ser k ((serL_SortSet t ++ r)) n (by omega)
    have ht := dec_serL_SortSet t r n (by omega)
    simp only [serL_SortSet, decL_SortSet, List.cons_append, List.append_assoc, Option.bind_eq_bind, Option.bind_some, Option.pure_def, bind, pure, h0, ht]
end

theorem ser_inj {s : Tag} (a b : Term s) (h : ser a = ser b) : a = b := by
  have ha := dec_ser a [] (ser a).length (Nat.le_refl _)
  have hb := dec_ser b [] (ser a).length (by simp [h])
  rw [h] at ha
  simp_all

theorem compare_append_ser_Term {s : Tag} (a b : Term s) (r r' : List Tok) :
    compare (ser a ++ r) (ser b ++ r') = (compare (ser a) (ser b)).then (compare r r') :=
  compare_append_ser (@ser s) (fun n t => dec n s t) (fun a r n h => dec_ser a r n h) a b r r'

/-! Equality by structural recursion (`Term.beq`): the kernel decides `a = b` on closed terms
without unfolding a definition by well-founded recursion; builtin values compare by `LeafEq`. -/

instance : LeafEq SortKConfigVar := LeafEq.ofVal SortKConfigVar.val (fun a b h => by cases a; cases b; cases h; rfl)

theorem idx0_inj {s : Tag} {c d : C0 s} (h : idx0 s c = idx0 s d) : c = d := by
  have e := ofIdx0_idx0 s c
  rw [h, ofIdx0_idx0] at e
  exact (Option.some.inj e).symm
theorem idx1_inj {s : Tag} {c d : C1 s} (h : idx1 s c = idx1 s d) : c = d := by
  have e := ofIdx1_idx1 s c
  rw [h, ofIdx1_idx1] at e
  exact (Option.some.inj e).symm
theorem idx2_inj {s : Tag} {c d : C2 s} (h : idx2 s c = idx2 s d) : c = d := by
  have e := ofIdx2_idx2 s c
  rw [h, ofIdx2_idx2] at e
  exact (Option.some.inj e).symm

mutual
def Term.beq : {s t : Tag} → Term s → Term t → Bool
  | _, _, .«b_SortBool» v, b => match b with | .«b_SortBool» w => LeafEq.beq v w | _ => false
  | _, _, .«b_SortBytes» v, b => match b with | .«b_SortBytes» w => LeafEq.beq v w | _ => false
  | _, _, .«b_SortInt» v, b => match b with | .«b_SortInt» w => LeafEq.beq v w | _ => false
  | _, _, .«b_SortKConfigVar» v, b => match b with | .«b_SortKConfigVar» w => LeafEq.beq v w | _ => false
  | _, _, .«b_SortString» v, b => match b with | .«b_SortString» w => LeafEq.beq v w | _ => false
  | _, _, @Term.c0 s c, b => match b with
    | @Term.c0 t d => decide (s = t) && (idx0 s c == idx0 t d)
    | _ => false
  | _, _, @Term.c1 s c a0, b => match b with
    | @Term.c1 t d b0 => decide (s = t) && (idx1 s c == idx1 t d && (Term.beq a0 b0))
    | _ => false
  | _, _, @Term.c2 s c a0 a1, b => match b with
    | @Term.c2 t d b0 b1 => decide (s = t) && (idx2 s c == idx2 t d && (Term.beq a0 b0 && (Term.beq a1 b1)))
    | _ => false
  | _, _, .«coll_SortList» l, b => match b with | .«coll_SortList» l' => beqL_SortList l l' | _ => false
  | _, _, .«coll_SortMap» l, b => match b with | .«coll_SortMap» l' => beqL_SortMap l l' | _ => false
  | _, _, .«coll_SortSet» l, b => match b with | .«coll_SortSet» l' => beqL_SortSet l l' | _ => false
  | _, _, @Term.inj s _ l _ a, b => match b with
    | @Term.inj t _ l' _ b' => decide (s = t) && (decide (l = l') && (Term.beq a b'))
    | _ => false
termination_by structural _ _ a _ => a
def beqL_SortList : List (Term .«SortKItem») → List (Term .«SortKItem») → Bool
  | [], [] => true
  | k :: t, k' :: t' => Term.beq k k' && (beqL_SortList t t')
  | _, _ => false
termination_by structural l _ => l
def beqL_SortMap : List ((Term .«SortKItem») × (Term .«SortKItem»)) → List ((Term .«SortKItem») × (Term .«SortKItem»)) → Bool
  | [], [] => true
  | (k, v) :: t, (k', v') :: t' => Term.beq k k' && (Term.beq v v' && (beqL_SortMap t t'))
  | _, _ => false
termination_by structural l _ => l
def beqL_SortSet : List ((Term .«SortKItem») × Unit) → List ((Term .«SortKItem») × Unit) → Bool
  | [], [] => true
  | (k, ()) :: t, (k', ()) :: t' => Term.beq k k' && (beqL_SortSet t t')
  | _, _ => false
termination_by structural l _ => l
end

mutual
theorem Term.eq_of_beq : ∀ {s t : Tag} (a : Term s) (b : Term t), Term.beq a b = true → s = t ∧ HEq a b
  | _, _, .«b_SortBool» v, b, h => by
    cases b <;> first | exact absurd h Bool.false_ne_true | skip
    rename_i w
    obtain rfl : v = w := LeafEq.eq_of_beq h
    exact ⟨rfl, HEq.rfl⟩
  | _, _, .«b_SortBytes» v, b, h => by
    cases b <;> first | exact absurd h Bool.false_ne_true | skip
    rename_i w
    obtain rfl : v = w := LeafEq.eq_of_beq h
    exact ⟨rfl, HEq.rfl⟩
  | _, _, .«b_SortInt» v, b, h => by
    cases b <;> first | exact absurd h Bool.false_ne_true | skip
    rename_i w
    obtain rfl : v = w := LeafEq.eq_of_beq h
    exact ⟨rfl, HEq.rfl⟩
  | _, _, .«b_SortKConfigVar» v, b, h => by
    cases b <;> first | exact absurd h Bool.false_ne_true | skip
    rename_i w
    obtain rfl : v = w := LeafEq.eq_of_beq h
    exact ⟨rfl, HEq.rfl⟩
  | _, _, .«b_SortString» v, b, h => by
    cases b <;> first | exact absurd h Bool.false_ne_true | skip
    rename_i w
    obtain rfl : v = w := LeafEq.eq_of_beq h
    exact ⟨rfl, HEq.rfl⟩
  | _, _, @Term.c0 s c, b, h => by
    cases b <;> first | exact absurd h Bool.false_ne_true | skip
    rename_i t d
    have h' : (decide (s = t) && (idx0 s c == idx0 t d)) = true := h
    simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h'
    obtain ⟨rfl, hi⟩ := h'
    obtain rfl := idx0_inj hi
    exact ⟨rfl, HEq.rfl⟩
  | _, _, @Term.c1 s c a0, b, h => by
    cases b <;> first | exact absurd h Bool.false_ne_true | skip
    rename_i t d b0
    have h' : (decide (s = t) && (idx1 s c == idx1 t d && (Term.beq a0 b0))) = true := h
    simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h'
    obtain ⟨rfl, hi, h0⟩ := h'
    obtain rfl := idx1_inj hi
    obtain rfl := eq_of_heq (Term.eq_of_beq a0 b0 h0).2
    exact ⟨rfl, HEq.rfl⟩
  | _, _, @Term.c2 s c a0 a1, b, h => by
    cases b <;> first | exact absurd h Bool.false_ne_true | skip
    rename_i t d b0 b1
    have h' : (decide (s = t) && (idx2 s c == idx2 t d && (Term.beq a0 b0 && (Term.beq a1 b1)))) = true := h
    simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h'
    obtain ⟨rfl, hi, h0, h1⟩ := h'
    obtain rfl := idx2_inj hi
    obtain rfl := eq_of_heq (Term.eq_of_beq a0 b0 h0).2
    obtain rfl := eq_of_heq (Term.eq_of_beq a1 b1 h1).2
    exact ⟨rfl, HEq.rfl⟩
  | _, _, .«coll_SortList» l, b, h => by
    cases b <;> first | exact absurd h Bool.false_ne_true | skip
    rename_i l'
    obtain rfl := beqL_SortList_sound l l' h
    exact ⟨rfl, HEq.rfl⟩
  | _, _, .«coll_SortMap» l, b, h => by
    cases b <;> first | exact absurd h Bool.false_ne_true | skip
    rename_i l'
    obtain rfl := beqL_SortMap_sound l l' h
    exact ⟨rfl, HEq.rfl⟩
  | _, _, .«coll_SortSet» l, b, h => by
    cases b <;> first | exact absurd h Bool.false_ne_true | skip
    rename_i l'
    obtain rfl := beqL_SortSet_sound l l' h
    exact ⟨rfl, HEq.rfl⟩
  | _, _, @Term.inj s hs l hl a, b, h => by
    cases b <;> first | exact absurd h Bool.false_ne_true | skip
    rename_i t l' b' _ _
    have h' : (decide (s = t) && (decide (l = l') && (Term.beq a b'))) = true := h
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h'
    obtain ⟨rfl, rfl, h0⟩ := h'
    obtain rfl := eq_of_heq (Term.eq_of_beq a b' h0).2
    exact ⟨rfl, HEq.rfl⟩
termination_by structural _ _ a _ _ => a
theorem beqL_SortList_sound : ∀ l l' : List (Term .«SortKItem»), beqL_SortList l l' = true → l = l'
  | [], [], _ => rfl
  | [], _ :: _, h => absurd h Bool.false_ne_true
  | _ :: _, [], h => absurd h Bool.false_ne_true
  | k :: t, k' :: t', h => by
    have h' : (Term.beq k k' && (beqL_SortList t t')) = true := h
    simp only [Bool.and_eq_true] at h'
    obtain ⟨hk, ht⟩ := h'
    obtain rfl := eq_of_heq (Term.eq_of_beq k k' hk).2
    obtain rfl := beqL_SortList_sound t t' ht
    rfl
termination_by structural l _ _ => l
theorem beqL_SortMap_sound : ∀ l l' : List ((Term .«SortKItem») × (Term .«SortKItem»)), beqL_SortMap l l' = true → l = l'
  | [], [], _ => rfl
  | [], _ :: _, h => absurd h Bool.false_ne_true
  | _ :: _, [], h => absurd h Bool.false_ne_true
  | (k, v) :: t, (k', v') :: t', h => by
    have h' : (Term.beq k k' && (Term.beq v v' && (beqL_SortMap t t'))) = true := h
    simp only [Bool.and_eq_true] at h'
    obtain ⟨hk, hv, ht⟩ := h'
    obtain rfl := eq_of_heq (Term.eq_of_beq k k' hk).2
    obtain rfl := eq_of_heq (Term.eq_of_beq v v' hv).2
    obtain rfl := beqL_SortMap_sound t t' ht
    rfl
termination_by structural l _ _ => l
theorem beqL_SortSet_sound : ∀ l l' : List ((Term .«SortKItem») × Unit), beqL_SortSet l l' = true → l = l'
  | [], [], _ => rfl
  | [], _ :: _, h => absurd h Bool.false_ne_true
  | _ :: _, [], h => absurd h Bool.false_ne_true
  | (k, ()) :: t, (k', ()) :: t', h => by
    have h' : (Term.beq k k' && (beqL_SortSet t t')) = true := h
    simp only [Bool.and_eq_true] at h'
    obtain ⟨hk, ht⟩ := h'
    obtain rfl := eq_of_heq (Term.eq_of_beq k k' hk).2
    obtain rfl := beqL_SortSet_sound t t' ht
    rfl
termination_by structural l _ _ => l
end

mutual
theorem Term.beq_self : ∀ {s : Tag} (a : Term s), Term.beq a a = true
  | _, .«b_SortBool» v => LeafEq.beq_self v
  | _, .«b_SortBytes» v => LeafEq.beq_self v
  | _, .«b_SortInt» v => LeafEq.beq_self v
  | _, .«b_SortKConfigVar» v => LeafEq.beq_self v
  | _, .«b_SortString» v => LeafEq.beq_self v
  | _, @Term.c0 s c => by
    show (decide (s = s) && (idx0 s c == idx0 s c)) = true
    simp
  | _, @Term.c1 s c a0 => by
    show (decide (s = s) && (idx1 s c == idx1 s c && (Term.beq a0 a0))) = true
    rw [Term.beq_self a0]; simp
  | _, @Term.c2 s c a0 a1 => by
    show (decide (s = s) && (idx2 s c == idx2 s c && (Term.beq a0 a0 && (Term.beq a1 a1)))) = true
    rw [Term.beq_self a0, Term.beq_self a1]; simp
  | _, .«coll_SortList» l => beqL_SortList_self l
  | _, .«coll_SortMap» l => beqL_SortMap_self l
  | _, .«coll_SortSet» l => beqL_SortSet_self l
  | _, @Term.inj s _ l _ a => by
    show (decide (s = s) && (decide (l = l) && (Term.beq a a))) = true
    rw [Term.beq_self a]; simp
termination_by structural _ a => a
theorem beqL_SortList_self : ∀ l : List (Term .«SortKItem»), beqL_SortList l l = true
  | [] => rfl
  | k :: t => by
    show (Term.beq k k && (beqL_SortList t t)) = true
    rw [Term.beq_self k, beqL_SortList_self t]; rfl
termination_by structural l => l
theorem beqL_SortMap_self : ∀ l : List ((Term .«SortKItem») × (Term .«SortKItem»)), beqL_SortMap l l = true
  | [] => rfl
  | (k, v) :: t => by
    show (Term.beq k k && (Term.beq v v && (beqL_SortMap t t))) = true
    rw [Term.beq_self k, Term.beq_self v, beqL_SortMap_self t]; rfl
termination_by structural l => l
theorem beqL_SortSet_self : ∀ l : List ((Term .«SortKItem») × Unit), beqL_SortSet l l = true
  | [] => rfl
  | (k, ()) :: t => by
    show (Term.beq k k && (beqL_SortSet t t)) = true
    rw [Term.beq_self k, beqL_SortSet_self t]; rfl
termination_by structural l => l
end

instance (s : Tag) : DecidableEq (Term s) := fun a b =>
  if h : Term.beq a b = true then isTrue (eq_of_heq (Term.eq_of_beq a b h).2)
  else isFalse (fun e => h (e ▸ Term.beq_self a))

