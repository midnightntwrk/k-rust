@[reducible] def inj_Bool_KItem (x : SortBool) : SortKItem := SortKItem.inj_Bool x
def proj_KItem_Bool : SortKItem → Option SortBool
  | .inj_Bool x => some x
  | _ => none
@[simp] theorem proj_inj_KItem_Bool (x : SortBool) : proj_KItem_Bool (inj_Bool_KItem x) = some x := rfl
theorem inj_proj_KItem_Bool {y : SortKItem} {x : SortBool} (h : proj_KItem_Bool y = some x) : inj_Bool_KItem x = y := by
  cases y <;> simp [proj_KItem_Bool] at h <;> (try subst h) <;> rfl
theorem proj_eq_some_KItem_Bool {y : SortKItem} {x : SortBool} : proj_KItem_Bool y = some x ↔ y = inj_Bool_KItem x :=
  ⟨fun h => (inj_proj_KItem_Bool h).symm, fun h => by subst h; exact proj_inj_KItem_Bool x⟩

