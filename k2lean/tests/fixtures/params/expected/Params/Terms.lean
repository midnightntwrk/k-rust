@[reducible] def inj_Bool_KItem (x : SortBool) : SortKItem := SortKItem.inj_Bool x
def proj_KItem_Bool (y : SortKItem) : Option SortBool :=
  match y with
  | Term.inj _ l _ x => if h : l = .«SortBool» then some (Term.«v_SortBool» (h ▸ x : Term .«SortBool»)) else none
  | _ => none
@[simp] theorem proj_inj_KItem_Bool (x : SortBool) : proj_KItem_Bool (inj_Bool_KItem x) = some x := rfl
theorem inj_proj_KItem_Bool {y : SortKItem} {x : SortBool} (h : proj_KItem_Bool y = some x) : inj_Bool_KItem x = y :=
  match y, h with
  | Term.inj _ l hl z, h => by
    dsimp only [proj_KItem_Bool] at h
    split at h <;> simp at h <;> subst_vars <;> exact congrArg (Term.inj _ _ _) (Term.«bv_SortBool» z)
theorem proj_eq_some_KItem_Bool {y : SortKItem} {x : SortBool} : proj_KItem_Bool y = some x ↔ y = inj_Bool_KItem x :=
  ⟨fun h => (inj_proj_KItem_Bool h).symm, fun h => by subst h; exact proj_inj_KItem_Bool x⟩

