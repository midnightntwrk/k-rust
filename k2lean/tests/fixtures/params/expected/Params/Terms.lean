  | .«SortKCellOpt.Own» => SortKCellOpt.Own.C0.ctorIdx
  | .«SortOutCellOpt.Own» => SortOutCellOpt.Own.C0.ctorIdx
  | .«SortSignedness» => SortSignedness.C0.ctorIdx
  | .«SortTCellOpt.Own» => SortTCellOpt.Own.C0.ctorIdx
  | _ => fun _ => 0
def ofIdx0 : (s : Tag) → Nat → Option (C0 s)
  | .«SortEndianness» => fun n => if n < 2 then some (SortEndianness.C0.ofNat n) else none
  | .«SortGeneratedCounterCellOpt.Own» => fun n => if n < 1 then some (SortGeneratedCounterCellOpt.Own.C0.ofNat n) else none
  | .«SortK» => fun n => if n < 1 then some (SortK.C0.ofNat n) else none
