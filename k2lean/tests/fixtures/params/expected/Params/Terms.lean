theorem inj_proj_KItem_TCellOpt {y : SortKItem} {x : SortTCellOpt} (h : proj_KItem_TCellOpt y = some x) : inj_TCellOpt_KItem x = y := by
  cases y <;> simp [proj_KItem_TCellOpt] at h <;> (try subst h) <;> rfl
theorem proj_eq_some_KItem_TCellOpt {y : SortKItem} {x : SortTCellOpt} : proj_KItem_TCellOpt y = some x ↔ y = inj_TCellOpt_KItem x :=
  ⟨fun h => (inj_proj_KItem_TCellOpt h).symm, fun h => by subst h; exact proj_inj_KItem_TCellOpt x⟩

/-! Printing (for test reports), in a KORE-like notation with K labels. -/

mutual
def toK_SortEndianness : SortEndianness → String
  | .bigEndianBytes  => "bigEndianBytes"
  | .littleEndianBytes  => "littleEndianBytes"
def toK_SortGeneratedCounterCell : SortGeneratedCounterCell → String
  | .«<generatedCounter>» a0 => "<generatedCounter>" ++ "(" ++ toK_SortInt a0 ++ ")"
def toK_SortGeneratedCounterCellOpt : SortGeneratedCounterCellOpt → String
  | .inj_GeneratedCounterCell a0 => toK_SortGeneratedCounterCell a0
  | .inj_GeneratedCounterCellOpt a0 => toK_SortGeneratedCounterCellOpt_Own a0
def toK_SortGeneratedCounterCellOpt_Own : SortGeneratedCounterCellOpt.Own → String
  | .noGeneratedCounterCell  => "noGeneratedCounterCell"
def toK_SortGeneratedTopCell : SortGeneratedTopCell → String
  | .«<generatedTop>» a0 a1 => "<generatedTop>" ++ "(" ++ toK_SortTCell a0 ++ ", " ++ toK_SortGeneratedCounterCell a1 ++ ")"
def toK_SortGeneratedTopCellFragment : SortGeneratedTopCellFragment → String
  | .«<generatedTop>-fragment» a0 a1 => "<generatedTop>-fragment" ++ "(" ++ toK_SortTCellOpt a0 ++ ", " ++ toK_SortGeneratedCounterCellOpt a1 ++ ")"
def toK_SortK : SortK → String
  | .dotk  => ".K"
  | .kseq a0 a1 => toK_SortKItem a0 ++ " ~> " ++ toK_SortK a1
def toK_SortKCell : SortKCell → String
  | .«<k>» a0 => "<k>" ++ "(" ++ toK_SortK a0 ++ ")"
def toK_SortKCellOpt : SortKCellOpt → String
  | .inj_KCell a0 => toK_SortKCell a0
  | .inj_KCellOpt a0 => toK_SortKCellOpt_Own a0
def toK_SortKCellOpt_Own : SortKCellOpt.Own → String
  | .noKCell  => "noKCell"
def toK_SortKItem : SortKItem → String
  | .inj_Bool a0 => toK_SortBool a0
  | .inj_Bytes a0 => toK_SortBytes a0
  | .inj_Endianness a0 => toK_SortEndianness a0
  | .inj_GeneratedCounterCell a0 => toK_SortGeneratedCounterCell a0
  | .inj_GeneratedCounterCellOpt a0 => toK_SortGeneratedCounterCellOpt_Own a0
  | .inj_GeneratedTopCell a0 => toK_SortGeneratedTopCell a0
  | .inj_GeneratedTopCellFragment a0 => toK_SortGeneratedTopCellFragment a0
  | .inj_Int a0 => toK_SortInt a0
  | .inj_KCell a0 => toK_SortKCell a0
  | .inj_KCellOpt a0 => toK_SortKCellOpt_Own a0
  | .inj_KConfigVar a0 => toK_SortKConfigVar a0
  | .inj_KItem a0 => toK_SortKItem_Own a0
  | .inj_List a0 => toK_SortList a0
  | .inj_Map a0 => toK_SortMap a0
  | .inj_OutCell a0 => toK_SortOutCell a0
  | .inj_OutCellOpt a0 => toK_SortOutCellOpt_Own a0
  | .inj_Set a0 => toK_SortSet a0
  | .inj_Signedness a0 => toK_SortSignedness a0
  | .inj_Stmt a0 => toK_SortStmt a0
  | .inj_String a0 => toK_SortString a0
  | .inj_TCell a0 => toK_SortTCell a0
  | .inj_TCellFragment a0 => toK_SortTCellFragment a0
  | .inj_TCellOpt a0 => toK_SortTCellOpt_Own a0
def toK_SortKItem_Own : SortKItem.Own → String
  | .«#KConfigValue» a0 => "#KConfigValue" ++ "(" ++ toK_SortK a0 ++ ")"
def toK_SortList : SortList → String
  | .nil  => ".List"
  | .cons a0 a1 => "ListItem(" ++ toK_SortKItem a0 ++ ") " ++ toK_SortList a1
def toK_SortMap : SortMap → String
  | .nil  => ".Map"
  | .cons a0 a1 a2 => toK_SortKItem a0 ++ " |-> " ++ toK_SortKItem a1 ++ " " ++ toK_SortMap a2
def toK_SortOutCell : SortOutCell → String
  | .«<out>» a0 => "<out>" ++ "(" ++ toK_SortInt a0 ++ ")"
def toK_SortOutCellOpt : SortOutCellOpt → String
  | .inj_OutCell a0 => toK_SortOutCell a0
  | .inj_OutCellOpt a0 => toK_SortOutCellOpt_Own a0
def toK_SortOutCellOpt_Own : SortOutCellOpt.Own → String
  | .noOutCell  => "noOutCell"
def toK_SortSet : SortSet → String
  | .nil  => ".Set"
  | .cons a0 a1 => "SetItem(" ++ toK_SortKItem a0 ++ ") " ++ toK_SortSet a1
def toK_SortSignedness : SortSignedness → String
  | .signedBytes  => "signedBytes"
  | .unsignedBytes  => "unsignedBytes"
def toK_SortStmt : SortStmt → String
  | .hash_ a0 => "hash__PARAMS-SYNTAX_Stmt_Bytes" ++ "(" ++ toK_SortBytes a0 ++ ")"
  | .roundtrip_ a0 => "roundtrip__PARAMS-SYNTAX_Stmt_Int" ++ "(" ++ toK_SortInt a0 ++ ")"
def toK_SortTCell : SortTCell → String
  | .«<T>» a0 a1 => "<T>" ++ "(" ++ toK_SortKCell a0 ++ ", " ++ toK_SortOutCell a1 ++ ")"
def toK_SortTCellFragment : SortTCellFragment → String
  | .«<T>-fragment» a0 a1 => "<T>-fragment" ++ "(" ++ toK_SortKCellOpt a0 ++ ", " ++ toK_SortOutCellOpt a1 ++ ")"
def toK_SortTCellOpt : SortTCellOpt → String
  | .inj_TCell a0 => toK_SortTCell a0
  | .inj_TCellOpt a0 => toK_SortTCellOpt_Own a0
def toK_SortTCellOpt_Own : SortTCellOpt.Own → String
  | .noTCell  => "noTCell"
end

end Params
