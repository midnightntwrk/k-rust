/-! Printing (for test reports), in a KORE-like notation with K labels. -/

def SortB.L0 : SortB.C0 → String
  | .ff => "ff_PEANO_B"
  | .tt => "tt_PEANO_B"
def SortGeneratedCounterCellOpt.Own.L0 : SortGeneratedCounterCellOpt.Own.C0 → String
  | .noGeneratedCounterCell => "noGeneratedCounterCell"
def SortK.L0 : SortK.C0 → String
  | .dotk => ".K"
def SortKCellOpt.Own.L0 : SortKCellOpt.Own.C0 → String
  | .noKCell => "noKCell"
def SortNat.L0 : SortNat.C0 → String
  | .z => "z_PEANO-SYNTAX_Nat"
def lbl0 : (s : Tag) → C0 s → String
  | .«SortB» => SortB.L0
  | .«SortGeneratedCounterCellOpt.Own» => SortGeneratedCounterCellOpt.Own.L0
  | .«SortK» => SortK.L0
  | .«SortKCellOpt.Own» => SortKCellOpt.Own.L0
  | .«SortNat» => SortNat.L0
  | _ => fun _ => ""
def SortGeneratedCounterCell.L1 : SortGeneratedCounterCell.C1 → String
  | .«<generatedCounter>» => "<generatedCounter>"
def SortKCell.L1 : SortKCell.C1 → String
  | .«<k>» => "<k>"
def SortKItem.Own.L1 : SortKItem.Own.C1 → String
  | .«#KConfigValue» => "#KConfigValue"
def SortNat.L1 : SortNat.C1 → String
  | .«s(_)» => "s(_)_PEANO-SYNTAX_Nat_Nat"
def SortPgm.L1 : SortPgm.C1 → String
  | .«done(_)» => "done(_)_PEANO-SYNTAX_Pgm_Nat"
  | .«run(_)» => "run(_)_PEANO-SYNTAX_Pgm_Nat"
def lbl1 : (s : Tag) → C1 s → String
  | .«SortGeneratedCounterCell» => SortGeneratedCounterCell.L1
  | .«SortKCell» => SortKCell.L1
  | .«SortKItem.Own» => SortKItem.Own.L1
  | .«SortNat» => SortNat.L1
  | .«SortPgm» => SortPgm.L1
  | _ => fun _ => ""
def SortGeneratedTopCell.L2 : SortGeneratedTopCell.C2 → String
  | .«<generatedTop>» => "<generatedTop>"
def SortGeneratedTopCellFragment.L2 : SortGeneratedTopCellFragment.C2 → String
  | .«<generatedTop>-fragment» => "<generatedTop>-fragment"
def SortK.L2 : SortK.C2 → String
  | .kseq => "~>"
def lbl2 : (s : Tag) → C2 s → String
  | .«SortGeneratedTopCell» => SortGeneratedTopCell.L2
  | .«SortGeneratedTopCellFragment» => SortGeneratedTopCellFragment.L2
  | .«SortK» => SortK.L2
  | _ => fun _ => ""
mutual
def toK : {s : Tag} → Term s → String
  | _, .«b_SortBool» v => toK_SortBool v
  | _, .«b_SortInt» v => toK_SortInt v
  | _, .«b_SortKConfigVar» v => toK_SortKConfigVar v
  | _, @Term.c0 s c  => lbl0 s c
  | _, @Term.c1 s c a0 => let l := lbl1 s c; if l = "" then toK a0 else l ++ "(" ++ toK a0 ++ ")"
  | _, @Term.c2 s c a0 a1 => let l := lbl2 s c; if l = "~>" then toK a0 ++ " ~> " ++ toK a1 else l ++ "(" ++ toK a0 ++ ", " ++ toK a1 ++ ")"
  | _, .«coll_SortList» l => toKL_SortList l
  | _, .«coll_SortMap» l => toKL_SortMap l
  | _, .«coll_SortSet» l => toKL_SortSet l
  | _, Term.inj _ _ _ a => toK a
def toKL_SortList : List (Term .«SortKItem») → String
  | [] => ".List"
  | k :: t => "ListItem(" ++ toK k ++ ")" ++ " " ++ toKL_SortList t
def toKL_SortMap : List ((Term .«SortKItem») × (Term .«SortKItem»)) → String
  | [] => ".Map"
  | (k, v) :: t => toK k ++ " |-> " ++ toK v ++ " " ++ toKL_SortMap t
def toKL_SortSet : List ((Term .«SortKItem») × Unit) → String
  | [] => ".Set"
  | (k, ()) :: t => "SetItem(" ++ toK k ++ ")" ++ " " ++ toKL_SortSet t
end

@[reducible] def toK_SortB (x : SortB) : String := toK x
@[reducible] def toK_SortGeneratedCounterCell (x : SortGeneratedCounterCell) : String := toK x
@[reducible] def toK_SortGeneratedCounterCellOpt (x : SortGeneratedCounterCellOpt) : String := toK x
@[reducible] def toK_SortGeneratedCounterCellOpt_Own (x : SortGeneratedCounterCellOpt.Own) : String := toK x
@[reducible] def toK_SortGeneratedTopCell (x : SortGeneratedTopCell) : String := toK x
@[reducible] def toK_SortGeneratedTopCellFragment (x : SortGeneratedTopCellFragment) : String := toK x
@[reducible] def toK_SortK (x : SortK) : String := toK x
@[reducible] def toK_SortKCell (x : SortKCell) : String := toK x
@[reducible] def toK_SortKCellOpt (x : SortKCellOpt) : String := toK x
@[reducible] def toK_SortKCellOpt_Own (x : SortKCellOpt.Own) : String := toK x
@[reducible] def toK_SortKItem (x : SortKItem) : String := toK x
@[reducible] def toK_SortKItem_Own (x : SortKItem.Own) : String := toK x
@[reducible] def toK_SortList (x : SortList) : String := toK x
@[reducible] def toK_SortMap (x : SortMap) : String := toK x
@[reducible] def toK_SortNat (x : SortNat) : String := toK x
@[reducible] def toK_SortPgm (x : SortPgm) : String := toK x
@[reducible] def toK_SortSet (x : SortSet) : String := toK x

/-! Goals print family terms by their K constructors (`KPrelude.Delab`), checked for every
constructor and leaf injection. -/
#k2l_check_delab Peano

end Peano
