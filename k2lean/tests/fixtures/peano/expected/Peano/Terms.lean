@[reducible] def inj_B_KItem (x : SortB) : SortKItem := SortKItem.inj_B x
def proj_KItem_B (y : SortKItem) : Option SortB :=
  match y with
  | Term.inj _ l _ x => if h : l = .«SortB» then some (h ▸ x : Term .«SortB») else none
  | _ => none
@[simp] theorem proj_inj_KItem_B (x : SortB) : proj_KItem_B (inj_B_KItem x) = some x := rfl
theorem inj_proj_KItem_B {y : SortKItem} {x : SortB} (h : proj_KItem_B y = some x) : inj_B_KItem x = y :=
  match y, h with
  | Term.inj _ l hl z, h => by
    dsimp only [proj_KItem_B] at h
    split at h <;> simp at h <;> subst_vars <;> rfl
theorem proj_eq_some_KItem_B {y : SortKItem} {x : SortB} : proj_KItem_B y = some x ↔ y = inj_B_KItem x :=
  ⟨fun h => (inj_proj_KItem_B h).symm, fun h => by subst h; exact proj_inj_KItem_B x⟩

