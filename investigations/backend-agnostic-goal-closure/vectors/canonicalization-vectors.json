{
  "schemaVersion": 1,
  "packageVersion": "backend-agnostic-k-in-k-v1",
  "cases": [
    {
      "id": "object-key-order-is-irrelevant",
      "domain": "k-in-k/conformance-example/v1",
      "values": [
        {
          "z": 3,
          "a": 1,
          "nested": {
            "b": true,
            "a": null
          }
        },
        {
          "nested": {
            "a": null,
            "b": true
          },
          "a": 1,
          "z": 3
        }
      ],
      "expectedCanonicalJson": "{\"a\":1,\"nested\":{\"a\":null,\"b\":true},\"z\":3}",
      "expectedSha256": "db8088b7acdde2ae3335ca8e659dc29a1d7e36cb9b9084421b7e47f5fbd581b4"
    },
    {
      "id": "array-order-is-semantic",
      "domain": "k-in-k/conformance-example/v1",
      "values": [
        [
          "write",
          "load"
        ],
        [
          "load",
          "write"
        ]
      ],
      "expectedEqual": false,
      "expectedSha256": [
        "19242ee7474ce4315786f2ca5b9518c0418952f5875d16a6f2a70ccefd1a5487",
        "340d502c33b5c24e75e3597302ea6ea9a71794a01b102bcca1d936dd0a1441d1"
      ]
    },
    {
      "id": "digest-domains-are-separated",
      "domains": [
        "k-in-k/patch/v1",
        "k-in-k/candidate/v1"
      ],
      "value": {
        "edits": []
      },
      "expectedEqual": false,
      "expectedSha256": [
        "ec5fa7844e9639aa9c79fc6082594599082115bf82ed1b6874065cbf4af636d6",
        "95454bf66a0e55663e49c2356ac80d6dfa44ad5e4b256eef35dc3f5c1ea64f8f"
      ]
    },
    {
      "id": "canonical-edit-order",
      "unorderedEdits": [
        {
          "targetLineage": "bbbb",
          "targetPath": [
            {
              "kind": "field",
              "name": "rhs"
            }
          ],
          "operation": "replace-term",
          "editId": "2222"
        },
        {
          "targetLineage": "aaaa",
          "targetPath": [
            {
              "kind": "field",
              "name": "rhs"
            },
            {
              "kind": "argument",
              "index": 1
            }
          ],
          "operation": "replace-term",
          "editId": "3333"
        },
        {
          "targetLineage": "aaaa",
          "targetPath": [
            {
              "kind": "field",
              "name": "rhs"
            },
            {
              "kind": "argument",
              "index": 0
            }
          ],
          "operation": "replace-term",
          "editId": "1111"
        }
      ],
      "expectedOrder": [
        2,
        1,
        0
      ]
    },
    {
      "id": "unicode-nfc-and-control-escaping",
      "domain": "k-in-k/conformance-example/v1",
      "value": {
        "日本語": "é",
        "control": "line\nquote\"slash\\"
      },
      "expectedCanonicalJson": "{\"control\":\"line\\nquote\\\"slash\\\\\",\"日本語\":\"é\"}",
      "expectedSha256": "f7a846532d6f471ef945d9ce241bff3c52e1c26a801c67b35d80ca8001ca8e76"
    },
    {
      "id": "signed-64-boundaries",
      "valid": [
        -9223372036854775808,
        9223372036854775807
      ],
      "invalidDecimal": [
        "-9223372036854775809",
        "9223372036854775808"
      ]
    },
    {
      "id": "duplicate-keys-rejected",
      "invalidJson": "{\"same\":1,\"same\":2}"
    },
    {
      "id": "non-nfc-rejected",
      "invalidCodePoints": [
        101,
        769
      ]
    },
    {
      "id": "in-memory-portable-domain",
      "acceptedExactTypes": [
        "null",
        "boolean",
        "signed-64-integer",
        "NFC-string",
        "list",
        "string-keyed-dictionary"
      ],
      "reasonCodes": [
        "unsupported-json-type",
        "non-string-object-key",
        "floating-point-forbidden",
        "integer-out-of-range",
        "non-nfc-string",
        "surrogate-code-point",
        "cyclic-json-value"
      ],
      "validationOrder": "preorder-with-object-keys-and-values-in-code-point-order",
      "sharedAcyclicReferences": "accepted-by-value",
      "cycles": "rejected"
    }
  ]
}
