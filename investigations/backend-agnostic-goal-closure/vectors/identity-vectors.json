{
  "schemaVersion": 1,
  "packageVersion": "backend-agnostic-k-in-k-v1",
  "digestDomain": "k-in-k/semantic-lineage/v1",
  "cases": [
    {
      "id": "checkout-relocation-is-invisible",
      "baselineFamilyId": "1111111111111111111111111111111111111111111111111111111111111111",
      "left": {"checkoutRoot": "/workspace/a", "module": "MEMORY", "source": "repo://fixtures/memory.k", "location": [10, 1, 12, 20], "kind": "rule", "label": "store", "body": "store-v1"},
      "right": {"checkoutRoot": "/different/root", "module": "MEMORY", "source": "repo://fixtures/memory.k", "location": [10, 1, 12, 20], "kind": "rule", "label": "store", "body": "store-v1"},
      "expected": {"sameLineage": true, "sameContent": true, "sameBody": true}
    },
    {
      "id": "body-edit-preserves-source-lineage",
      "baselineFamilyId": "1111111111111111111111111111111111111111111111111111111111111111",
      "left": {"module": "MEMORY", "source": "repo://fixtures/memory.k", "location": [10, 1, 12, 20], "kind": "rule", "label": "store", "body": "store-v1"},
      "right": {"module": "MEMORY", "source": "repo://fixtures/memory.k", "location": [10, 1, 12, 20], "kind": "rule", "label": "store", "body": "store-v2"},
      "expected": {"sameLineage": true, "sameContent": false, "sameBody": false, "staleOldContent": true}
    },
    {
      "id": "label-edit-preserves-lineage-not-content",
      "baselineFamilyId": "1111111111111111111111111111111111111111111111111111111111111111",
      "left": {"module": "MEMORY", "source": "repo://fixtures/memory.k", "location": [10, 1, 12, 20], "kind": "rule", "label": "store", "body": "store-v1"},
      "right": {"module": "MEMORY", "source": "repo://fixtures/memory.k", "location": [10, 1, 12, 20], "kind": "rule", "label": "store-renamed", "body": "store-v1"},
      "expected": {"sameLineage": true, "sameContent": false, "sameBody": true}
    },
    {
      "id": "file-move-changes-input-lineage",
      "baselineFamilyId": "1111111111111111111111111111111111111111111111111111111111111111",
      "left": {"module": "MEMORY", "source": "repo://fixtures/memory.k", "location": [10, 1, 12, 20], "kind": "rule", "label": "store", "body": "store-v1"},
      "right": {"module": "MEMORY", "source": "repo://fixtures/moved-memory.k", "location": [10, 1, 12, 20], "kind": "rule", "label": "store", "body": "store-v1"},
      "expected": {"sameLineage": false, "sameContent": false, "sameBody": true, "requiresExplicitCrossFamilyMapping": true}
    },
    {
      "id": "source-range-move-changes-input-lineage",
      "baselineFamilyId": "1111111111111111111111111111111111111111111111111111111111111111",
      "left": {"module": "MEMORY", "source": "repo://fixtures/memory.k", "location": [10, 1, 12, 20], "kind": "rule", "label": null, "occurrenceOrdinal": 0, "body": "store-v1"},
      "right": {"module": "MEMORY", "source": "repo://fixtures/memory.k", "location": [20, 1, 22, 20], "kind": "rule", "label": null, "occurrenceOrdinal": 0, "body": "store-v1"},
      "expected": {"sameLineage": false, "sameBody": true}
    },
    {
      "id": "duplicate-labels-use-source-anchors",
      "baselineFamilyId": "1111111111111111111111111111111111111111111111111111111111111111",
      "left": {"module": "MEMORY", "source": "repo://fixtures/memory.k", "location": [10, 1, 12, 20], "kind": "rule", "label": "step", "body": "store-v1"},
      "right": {"module": "MEMORY", "source": "repo://fixtures/memory.k", "location": [30, 1, 32, 20], "kind": "rule", "label": "step", "body": "load-v1"},
      "expected": {"sameLineage": false, "labelIsNotUniqueIdentity": true}
    },
    {
      "id": "generated-lineage-is-parent-and-role-derived",
      "left": {"transformationId": "2222222222222222222222222222222222222222222222222222222222222222", "parents": ["3333333333333333333333333333333333333333333333333333333333333333"], "anchorIdentity": "3333333333333333333333333333333333333333333333333333333333333333", "role": "observation-update", "ordinal": 0},
      "right": {"transformationId": "2222222222222222222222222222222222222222222222222222222222222222", "parents": ["3333333333333333333333333333333333333333333333333333333333333333"], "anchorIdentity": "3333333333333333333333333333333333333333333333333333333333333333", "role": "observation-update", "ordinal": 0},
      "expected": {"sameLineage": true}
    }
  ]
}
