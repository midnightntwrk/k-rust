{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/side-condition-conformance-table.schema.json",
  "title": "Finite side-condition conformance oracle table v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tableDigest",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "tableDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "bindingsDigest",
        "pathPredicateDigest",
        "result"
      ],
      "properties": {
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "digest"
          ],
          "properties": {
            "role": {
              "const": "pattern-side-condition"
            },
            "digest": {
              "$ref": "common.schema.json#/$defs/digest"
            }
          }
        },
        "bindingsDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "pathPredicateDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "result": {
          "enum": [
            "true",
            "false",
            "unknown"
          ]
        }
      }
    }
  }
}
