{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/terminal-state.schema.json",
  "title": "Portable terminal state over the declared semantic slice v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "terminalStateDigest", "definitionDigest", "value"],
  "properties": {
    "schemaVersion": {"const": 1},
    "terminalStateDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "definitionDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "value": {"$ref": "common.schema.json#/$defs/term"}
  }
}
