{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/empty-search-decision.schema.json",
  "title": "Explicit finite empty-frontier decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decisionId", "attemptKeyDigest", "invocationDigest", "collectionScopeId", "reason"],
  "properties": {
    "schemaVersion": {"const": 1},
    "decisionId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "attemptKeyDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "invocationDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "collectionScopeId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "reason": {"const": "finite-frontier-empty"}
  }
}
