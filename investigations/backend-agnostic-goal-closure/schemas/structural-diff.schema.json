{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/structural-diff.schema.json",
  "title": "Normalized semantic structural diff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "diffId", "baselineDefinitionDigest", "mutantDefinitionDigest", "portableApplication", "nativeIrValidation", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "diffId": {"$ref": "common.schema.json#/$defs/digest"},
    "baselineDefinitionDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "mutantDefinitionDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "portableApplication": {"const": "applied-and-locally-well-formed"},
    "nativeIrValidation": {"const": "rust-proof-pending"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["editId", "operation", "targetLineage", "targetPath", "beforeFingerprint", "afterFingerprint", "affectedProvenance"],
        "properties": {
          "editId": {"$ref": "common.schema.json#/$defs/digest"},
          "operation": {"type": "string", "enum": ["replace-term", "replace-sentence", "delete-sentence", "insert-sentence", "replace-condition", "add-attribute", "remove-attribute", "replace-attribute"]},
          "targetLineage": {"oneOf": [{"$ref": "common.schema.json#/$defs/digest"}, {"type": "null"}]},
          "targetPath": {"$ref": "common.schema.json#/$defs/path"},
          "beforeFingerprint": {"oneOf": [{"$ref": "common.schema.json#/$defs/digest"}, {"type": "null"}]},
          "afterFingerprint": {"oneOf": [{"$ref": "common.schema.json#/$defs/digest"}, {"type": "null"}]},
          "affectedProvenance": {"$ref": "common.schema.json#/$defs/provenance"}
        }
      }
    }
  }
}
