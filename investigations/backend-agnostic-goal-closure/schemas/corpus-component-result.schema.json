{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/corpus-component-result.schema.json",
  "title": "Closed corpus slot component result v1",
  "oneOf": [
    {"$ref": "#/$defs/evaluated"},
    {"$ref": "#/$defs/executionFailure"},
    {"$ref": "#/$defs/patternFailure"},
    {"$ref": "#/$defs/skipped"}
  ],
  "$defs": {
    "typedKey": {
      "type": "object", "additionalProperties": false, "required": ["role", "digest"],
      "properties": {
        "role": {"enum": ["corpus-manifest", "execution-attempt-result", "operation-receipt", "branch-trace-collection", "pattern-result", "pattern-evaluation-result"]},
        "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}
      }
    },
    "manifestKey": {"allOf": [{"$ref": "#/$defs/typedKey"}, {"properties": {"role": {"const": "corpus-manifest"}}}]},
    "executionResultKey": {"allOf": [{"$ref": "#/$defs/typedKey"}, {"properties": {"role": {"const": "execution-attempt-result"}}}]},
    "receiptKey": {"allOf": [{"$ref": "#/$defs/typedKey"}, {"properties": {"role": {"const": "operation-receipt"}}}]},
    "collectionKey": {"allOf": [{"$ref": "#/$defs/typedKey"}, {"properties": {"role": {"const": "branch-trace-collection"}}}]},
    "patternResultKey": {"allOf": [{"$ref": "#/$defs/typedKey"}, {"properties": {"role": {"const": "pattern-result"}}}]},
    "patternEvaluationResultKey": {"allOf": [{"$ref": "#/$defs/typedKey"}, {"properties": {"role": {"const": "pattern-evaluation-result"}}}]},
    "commonProperties": {
      "schemaVersion": {"const": 1},
      "componentResultId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
      "kind": {"enum": ["evaluated", "execution-failure", "pattern-failure", "skipped"]},
      "corpusManifest": {"$ref": "#/$defs/manifestKey"},
      "slotId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
      "testOrdinal": {"type": "integer", "minimum": 0},
      "slotOrdinal": {"type": "integer", "minimum": 0}
    },
    "evaluated": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "componentResultId", "kind", "corpusManifest", "slotId", "testOrdinal", "slotOrdinal", "componentInvocationId", "executionAttemptKey", "executionResult", "executionReceipt", "collection", "patternEvaluationInvocation", "patternResult", "patternEvaluationResult", "patternEvaluationReceipt"],
      "properties": {
        "schemaVersion": {"const": 1}, "componentResultId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}, "kind": {"const": "evaluated"}, "corpusManifest": {"$ref": "#/$defs/manifestKey"}, "slotId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}, "testOrdinal": {"type": "integer", "minimum": 0}, "slotOrdinal": {"type": "integer", "minimum": 0},
        "componentInvocationId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
        "executionAttemptKey": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/cache-semantics-v2.schema.json#/$defs/executionAttemptKey"},
        "executionResult": {"$ref": "#/$defs/executionResultKey"},
        "executionReceipt": {"$ref": "#/$defs/receiptKey"},
        "collection": {"$ref": "#/$defs/collectionKey"},
        "patternEvaluationInvocation": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/operation-invocation-v2.schema.json#/$defs/patternEvaluation"},
        "patternResult": {"$ref": "#/$defs/patternResultKey"},
        "patternEvaluationResult": {"$ref": "#/$defs/patternEvaluationResultKey"},
        "patternEvaluationReceipt": {"$ref": "#/$defs/receiptKey"}
      }
    },
    "executionFailure": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "componentResultId", "kind", "corpusManifest", "slotId", "testOrdinal", "slotOrdinal", "componentInvocationId", "executionAttemptKey", "executionReceipt"],
      "properties": {
        "schemaVersion": {"const": 1}, "componentResultId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}, "kind": {"const": "execution-failure"}, "corpusManifest": {"$ref": "#/$defs/manifestKey"}, "slotId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}, "testOrdinal": {"type": "integer", "minimum": 0}, "slotOrdinal": {"type": "integer", "minimum": 0},
        "componentInvocationId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
        "executionAttemptKey": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/cache-semantics-v2.schema.json#/$defs/executionAttemptKey"},
        "executionReceipt": {"$ref": "#/$defs/receiptKey"}
      }
    },
    "patternFailure": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "componentResultId", "kind", "corpusManifest", "slotId", "testOrdinal", "slotOrdinal", "componentInvocationId", "executionAttemptKey", "executionResult", "executionReceipt", "collection", "patternEvaluationInvocation", "patternEvaluationReceipt"],
      "properties": {
        "schemaVersion": {"const": 1}, "componentResultId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}, "kind": {"const": "pattern-failure"}, "corpusManifest": {"$ref": "#/$defs/manifestKey"}, "slotId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}, "testOrdinal": {"type": "integer", "minimum": 0}, "slotOrdinal": {"type": "integer", "minimum": 0},
        "componentInvocationId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
        "executionAttemptKey": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/cache-semantics-v2.schema.json#/$defs/executionAttemptKey"},
        "executionResult": {"$ref": "#/$defs/executionResultKey"},
        "executionReceipt": {"$ref": "#/$defs/receiptKey"},
        "collection": {"$ref": "#/$defs/collectionKey"},
        "patternEvaluationInvocation": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/operation-invocation-v2.schema.json#/$defs/patternEvaluation"},
        "patternEvaluationReceipt": {"$ref": "#/$defs/receiptKey"}
      }
    },
    "schedulingReason": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "stoppedAfterTestOrdinal"],
      "properties": {"kind": {"const": "stop-after-test-match"}, "stoppedAfterTestOrdinal": {"type": "integer", "minimum": 0}}
    },
    "skipped": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "componentResultId", "kind", "corpusManifest", "slotId", "testOrdinal", "slotOrdinal", "schedulingReason"],
      "properties": {
        "schemaVersion": {"const": 1}, "componentResultId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}, "kind": {"const": "skipped"}, "corpusManifest": {"$ref": "#/$defs/manifestKey"}, "slotId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}, "testOrdinal": {"type": "integer", "minimum": 0}, "slotOrdinal": {"type": "integer", "minimum": 0},
        "schedulingReason": {"$ref": "#/$defs/schedulingReason"}
      }
    }
  }
}
