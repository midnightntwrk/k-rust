{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/pattern-query.schema.json",
  "title": "Self-identified named K-authored pattern query v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patternSource",
    "patternPlan",
    "entryModule",
    "exportedName",
    "queryId"
  ],
  "properties": {
    "patternSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "digest"
      ],
      "properties": {
        "role": {
          "const": "pattern-source"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "patternPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "digest"
      ],
      "properties": {
        "role": {
          "const": "pattern-plan"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "entryModule": {
      "type": "string",
      "minLength": 1
    },
    "exportedName": {
      "type": "string",
      "minLength": 1
    },
    "queryId": {
      "$ref": "common.schema.json#/$defs/digest"
    }
  }
}
