{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/artifact-role-specs.schema.json",
  "title": "Closed artifact role and semantic identity registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "specs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "specs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "contentModel", "mediaType", "schema", "digestDomain", "projection", "selfIdField"],
        "properties": {
          "role": {"$ref": "common.schema.json#/$defs/artifactRole"},
          "contentModel": {"type": "string", "enum": ["canonical-json", "opaque-bytes"]},
          "mediaType": {"type": "string", "enum": ["application/json", "application/octet-stream"]},
          "schema": {"type": ["string", "null"]},
          "digestDomain": {"type": "string", "pattern": "^k-in-k/[a-z0-9-]+/v1$"},
          "projection": {
            "type": "object", "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {"type": "string", "enum": ["opaque-envelope", "complete", "definition-summary", "without-field", "field", "select-fields"]},
              "field": {"type": "string", "minLength": 1},
              "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          },
          "selfIdField": {"type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9]*$"}
        }
      }
    }
  }
}
