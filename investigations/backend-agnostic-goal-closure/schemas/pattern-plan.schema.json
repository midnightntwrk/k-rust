{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/pattern-plan.schema.json",
  "title": "Closed normalized flat DNF pattern plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "patternPlanDigest",
    "eventVocabularyDigest",
    "variables",
    "arms",
    "sideCondition"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "patternPlanDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "eventVocabularyDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "variables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/arm"
      }
    },
    "sideCondition": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sideCondition"
        }
      ]
    }
  },
  "$defs": {
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sort"
      ],
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/binding/properties/name"
        },
        "sort": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "mode",
        "variable"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "enum": [
            "bind",
            "use"
          ]
        },
        "variable": {
          "$ref": "common.schema.json#/$defs/binding/properties/name"
        }
      }
    },
    "atom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constructor",
        "payload"
      ],
      "properties": {
        "constructor": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/payload"
          }
        }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atoms",
        "relations"
      ],
      "properties": {
        "atoms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/atom"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "enum": [
              "next-event",
              "eventually-after"
            ]
          }
        }
      }
    },
    "sideCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "resultSort",
        "inputVariables"
      ],
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "digest"
          ],
          "properties": {
            "role": {
              "const": "pattern-side-condition"
            },
            "digest": {
              "$ref": "common.schema.json#/$defs/digest"
            }
          }
        },
        "resultSort": {
          "const": "Bool"
        },
        "inputVariables": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/binding/properties/name"
          }
        }
      }
    }
  }
}
