{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/transformation.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "operatorId", "operatorVersion", "inputDefinitionDigest", "manifestDigest"],
  "properties": {
    "kind": {"const": "observation-installation"},
    "operatorId": {"$ref": "common.schema.json#/$defs/digest"},
    "operatorVersion": {"const": 1},
    "inputDefinitionDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "manifestDigest": {"$ref": "common.schema.json#/$defs/digest"}
  }
}
