{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/failure-taxonomy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taxonomyId",
    "detailsPolicy",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taxonomyId": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "detailsPolicy": {
      "const": "diagnostic-only"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "consequence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disposition"
          ],
          "properties": {
            "disposition": {
              "enum": [
                "rejected",
                "selection-failed",
                "incomplete-generation",
                "baseline-invalid",
                "baseline-oracle-failed",
                "invalid",
                "timeout",
                "unknown",
                "error",
                "unpublishable-report"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delegation"
          ],
          "properties": {
            "delegation": {
              "enum": [
                "generation-completeness-policy-v1"
              ]
            }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "classification",
        "retryability",
        "placements",
        "evidencePolicy"
      ],
      "properties": {
        "stage": {
          "enum": [
            "input",
            "operator",
            "selection",
            "patch",
            "ir-validation",
            "lowering",
            "backend-validation",
            "execution",
            "observation",
            "pattern",
            "oracle",
            "infrastructure",
            "report"
          ]
        },
        "classification": {
          "enum": [
            "malformed",
            "unsupported-version",
            "missing-artifact",
            "digest-mismatch",
            "malformed-operator",
            "unsupported-phase",
            "unsupported-sentence-kind",
            "no-change",
            "cardinality-mismatch",
            "incomplete-generation",
            "duplicate-site",
            "invalid-join",
            "stale-precondition",
            "malformed-path",
            "unsupported-operation",
            "duplicate-target",
            "overlapping-edit",
            "invalid-position",
            "ill-sorted",
            "invalid-module",
            "invalid-import",
            "invalid-variable",
            "invalid-attribute",
            "invalid-sentence",
            "lowering-rejected",
            "lowering-nontermination",
            "unsupported-lowering",
            "time-limit",
            "resource-limit",
            "compile-rejected",
            "unsupported-backend-profile",
            "depth-limit",
            "branch-limit",
            "result-limit",
            "solver-unknown",
            "backend-error",
            "unsupported-observation-shape",
            "non-conservative-observation",
            "provenance-mismatch",
            "malformed-event",
            "malformed-pattern",
            "sort-mismatch",
            "invalid-side-condition",
            "malformed-result",
            "unreplayable-witness",
            "baseline-mismatch",
            "malformed-oracle",
            "projection-invalid",
            "evaluator-unavailable",
            "incomparable-result",
            "process-launch",
            "io",
            "artifact-corruption",
            "worker-lost",
            "internal",
            "schema-violation",
            "canonicalization-failure",
            "referential-integrity"
          ]
        },
        "retryability": {
          "enum": [
            "never",
            "same-input-after-resource-change",
            "after-external-repair"
          ]
        },
        "placements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "context",
              "scope",
              "consequence"
            ],
            "properties": {
              "context": {
                "enum": [
                  "observation-installation",
                  "mutation-discovery",
                  "candidate-generation",
                  "pattern-path",
                  "pattern-test",
                  "corpus-shared-setup",
                  "baseline-validation",
                  "baseline-execution",
                  "baseline-oracle-gate",
                  "mutant-validation",
                  "mutant-execution",
                  "oracle-operand-production",
                  "oracle-comparison",
                  "campaign",
                  "report-publication"
                ]
              },
              "scope": {
                "enum": [
                  "candidate",
                  "mutant",
                  "path",
                  "test",
                  "campaign"
                ]
              },
              "consequence": {
                "$ref": "#/$defs/consequence"
              }
            }
          }
        },
        "evidencePolicy": {
          "enum": [
            "none",
            "checked-lowering-cycle-receipt-v1"
          ]
        }
      }
    }
  }
}
