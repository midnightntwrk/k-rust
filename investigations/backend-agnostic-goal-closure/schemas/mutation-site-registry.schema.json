{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/mutation-site-registry.schema.json",
  "title": "Portable mutation selector, site, and join registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registryId",
    "definitionDigest",
    "operatorDigest",
    "selector",
    "join",
    "discovery",
    "sites",
    "tuples"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "registryId": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "definitionDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "operatorDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectorDigest",
        "clauses"
      ],
      "properties": {
        "selectorDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "clauses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "sentenceKinds",
              "label",
              "termPath",
              "termSort",
              "termHeadLabel",
              "bindingName"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "sentenceKinds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "rule",
                    "claim",
                    "context",
                    "alias",
                    "configuration"
                  ]
                }
              },
              "label": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "termPath": {
                "$ref": "common.schema.json#/$defs/path"
              },
              "termSort": {
                "type": "string",
                "minLength": 1
              },
              "termHeadLabel": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bindingName": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9_]*$"
              }
            }
          }
        }
      }
    },
    "join": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "joinDigest",
            "kind",
            "orderedRoles",
            "bindingName",
            "bindingSort"
          ],
          "properties": {
            "joinDigest": {
              "$ref": "common.schema.json#/$defs/digest"
            },
            "kind": {
              "const": "ordered-shared-term"
            },
            "orderedRoles": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "bindingName": {
              "type": "string",
              "pattern": "^[A-Z][A-Za-z0-9_]*$"
            },
            "bindingSort": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exhaustive",
        "failure"
      ],
      "properties": {
        "exhaustive": {
          "type": "boolean"
        },
        "failure": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/mutationDiscoveryFailure"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "exhaustive": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exhaustive": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "type": "object",
                "properties": {
                  "stage": {
                    "const": "selection"
                  },
                  "classification": {
                    "const": "incomplete-generation"
                  },
                  "scope": {
                    "const": "campaign"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "siteId",
          "selectorRole",
          "sentenceLineage",
          "termPath",
          "bindings"
        ],
        "properties": {
          "siteId": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "selectorRole": {
            "type": "string",
            "minLength": 1
          },
          "sentenceLineage": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "termPath": {
            "$ref": "common.schema.json#/$defs/path"
          },
          "bindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/binding"
            }
          }
        }
      }
    },
    "tuples": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    }
  }
}
