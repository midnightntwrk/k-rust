{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/oracle-operand-production-result.schema.json",
  "title": "Portable oracle-operand-production-result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resultId",
    "invocationDigest",
    "outcome",
    "failure"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "resultId": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "invocationDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operand"
          ],
          "properties": {
            "kind": {
              "const": "operand"
            },
            "operand": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "digest"
              ],
              "properties": {
                "role": {
                  "const": "oracle-operand"
                },
                "digest": {
                  "$ref": "common.schema.json#/$defs/digest"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "failure"
          ],
          "properties": {
            "kind": {
              "const": "failure"
            },
            "failure": {
              "$ref": "common.schema.json#/$defs/oracleOperandProductionFailure"
            }
          }
        }
      ]
    },
    "failure": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/oracleOperandProductionFailure"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
