{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/baseline-admission-result.schema.json",
  "title": "Portable baseline-admission-result v1",
  "$defs": {
    "terminalRecord": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "result"
          ],
          "properties": {
            "kind": {
              "const": "baseline-gate"
            },
            "result": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "digest"
              ],
              "properties": {
                "role": {
                  "const": "baseline-oracle-gate-result"
                },
                "digest": {
                  "$ref": "common.schema.json#/$defs/digest"
                }
              }
            }
          }
        },
        {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "failure"
              ],
              "properties": {
                "kind": {
                  "const": "diagnostic-only"
                },
                "failure": {
                  "$ref": "common.schema.json#/$defs/baselineOracleGateFailure"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "classification",
                "failure"
              ],
              "properties": {
                "kind": {
                  "const": "bounded-unknown"
                },
                "classification": {
                  "enum": [
                    "time-limit",
                    "depth-limit",
                    "branch-limit",
                    "result-limit",
                    "resource-limit",
                    "solver-unknown",
                    "evaluator-unavailable"
                  ]
                },
                "failure": {
                  "$ref": "common.schema.json#/$defs/baselineOracleGateFailure"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "resultId",
        "invocationDigest",
        "evaluationKey",
        "terminalRecord",
        "producedArtifacts",
        "failure"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "resultId": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "invocationDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "evaluationKey": {
          "$ref": "cache-semantics.schema.json#/$defs/oracleEvaluationKey"
        },
        "terminalRecord": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "result"
          ],
          "properties": {
            "kind": {
              "const": "baseline-gate"
            },
            "result": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "digest"
              ],
              "properties": {
                "role": {
                  "const": "baseline-oracle-gate-result"
                },
                "digest": {
                  "$ref": "common.schema.json#/$defs/digest"
                }
              }
            }
          }
        },
        "producedArtifacts": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "digest"
              ],
              "properties": {
                "role": {
                  "const": "baseline-oracle-gate-result"
                },
                "digest": {
                  "$ref": "common.schema.json#/$defs/digest"
                }
              }
            }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "failure": {
          "type": "null"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "resultId",
        "invocationDigest",
        "evaluationKey",
        "terminalRecord",
        "producedArtifacts",
        "failure"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "resultId": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "invocationDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "evaluationKey": {
          "$ref": "cache-semantics.schema.json#/$defs/oracleEvaluationKey"
        },
        "terminalRecord": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "failure"
              ],
              "properties": {
                "kind": {
                  "const": "diagnostic-only"
                },
                "failure": {
                  "$ref": "common.schema.json#/$defs/baselineOracleGateFailure"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "classification",
                "failure"
              ],
              "properties": {
                "kind": {
                  "const": "bounded-unknown"
                },
                "classification": {
                  "enum": [
                    "time-limit",
                    "depth-limit",
                    "branch-limit",
                    "result-limit",
                    "resource-limit",
                    "solver-unknown",
                    "evaluator-unavailable"
                  ]
                },
                "failure": {
                  "$ref": "common.schema.json#/$defs/baselineOracleGateFailure"
                }
              }
            }
          ]
        },
        "producedArtifacts": {
          "type": "array",
          "maxItems": 0
        },
        "failure": {
          "$ref": "common.schema.json#/$defs/baselineOracleGateFailure"
        }
      }
    }
  ]
}
