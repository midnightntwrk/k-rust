{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v2/artifact-role-specs-v2.schema.json",
  "title": "Version-dispatched artifact role and semantic identity registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryId", "specs"],
  "properties": {
    "schemaVersion": {"const": 2},
    "registryId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "specs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/spec"}}
  },
  "$defs": {
    "projection": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["opaque-envelope", "complete", "definition-summary"]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "field"], "properties": {"kind": {"enum": ["without-field", "field"]}, "field": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "fields"], "properties": {"kind": {"const": "select-fields"}, "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"}}}}
      ]
    },
    "dispatch": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "schemaVersion"], "properties": {"kind": {"const": "schema-version"}, "schemaVersion": {"type": "integer", "minimum": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "legacy-no-schema-version"}}}
      ]
    },
    "structuredVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "schemaId", "schemaDigest", "digestDomain", "projection", "selfIdField", "dispatch"],
      "properties": {
        "schemaVersion": {"type": "integer", "minimum": 1},
        "schemaId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.schema\\.json(?:#/(?:[^~/]|~0|~1)+(?:(?:/)(?:[^~/]|~0|~1)+)*)?$"},
        "schemaDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
        "digestDomain": {"type": "string", "pattern": "^k-in-k/[a-z0-9-]+/v[1-9][0-9]*$"},
        "projection": {"$ref": "#/$defs/projection"},
        "selfIdField": {"type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9]*$"},
        "dispatch": {"$ref": "#/$defs/dispatch"}
      }
    },
    "opaqueSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "contentModel", "mediaType", "schema", "digestDomain", "projection", "selfIdField"],
      "properties": {
        "role": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/bag16-common.schema.json#/$defs/artifactRole"},
        "contentModel": {"const": "opaque-bytes"},
        "mediaType": {"const": "application/octet-stream"},
        "schema": {"type": "null"},
        "digestDomain": {"type": "string", "pattern": "^k-in-k/[a-z0-9-]+/v1$"},
        "projection": {"const": {"kind": "opaque-envelope"}},
        "selfIdField": {"type": "null"}
      }
    },
    "structuredSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "contentModel", "mediaType", "structuredVersions"],
      "properties": {
        "role": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/bag16-common.schema.json#/$defs/artifactRole"},
        "contentModel": {"const": "canonical-json"},
        "mediaType": {"const": "application/json"},
        "structuredVersions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/structuredVersion"}}
      }
    },
    "spec": {"oneOf": [{"$ref": "#/$defs/opaqueSpec"}, {"$ref": "#/$defs/structuredSpec"}]}
  }
}
