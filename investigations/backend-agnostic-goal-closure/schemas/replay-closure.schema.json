{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/replay-closure.schema.json",
  "title": "Derived portable replay closure evidence v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": {"const": 1},
    "records": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["replayId", "referentialClosure", "materialClosure", "unresolvedConcreteKeys", "externalRequiredInputs", "unboundInputs", "executionConformance"],
      "properties": {
        "replayId": {"$ref": "common.schema.json#/$defs/digest"},
        "referentialClosure": {"type": "boolean"},
        "materialClosure": {"type": "boolean"},
        "unresolvedConcreteKeys": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifactKey"}},
        "externalRequiredInputs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifactKey"}},
        "unboundInputs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifactUse"}},
        "executionConformance": {"const": "not-proven"}
      }
    }}
  }
}
