{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v2/corpus-manifest-v2.schema.json",
  "title": "Ordered query-search corpus manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestId", "definition", "compatibilityProfileDigest", "observationManifestDigest", "executionMode", "solverProfileDigest", "executionProfileDigest", "bounds", "aggregation", "tests"],
  "properties": {
    "schemaVersion": {"const": 2},
    "manifestId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "definition": {"$ref": "#/$defs/definitionKey"},
    "compatibilityProfileDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "observationManifestDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "executionMode": {"enum": ["concrete", "symbolic"]},
    "solverProfileDigest": {"oneOf": [{"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}, {"type": "null"}]},
    "executionProfileDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "bounds": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/bounds"},
    "aggregation": {
      "type": "object", "additionalProperties": false,
      "required": ["question", "schedulingPolicy", "failurePolicy"],
      "properties": {
        "question": {"const": "corpus-exists"},
        "schedulingPolicy": {"enum": ["full", "stop-after-test-match"]},
        "failurePolicy": {"const": "preserve-unknown-error"}
      }
    },
    "tests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/test"}}
  },
  "$defs": {
    "typedKey": {
      "type": "object", "additionalProperties": false, "required": ["role", "digest"],
      "properties": {
        "role": {"enum": ["definition", "oracle-declaration", "pattern-source", "pattern-plan", "pattern-query", "side-condition-conformance-table"]},
        "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}
      }
    },
    "definitionKey": {"allOf": [{"$ref": "#/$defs/typedKey"}, {"properties": {"role": {"const": "definition"}}}]},
    "declarationKey": {"allOf": [{"$ref": "#/$defs/typedKey"}, {"properties": {"role": {"const": "oracle-declaration"}}}]},
    "patternSourceKey": {"allOf": [{"$ref": "#/$defs/typedKey"}, {"properties": {"role": {"const": "pattern-source"}}}]},
    "patternPlanKey": {"allOf": [{"$ref": "#/$defs/typedKey"}, {"properties": {"role": {"const": "pattern-plan"}}}]},
    "patternQueryKey": {"allOf": [{"$ref": "#/$defs/typedKey"}, {"properties": {"role": {"const": "pattern-query"}}}]},
    "sideConditionTableKey": {"allOf": [{"$ref": "#/$defs/typedKey"}, {"properties": {"role": {"const": "side-condition-conformance-table"}}}]},
    "slot": {
      "type": "object", "additionalProperties": false,
      "required": ["testOrdinal", "slotOrdinal", "slotId", "testInvocationDigest", "declaration", "patternSource", "patternPlan", "patternQuery", "sideConditionTable", "searchPolicy"],
      "properties": {
        "testOrdinal": {"type": "integer", "minimum": 0},
        "slotOrdinal": {"type": "integer", "minimum": 0},
        "slotId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
        "testInvocationDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
        "declaration": {"$ref": "#/$defs/declarationKey"},
        "patternSource": {"$ref": "#/$defs/patternSourceKey"},
        "patternPlan": {"$ref": "#/$defs/patternPlanKey"},
        "patternQuery": {"$ref": "#/$defs/patternQueryKey"},
        "sideConditionTable": {"$ref": "#/$defs/sideConditionTableKey"},
        "searchPolicy": {"enum": ["exhaustive", "existential-first"]}
      }
    },
    "test": {
      "type": "object", "additionalProperties": false,
      "required": ["testOrdinal", "testInvocationDigest", "slots"],
      "properties": {
        "testOrdinal": {"type": "integer", "minimum": 0},
        "testInvocationDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
        "slots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slot"}}
      }
    }
  }
}
