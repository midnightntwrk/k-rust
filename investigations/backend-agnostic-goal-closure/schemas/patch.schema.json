{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/patch.schema.json",
  "title": "Canonical semantic patch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "patchId", "operatorId", "operatorVersion", "edits"],
  "properties": {
    "schemaVersion": {"const": 1},
    "patchId": {"$ref": "common.schema.json#/$defs/digest"},
    "operatorId": {"type": "string", "minLength": 1},
    "operatorVersion": {"type": "integer", "minimum": 1},
    "edits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["editId", "operation", "targetLineage", "expectedContent", "targetPath", "value"],
        "properties": {
          "editId": {"$ref": "common.schema.json#/$defs/digest"},
          "operation": {"type": "string", "enum": ["replace-term", "replace-sentence", "delete-sentence", "insert-sentence", "replace-condition", "add-attribute", "remove-attribute", "replace-attribute"]},
          "targetLineage": {"oneOf": [{"$ref": "common.schema.json#/$defs/digest"}, {"type": "null"}]},
          "expectedContent": {"oneOf": [{"$ref": "common.schema.json#/$defs/digest"}, {"type": "null"}]},
          "expectedAttributeFingerprint": {"oneOf": [{"$ref": "common.schema.json#/$defs/digest"}, {"type": "null"}]},
          "expectedModuleFingerprint": {"oneOf": [{"$ref": "common.schema.json#/$defs/digest"}, {"type": "null"}]},
          "targetPath": {"$ref": "common.schema.json#/$defs/path"},
          "value": {"$ref": "#/$defs/editValue"},
          "position": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ordinal"],
            "properties": {
              "kind": {"type": "string", "enum": ["before-lineage", "after-lineage", "module-start", "module-end"]},
              "anchorLineage": {"$ref": "common.schema.json#/$defs/digest"},
              "module": {"type": "string"},
              "ordinal": {"type": "integer", "minimum": 0}
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"operation": {"const": "replace-term"}}}, "then": {"properties": {"targetLineage": {"$ref": "common.schema.json#/$defs/digest"}, "expectedContent": {"$ref": "common.schema.json#/$defs/digest"}, "targetPath": {"minItems": 1}, "value": {"oneOf": [{"$ref": "#/$defs/editValueTerm"}, {"$ref": "#/$defs/editValueOriginal"}]}}, "not": {"required": ["position"]}}},
          {"if": {"properties": {"operation": {"const": "replace-sentence"}}}, "then": {"properties": {"targetLineage": {"$ref": "common.schema.json#/$defs/digest"}, "expectedContent": {"$ref": "common.schema.json#/$defs/digest"}, "targetPath": {"maxItems": 0}, "value": {"$ref": "#/$defs/editValueSentence"}}, "not": {"required": ["position"]}}},
          {"if": {"properties": {"operation": {"const": "delete-sentence"}}}, "then": {"properties": {"targetLineage": {"$ref": "common.schema.json#/$defs/digest"}, "expectedContent": {"$ref": "common.schema.json#/$defs/digest"}, "targetPath": {"maxItems": 0}, "value": {"$ref": "#/$defs/editValueNone"}}, "not": {"required": ["position"]}}},
          {"if": {"properties": {"operation": {"const": "insert-sentence"}}}, "then": {"required": ["position"], "properties": {"targetPath": {"maxItems": 0}, "value": {"$ref": "#/$defs/editValueSentence"}}}},
          {"if": {"properties": {"operation": {"const": "insert-sentence"}, "position": {"properties": {"kind": {"enum": ["before-lineage", "after-lineage"]}}}}}, "then": {"properties": {"targetLineage": {"$ref": "common.schema.json#/$defs/digest"}, "expectedContent": {"$ref": "common.schema.json#/$defs/digest"}, "position": {"required": ["anchorLineage"], "not": {"required": ["module"]}}}}},
          {"if": {"properties": {"operation": {"const": "insert-sentence"}, "position": {"properties": {"kind": {"enum": ["module-start", "module-end"]}}}}}, "then": {"required": ["expectedModuleFingerprint"], "properties": {"targetLineage": {"type": "null"}, "expectedContent": {"type": "null"}, "expectedModuleFingerprint": {"$ref": "common.schema.json#/$defs/digest"}, "position": {"required": ["module"], "not": {"required": ["anchorLineage"]}}}}},
          {"if": {"properties": {"operation": {"const": "replace-condition"}}}, "then": {"properties": {"targetLineage": {"$ref": "common.schema.json#/$defs/digest"}, "expectedContent": {"$ref": "common.schema.json#/$defs/digest"}, "targetPath": {"minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": {"kind": {"const": "field"}, "name": {"enum": ["requires", "ensures"]}}}}, "value": {"$ref": "#/$defs/editValueTerm"}}, "not": {"required": ["position"]}}},
          {"if": {"properties": {"operation": {"const": "add-attribute"}}}, "then": {"required": ["expectedAttributeFingerprint"], "properties": {"targetLineage": {"$ref": "common.schema.json#/$defs/digest"}, "expectedContent": {"$ref": "common.schema.json#/$defs/digest"}, "expectedAttributeFingerprint": {"type": "null"}, "targetPath": {"minItems": 2, "maxItems": 2}, "value": {"$ref": "#/$defs/editValueAttribute"}}, "not": {"required": ["position"]}}},
          {"if": {"properties": {"operation": {"const": "remove-attribute"}}}, "then": {"required": ["expectedAttributeFingerprint"], "properties": {"targetLineage": {"$ref": "common.schema.json#/$defs/digest"}, "expectedContent": {"$ref": "common.schema.json#/$defs/digest"}, "expectedAttributeFingerprint": {"$ref": "common.schema.json#/$defs/digest"}, "targetPath": {"minItems": 2, "maxItems": 2}, "value": {"$ref": "#/$defs/editValueNone"}}, "not": {"required": ["position"]}}},
          {"if": {"properties": {"operation": {"const": "replace-attribute"}}}, "then": {"required": ["expectedAttributeFingerprint"], "properties": {"targetLineage": {"$ref": "common.schema.json#/$defs/digest"}, "expectedContent": {"$ref": "common.schema.json#/$defs/digest"}, "expectedAttributeFingerprint": {"$ref": "common.schema.json#/$defs/digest"}, "targetPath": {"minItems": 2, "maxItems": 2}, "value": {"$ref": "#/$defs/editValueAttribute"}}, "not": {"required": ["position"]}}}
        ]
      }
    }
  },
  "$defs": {
    "editValueTerm": {"type": "object", "additionalProperties": false, "required": ["kind", "term"], "properties": {"kind": {"const": "term"}, "term": {"$ref": "common.schema.json#/$defs/term"}}},
    "editValueSentence": {"type": "object", "additionalProperties": false, "required": ["kind", "sentence"], "properties": {"kind": {"const": "sentence"}, "sentence": {"$ref": "common.schema.json#/$defs/sentenceValue"}}},
    "editValueAttribute": {"type": "object", "additionalProperties": false, "required": ["kind", "name", "value"], "properties": {"kind": {"const": "attribute"}, "name": {"type": "string", "minLength": 1}, "value": {"oneOf": [{"$ref": "common.schema.json#/$defs/term"}, {"type": "null"}]}}},
    "editValueOriginal": {"type": "object", "additionalProperties": false, "required": ["kind", "fromOriginalLineage", "fromOriginalPath"], "properties": {"kind": {"const": "original-reference"}, "fromOriginalLineage": {"$ref": "common.schema.json#/$defs/digest"}, "fromOriginalPath": {"$ref": "common.schema.json#/$defs/path"}}},
    "editValueNone": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "none"}}},
    "editValue": {
      "oneOf": [
        {"$ref": "#/$defs/editValueTerm"},
        {"$ref": "#/$defs/editValueSentence"},
        {"$ref": "#/$defs/editValueAttribute"},
        {"$ref": "#/$defs/editValueOriginal"},
        {"$ref": "#/$defs/editValueNone"}
      ]
    }
  }
}
