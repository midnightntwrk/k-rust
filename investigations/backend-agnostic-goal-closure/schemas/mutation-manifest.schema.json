{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/mutation-manifest.schema.json",
  "title": "Mutation campaign input manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestId", "artifactCatalogDigest", "definitionDigest", "operatorDigest", "siteRegistryDigest", "corpusManifestDigest", "oracles", "tests"],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestId": {"$ref": "common.schema.json#/$defs/digest"},
    "artifactCatalogDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "definitionDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "operatorDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "siteRegistryDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "corpusManifestDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "oracles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["oracleId", "version", "kind", "projectionDigest", "comparisonDigest", "crashPolicy", "baselineTerminalPolicy", "artifacts"],
        "properties": {
          "oracleId": {"type": "string", "minLength": 1},
          "version": {"const": 1},
          "kind": {"type": "string", "enum": ["exit-stop", "final-result", "concrete-output", "reachability", "execution-pattern", "structured-predicate"]},
          "projectionDigest": {"$ref": "common.schema.json#/$defs/digest"},
          "comparisonDigest": {"$ref": "common.schema.json#/$defs/digest"},
          "crashPolicy": {"type": "string", "enum": ["semantic-crash-distinguishes", "semantic-crash-incomparable"]},
          "baselineTerminalPolicy": {"type": "string", "enum": ["normal-required", "semantic-crash-allowed"]},
          "artifacts": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "common.schema.json#/$defs/artifactRef"}}
        }
      }
    },
    "tests": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["testId", "programDigest", "parserDigest", "startSymbol", "optionsDigest", "boundsDigest", "invocationDigest", "oracleIds"],
        "properties": {
          "testId": {"type": "string", "minLength": 1},
          "programDigest": {"$ref": "common.schema.json#/$defs/digest"},
          "parserDigest": {"$ref": "common.schema.json#/$defs/digest"},
          "startSymbol": {"type": "string", "minLength": 1},
          "optionsDigest": {"$ref": "common.schema.json#/$defs/digest"},
          "boundsDigest": {"$ref": "common.schema.json#/$defs/digest"},
          "invocationDigest": {"$ref": "common.schema.json#/$defs/digest"},
          "oracleIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
