{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/mutation-manifest.schema.json",
  "title": "Mutation campaign input manifest with ordered typed oracle declarations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "artifactCatalogDigest",
    "definitionDigest",
    "operatorDigest",
    "siteRegistryDigest",
    "corpusManifestDigest",
    "loweringProfileDigest",
    "loweringEvidence",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "manifestId": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "artifactCatalogDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "definitionDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "operatorDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "siteRegistryDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "corpusManifestDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "loweringProfileDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "loweringEvidence": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "digest"
            ],
            "properties": {
              "role": {
                "const": "lowering-cycle-proof"
              },
              "digest": {
                "$ref": "common.schema.json#/$defs/digest"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "digest"
            ],
            "properties": {
              "role": {
                "const": "lowering-proof-check-receipt"
              },
              "digest": {
                "$ref": "common.schema.json#/$defs/digest"
              }
            }
          }
        ]
      },
      "uniqueItems": true
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "testId",
          "programDigest",
          "parserDigest",
          "startSymbol",
          "optionsDigest",
          "boundsDigest",
          "invocationDigest",
          "patternQueries",
          "oracleDeclarations"
        ],
        "properties": {
          "testId": {
            "type": "string",
            "minLength": 1
          },
          "programDigest": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "parserDigest": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "startSymbol": {
            "type": "string",
            "minLength": 1
          },
          "optionsDigest": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "boundsDigest": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "invocationDigest": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "patternQueries": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/patternQueryRoot"
            }
          },
          "oracleDeclarations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "digest"
              ],
              "properties": {
                "role": {
                  "const": "oracle-declaration"
                },
                "digest": {
                  "$ref": "common.schema.json#/$defs/digest"
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    }
  }
}
