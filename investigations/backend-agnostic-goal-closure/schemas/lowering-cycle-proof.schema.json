{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/lowering-cycle-proof.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "proofId",
    "proofKind",
    "subject",
    "loweringProfileDigest",
    "executionProfileDigest",
    "relationId",
    "cycleStates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "proofId": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "proofKind": {
      "const": "finite-cycle-witness-v1"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "loweringProfileDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "executionProfileDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "relationId": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "cycleStates": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "definitionDigest"
          ],
          "properties": {
            "role": {
              "const": "baseline"
            },
            "definitionDigest": {
              "$ref": "common.schema.json#/$defs/digest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "baselineDefinitionDigest",
            "mutantId",
            "mutantDefinitionDigest"
          ],
          "properties": {
            "role": {
              "const": "mutant"
            },
            "baselineDefinitionDigest": {
              "$ref": "common.schema.json#/$defs/digest"
            },
            "mutantId": {
              "$ref": "common.schema.json#/$defs/digest"
            },
            "mutantDefinitionDigest": {
              "$ref": "common.schema.json#/$defs/digest"
            }
          }
        }
      ]
    }
  }
}
