{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v2/cache-semantics-v2.schema.json",
  "title": "Collection-aware execution-only cache semantics v2",
  "oneOf": [
    {"$ref": "#/$defs/executionAttemptKey"},
    {"$ref": "#/$defs/cacheRecord"}
  ],
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "operationVersion", "adapterId", "adapterVersion"],
      "properties": {
        "operationId": {"type": "string", "minLength": 1},
        "operationVersion": {"type": "integer", "minimum": 1},
        "adapterId": {"type": "string", "minLength": 1},
        "adapterVersion": {"type": "integer", "minimum": 1}
      }
    },
    "typedKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "digest"],
      "properties": {
        "role": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/bag16-common.schema.json#/$defs/artifactRole"},
        "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}
      }
    },
    "subject": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "definition"],
          "properties": {"kind": {"const": "baseline"}, "definition": {"$ref": "#/$defs/definitionKey"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "baselineDefinition", "candidateId", "operator", "patch", "mutantId", "mutantDefinition"],
          "properties": {
            "kind": {"const": "mutant"},
            "baselineDefinition": {"$ref": "#/$defs/definitionKey"},
            "candidateId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
            "operator": {"$ref": "#/$defs/mutationOperatorKey"},
            "patch": {"$ref": "#/$defs/patchKey"},
            "mutantId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
            "mutantDefinition": {"$ref": "#/$defs/mutantDefinitionKey"}
          }
        }
      ]
    },
    "definitionKey": {"allOf": [{"$ref": "#/$defs/typedKey"}, {"properties": {"role": {"const": "definition"}}}]},
    "mutationOperatorKey": {"allOf": [{"$ref": "#/$defs/typedKey"}, {"properties": {"role": {"const": "mutation-operator"}}}]},
    "patchKey": {"allOf": [{"$ref": "#/$defs/typedKey"}, {"properties": {"role": {"const": "patch"}}}]},
    "mutantDefinitionKey": {"allOf": [{"$ref": "#/$defs/typedKey"}, {"properties": {"role": {"const": "mutant-definition"}}}]},
    "attemptKind": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "observationInputs"],
          "properties": {
            "kind": {"const": "observed-exhaustive"},
            "observationInputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/typedKey"}}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "observationInputs", "patternSource", "patternPlan", "patternQuery", "sideConditionTable", "searchPolicy"],
          "properties": {
            "kind": {"const": "query-coupled"},
            "observationInputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/typedKey"}},
            "patternSource": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/patternSourceKey"},
            "patternPlan": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/patternPlanKey"},
            "patternQuery": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/patternQueryKey"},
            "sideConditionTable": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/sideConditionTableKey"},
            "searchPolicy": {"const": "existential-first"}
          }
        }
      ]
    },
    "executionAttemptKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "keyDigest", "operation", "subject", "testInvocationDigest", "compatibilityProfileDigest", "loweringProfileDigest", "executionProfileDigest", "solverProfileDigest", "isolationPolicy", "attemptKind"],
      "properties": {
        "schemaVersion": {"const": 2},
        "keyDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
        "operation": {"$ref": "#/$defs/operation"},
        "subject": {"$ref": "#/$defs/subject"},
        "testInvocationDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
        "compatibilityProfileDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
        "loweringProfileDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
        "executionProfileDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
        "solverProfileDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
        "isolationPolicy": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/cache-semantics.schema.json#/$defs/isolationPolicy"},
        "attemptKind": {"$ref": "#/$defs/attemptKind"}
      }
    },
    "collectionKey": {
      "allOf": [{"$ref": "#/$defs/typedKey"}, {"properties": {"role": {"const": "branch-trace-collection"}}}]
    },
    "executionTerminalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "collection", "stopReason"],
      "properties": {
        "kind": {"const": "branch-collection"},
        "collection": {"$ref": "#/$defs/collectionKey"},
        "stopReason": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/branch-trace-collection.schema.json#/$defs/stopReason"}
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producerStatus", "evidenceClass", "materialClosure", "executionConformance"],
      "properties": {
        "producerStatus": {"const": "complete"},
        "evidenceClass": {"enum": ["semantic-result", "exact-bounded-attempt", "diagnostic-only"]},
        "materialClosure": {"enum": ["repo-complete", "external-required"]},
        "executionConformance": {"enum": ["finite-vector-proven", "native-proven", "not-proven"]}
      }
    },
    "productionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "receipt", "result"],
      "properties": {
        "mode": {"const": "operation-receipt"},
        "receipt": {
          "type": "object", "additionalProperties": false, "required": ["role", "digest"],
          "properties": {"role": {"const": "operation-receipt"}, "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}}
        },
        "result": {
          "type": "object", "additionalProperties": false, "required": ["role", "digest"],
          "properties": {"role": {"const": "execution-attempt-result"}, "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}}
        }
      }
    },
    "cacheRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "recordId", "kind", "keyDigest", "key", "terminalRecord", "producedArtifacts", "completion", "reuseClass", "productionEvidence"],
      "properties": {
        "schemaVersion": {"const": 2},
        "recordId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
        "kind": {"const": "execution-attempt"},
        "keyDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
        "key": {"$ref": "#/$defs/executionAttemptKey"},
        "terminalRecord": {"$ref": "#/$defs/executionTerminalRecord"},
        "producedArtifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/execution-attempt-result-v2.schema.json#/$defs/producedArtifact"}},
        "completion": {"$ref": "#/$defs/completion"},
        "reuseClass": {"enum": ["semantic-result", "exact-bounded-attempt", "not-reusable"]},
        "productionEvidence": {"$ref": "#/$defs/productionEvidence"}
      }
    }
  }
}
