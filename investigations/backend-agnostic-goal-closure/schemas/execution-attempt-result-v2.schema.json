{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v2/execution-attempt-result-v2.schema.json",
  "title": "Branch-collection execution attempt result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultId", "attemptKeyDigest", "invocationDigest", "terminalRecord", "producedArtifacts", "branchCollection"],
  "properties": {
    "schemaVersion": {"const": 2},
    "resultId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "attemptKeyDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "invocationDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "terminalRecord": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/cache-semantics-v2.schema.json#/$defs/executionTerminalRecord"},
    "producedArtifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/producedArtifact"}
    },
    "branchCollection": {"$ref": "#/$defs/collectionKey"}
  },
  "$defs": {
    "producedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "digest"],
      "properties": {
        "role": {"enum": ["terminal-state", "semantic-crash", "event-trace", "empty-search-decision", "branch-trace-collection"]},
        "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}
      }
    },
    "collectionKey": {
      "allOf": [
        {"$ref": "#/$defs/producedArtifact"},
        {"properties": {"role": {"const": "branch-trace-collection"}}}
      ]
    }
  }
}
