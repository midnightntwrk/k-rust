{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/mutation-campaign.schema.json",
  "title": "Mutation candidate, result, and report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "campaignId",
    "reportId",
    "manifestDigest",
    "operator",
    "schemas",
    "scheduleMode",
    "selectedTestIds",
    "campaignStatus",
    "failures",
    "generation",
    "baseline",
    "candidateRejections",
    "mutants"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "campaignId": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "reportId": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "manifestDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "operator",
        "siteRegistry",
        "patch",
        "structuralDiff",
        "replay",
        "eventTrace",
        "patternResult",
        "mutationCampaign",
        "failureTaxonomy"
      ],
      "properties": {
        "identity": {
          "const": 1
        },
        "operator": {
          "const": 1
        },
        "siteRegistry": {
          "const": 1
        },
        "patch": {
          "const": 1
        },
        "structuralDiff": {
          "const": 1
        },
        "replay": {
          "const": 1
        },
        "eventTrace": {
          "const": 1
        },
        "patternResult": {
          "const": 1
        },
        "mutationCampaign": {
          "const": 1
        },
        "failureTaxonomy": {
          "const": 1
        }
      }
    },
    "scheduleMode": {
      "type": "string",
      "enum": [
        "first-kill",
        "full"
      ]
    },
    "selectedTestIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "campaignStatus": {
      "type": "string",
      "enum": [
        "complete",
        "selection-failed",
        "baseline-invalid",
        "baseline-oracle-failed",
        "incomplete-generation",
        "error"
      ]
    },
    "failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/campaignFailure"
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siteRegistryDigest",
        "policy",
        "complete",
        "candidateCap",
        "derivedInstanceCount",
        "retainedInstanceCount",
        "candidates",
        "failures"
      ],
      "properties": {
        "siteRegistryDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "policy": {
          "type": "string",
          "enum": [
            "exact",
            "each",
            "tuple-each",
            "all-matches"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "candidateCap": {
          "type": "integer",
          "minimum": 1
        },
        "derivedInstanceCount": {
          "type": "integer",
          "minimum": 0
        },
        "retainedInstanceCount": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/candidateGenerationFailure"
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definitionDigest",
        "status",
        "tests",
        "oracleGateResults",
        "failures"
      ],
      "properties": {
        "definitionDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "status": {
          "type": "string",
          "enum": [
            "valid",
            "baseline-invalid",
            "baseline-oracle-failed"
          ]
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/baselineTest"
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/baselineFailure"
          }
        },
        "oracleGateResults": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "digest"
            ],
            "properties": {
              "role": {
                "const": "baseline-oracle-gate-result"
              },
              "digest": {
                "$ref": "common.schema.json#/$defs/digest"
              }
            }
          }
        }
      }
    },
    "candidateRejections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidateRejection"
      }
    },
    "mutants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mutant"
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "killed",
        "survived",
        "denominator",
        "ratio",
        "excluded"
      ],
      "properties": {
        "killed": {
          "type": "integer",
          "minimum": 0
        },
        "survived": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "ratio": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/rational"
            }
          ]
        },
        "excluded": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "invalid",
            "timeout",
            "unknown",
            "error",
            "duplicate",
            "no-change"
          ],
          "properties": {
            "invalid": {
              "type": "integer",
              "minimum": 0
            },
            "timeout": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            },
            "error": {
              "type": "integer",
              "minimum": 0
            },
            "duplicate": {
              "type": "integer",
              "minimum": 0
            },
            "no-change": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "campaignStatus": {
            "const": "complete"
          }
        }
      },
      "then": {
        "required": [
          "score"
        ],
        "properties": {
          "failures": {
            "maxItems": 0
          },
          "generation": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "baseline": {
            "properties": {
              "status": {
                "const": "valid"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "campaignStatus": {
            "const": "selection-failed"
          }
        }
      },
      "then": {
        "properties": {
          "generation": {
            "properties": {
              "complete": {
                "const": false
              },
              "candidates": {
                "maxItems": 0
              },
              "failures": {
                "minItems": 1
              }
            }
          },
          "candidateRejections": {
            "maxItems": 0
          },
          "mutants": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "campaignStatus": {
            "const": "incomplete-generation"
          }
        }
      },
      "then": {
        "properties": {
          "generation": {
            "properties": {
              "complete": {
                "const": false
              },
              "failures": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "campaignStatus": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "failures": {
            "minItems": 1
          },
          "mutants": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "campaignStatus": {
            "enum": [
              "selection-failed",
              "baseline-invalid",
              "baseline-oracle-failed",
              "incomplete-generation",
              "error"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "score"
          ]
        }
      }
    }
  ],
  "$defs": {
    "baselineTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "oracleDeclarations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "agree",
            "invalid",
            "timeout",
            "unknown",
            "error",
            "skipped"
          ]
        },
        "oracleDeclarations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "digest"
            ],
            "properties": {
              "role": {
                "const": "oracle-declaration"
              },
              "digest": {
                "$ref": "common.schema.json#/$defs/digest"
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "originInstances",
        "patch"
      ],
      "properties": {
        "candidateId": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "originInstances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instanceId",
              "siteTuple",
              "discoveryTuples",
              "editReceipts"
            ],
            "properties": {
              "instanceId": {
                "$ref": "common.schema.json#/$defs/digest"
              },
              "siteTuple": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "common.schema.json#/$defs/digest"
                }
              },
              "discoveryTuples": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "siteTuple",
                    "bindings"
                  ],
                  "properties": {
                    "siteTuple": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "$ref": "common.schema.json#/$defs/digest"
                      }
                    },
                    "bindings": {
                      "type": "array",
                      "items": {
                        "$ref": "common.schema.json#/$defs/binding"
                      }
                    }
                  }
                }
              },
              "editReceipts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "editId",
                    "operator",
                    "patchTemplateDigest",
                    "templateRole",
                    "sources"
                  ],
                  "properties": {
                    "editId": {
                      "$ref": "common.schema.json#/$defs/digest"
                    },
                    "operator": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "version",
                        "digest"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "version": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "digest": {
                          "$ref": "common.schema.json#/$defs/digest"
                        }
                      }
                    },
                    "patchTemplateDigest": {
                      "$ref": "common.schema.json#/$defs/digest"
                    },
                    "templateRole": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sources": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "discoveryTupleIndex",
                          "siteId",
                          "selectorRole",
                          "tupleBindings"
                        ],
                        "properties": {
                          "discoveryTupleIndex": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "siteId": {
                            "$ref": "common.schema.json#/$defs/digest"
                          },
                          "selectorRole": {
                            "type": "string",
                            "minLength": 1
                          },
                          "tupleBindings": {
                            "type": "array",
                            "items": {
                              "$ref": "common.schema.json#/$defs/binding"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "patch": {
          "$ref": "patch.schema.json"
        }
      }
    },
    "candidateRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "patchId",
        "originInstanceIds",
        "failures"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "duplicate",
            "no-change"
          ]
        },
        "patchId": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "originInstanceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/digest"
          }
        },
        "failures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/candidateGenerationFailure"
          }
        }
      }
    },
    "oracleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration",
        "outcome",
        "baselineSide",
        "mutantSide",
        "comparison",
        "failure"
      ],
      "properties": {
        "declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "digest"
          ],
          "properties": {
            "role": {
              "const": "oracle-declaration"
            },
            "digest": {
              "$ref": "common.schema.json#/$defs/digest"
            }
          }
        },
        "outcome": {
          "enum": [
            "agree",
            "distinguish",
            "incomparable",
            "timeout",
            "unknown",
            "error",
            "skipped"
          ]
        },
        "baselineSide": {
          "oneOf": [
            {
              "$ref": "oracle-semantics.schema.json#/$defs/comparisonSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "mutantSide": {
          "oneOf": [
            {
              "$ref": "oracle-semantics.schema.json#/$defs/comparisonSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "comparison": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "digest"
              ],
              "properties": {
                "role": {
                  "const": "oracle-comparison-result"
                },
                "digest": {
                  "$ref": "common.schema.json#/$defs/digest"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "failure": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sourceSide",
                    "failure"
                  ],
                  "properties": {
                    "sourceSide": {
                      "const": "baseline-execution"
                    },
                    "failure": {
                      "$ref": "common.schema.json#/$defs/baselineExecutionFailure"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sourceSide",
                    "failure"
                  ],
                  "properties": {
                    "sourceSide": {
                      "const": "baseline-operand-production"
                    },
                    "failure": {
                      "$ref": "common.schema.json#/$defs/oracleOperandProductionFailure"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sourceSide",
                    "failure"
                  ],
                  "properties": {
                    "sourceSide": {
                      "const": "mutant-execution"
                    },
                    "failure": {
                      "$ref": "common.schema.json#/$defs/mutantExecutionFailure"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sourceSide",
                    "failure"
                  ],
                  "properties": {
                    "sourceSide": {
                      "const": "mutant-operand-production"
                    },
                    "failure": {
                      "$ref": "common.schema.json#/$defs/oracleOperandProductionFailure"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sourceSide",
                    "failure"
                  ],
                  "properties": {
                    "sourceSide": {
                      "const": "comparison"
                    },
                    "failure": {
                      "$ref": "common.schema.json#/$defs/oracleComparisonFailure"
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "mutant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutantId",
        "candidateId",
        "patchId",
        "outputDefinitionDigest",
        "status",
        "appliedEditCount",
        "validation",
        "diff",
        "tests",
        "oracleResults",
        "failures",
        "replayManifestDigest",
        "artifacts",
        "bounds"
      ],
      "properties": {
        "mutantId": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "candidateId": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "patchId": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "status": {
          "type": "string",
          "enum": [
            "killed",
            "survived",
            "invalid",
            "timeout",
            "unknown",
            "error"
          ]
        },
        "appliedEditCount": {
          "type": "integer",
          "minimum": 0
        },
        "outputDefinitionDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "closestStage"
          ],
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "valid",
                "invalid",
                "error"
              ]
            },
            "closestStage": {
              "type": "string",
              "enum": [
                "operator",
                "selection",
                "patch",
                "ir-validation",
                "lowering",
                "backend-validation",
                "execution",
                "observation",
                "pattern",
                "oracle",
                "report"
              ]
            }
          }
        },
        "diff": {
          "$ref": "structural-diff.schema.json"
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "selected",
              "boundsDigest",
              "invocationDigest",
              "oracleDeclarations"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "agree",
                  "kill",
                  "invalid",
                  "timeout",
                  "unknown",
                  "error",
                  "skipped"
                ]
              },
              "selected": {
                "type": "boolean"
              },
              "boundsDigest": {
                "$ref": "common.schema.json#/$defs/digest"
              },
              "invocationDigest": {
                "$ref": "common.schema.json#/$defs/digest"
              },
              "oracleDeclarations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "role",
                    "digest"
                  ],
                  "properties": {
                    "role": {
                      "const": "oracle-declaration"
                    },
                    "digest": {
                      "$ref": "common.schema.json#/$defs/digest"
                    }
                  }
                },
                "minItems": 1
              }
            }
          }
        },
        "oracleResults": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/oracleResult"
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mutantFailure"
          }
        },
        "replayManifestDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/artifactRef"
          }
        },
        "bounds": {
          "$ref": "common.schema.json#/$defs/bounds"
        }
      }
    },
    "campaignFailure": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/campaignFailure"
        },
        {
          "$ref": "common.schema.json#/$defs/reportPublicationFailure"
        }
      ]
    },
    "baselineFailure": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/baselineValidationFailure"
        },
        {
          "$ref": "common.schema.json#/$defs/baselineExecutionFailure"
        },
        {
          "$ref": "common.schema.json#/$defs/baselineOracleGateFailure"
        }
      ]
    },
    "mutantFailure": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/mutantValidationFailure"
        },
        {
          "$ref": "common.schema.json#/$defs/mutantExecutionFailure"
        }
      ]
    }
  }
}
