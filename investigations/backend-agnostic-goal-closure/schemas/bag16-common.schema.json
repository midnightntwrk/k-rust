{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v2/bag16-common.schema.json",
  "title": "Shared closed BAG-16 schema fragments",
  "$defs": {
    "artifactRole": {
      "enum": [
        "baseline-admission-result", "baseline-oracle-gate-result", "branch-trace-collection", "cache-campaign-invocation", "cache-campaign-manifest", "cache-mutation-report", "cache-record", "campaign-derivation-result", "compatibility-profile", "corpus-component-invocation", "corpus-component-result", "corpus-derivation-result", "corpus-manifest", "corpus-result", "definition", "empty-search-decision", "event-trace", "execution-attempt-result", "execution-profile", "execution-test-invocation", "failure-taxonomy", "instrumented-definition", "lowering-cycle-proof", "lowering-profile", "lowering-proof-check-receipt", "mutant-definition", "mutation-join", "mutation-materialization-result", "mutation-module", "mutation-operator", "mutation-selector", "mutation-site-registry", "observation-manifest", "observer", "operation-receipt", "options", "oracle-comparison", "oracle-comparison-production-result", "oracle-comparison-result", "oracle-comparison-spec", "oracle-conformance-suite", "oracle-declaration", "oracle-evaluator-conformance", "oracle-operand", "oracle-operand-production-result", "oracle-projection", "oracle-projection-plan", "oracle-projection-query", "oracle-projection-source", "oracle-value", "parser", "patch", "patch-template", "pattern-compiler-profile", "pattern-evaluation-result", "pattern-plan", "pattern-query", "pattern-result", "pattern-side-condition", "pattern-source", "postcondition", "precondition", "predicate-conformance-table", "predicate-plan", "predicate-query", "predicate-source", "program", "provenance-mutation-report", "reachability-conformance-table", "reachability-plan", "reachability-query", "reachability-source", "reachability-witness", "replay-manifest", "replay-version-registry", "report-publication-result", "semantic-crash", "semantic-output-bytes", "semantic-output-finite-table", "side-condition-conformance-table", "solver-profile", "structural-diff", "terminal-state", "transformation"
      ]
    },
    "artifactKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "digest"],
      "properties": {
        "role": {"$ref": "#/$defs/artifactRole"},
        "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}
      }
    },
    "adapterContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapterId", "adapterVersion"],
      "properties": {
        "adapterId": {"type": "string", "minLength": 1},
        "adapterVersion": {"type": "integer", "minimum": 1}
      }
    },
    "artifactEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeRole", "artifact"],
      "properties": {
        "edgeRole": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "artifact": {"$ref": "#/$defs/artifactKey"}
      }
    },
    "receiptEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeRole", "receipt"],
      "properties": {
        "edgeRole": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "digest"],
          "properties": {
            "role": {"const": "operation-receipt"},
            "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}
          }
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producerId", "producerVersion", "executionConformance"],
      "properties": {
        "producerId": {"type": "string", "minLength": 1},
        "producerVersion": {"type": "integer", "minimum": 1},
        "executionConformance": {"enum": ["finite-vector-proven", "native-proven", "not-proven"]}
      }
    },
    "patternProducerFailure": {
      "allOf": [
        {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/failure"},
        {
          "type": "object",
          "required": ["stage", "classification", "context", "scope", "retryability"],
          "properties": {
            "stage": {"const": "infrastructure"},
            "context": {"const": "pattern-test"},
            "scope": {"const": "test"}
          },
          "oneOf": [
            {
              "required": ["classification", "retryability"],
              "properties": {
                "classification": {"enum": ["process-launch", "io", "worker-lost"]},
                "retryability": {"const": "after-external-repair"}
              }
            },
            {
              "required": ["classification", "retryability"],
              "properties": {
                "classification": {"enum": ["artifact-corruption", "internal"]},
                "retryability": {"const": "never"}
              }
            }
          ]
        }
      ]
    },
    "patternPathExecutionFailure": {
      "allOf": [
        {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/patternPathFailure"},
        {
          "type": "object",
          "required": ["stage", "classification", "context", "scope"],
          "properties": {
            "stage": {"const": "execution"},
            "classification": {"enum": ["depth-limit", "time-limit", "branch-limit", "result-limit", "resource-limit", "solver-unknown", "backend-error"]},
            "context": {"const": "pattern-path"},
            "scope": {"const": "path"}
          }
        }
      ]
    },
    "patternTestExecutionFailure": {
      "allOf": [
        {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/patternTestFailure"},
        {
          "type": "object",
          "required": ["stage", "classification", "context", "scope"],
          "properties": {
            "stage": {"const": "execution"},
            "classification": {"enum": ["depth-limit", "time-limit", "branch-limit", "result-limit", "resource-limit", "solver-unknown", "backend-error"]},
            "context": {"const": "pattern-test"},
            "scope": {"const": "test"}
          }
        }
      ]
    },
    "cause": {
      "oneOf": [
        {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/failure"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "firstIndeterminate"],
          "properties": {
            "kind": {"const": "indeterminate-denotation"},
            "firstIndeterminate": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/firstIndeterminate"}
          }
        }
      ]
    }
  }
}
