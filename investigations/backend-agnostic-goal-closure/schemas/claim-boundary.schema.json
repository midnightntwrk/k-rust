{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/claim-boundary.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "representation", "portableScope", "wholeKAdapterStatus", "nativeAdapterStatus", "parsedKRoundTripStatus", "unsupportedForms"],
  "properties": {
    "schemaVersion": {"const": 1},
    "representation": {"const": "portable-mutation-semantic-slice-v1"},
    "portableScope": {"const": "explicitly-declared-supported-surface-only"},
    "wholeKAdapterStatus": {"const": "not-proven"},
    "nativeAdapterStatus": {"const": "future-proof-required"},
    "parsedKRoundTripStatus": {"const": "future-proof-required"},
    "unsupportedForms": {"const": "reject"}
  }
}
