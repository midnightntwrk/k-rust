{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/lowering-proof-check-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "checkerId",
    "checkerVersion",
    "proof",
    "subject",
    "loweringProfileDigest",
    "executionProfileDigest",
    "relationId",
    "checkedResult"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "receiptId": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "checkerId": {
      "const": "portable-finite-cycle-checker"
    },
    "checkerVersion": {
      "const": 1
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "digest"
      ],
      "properties": {
        "role": {
          "const": "lowering-cycle-proof"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "subject": {
      "$ref": "lowering-cycle-proof.schema.json#/$defs/subject"
    },
    "loweringProfileDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "executionProfileDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "relationId": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "checkedResult": {
      "const": "nontermination-confirmed"
    }
  }
}
