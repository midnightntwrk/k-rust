{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/predicate-semantics.schema.json",
  "title": "Structured predicate plan, query, and finite conformance table v1",
  "oneOf": [
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/query"
    },
    {
      "$ref": "#/$defs/table"
    }
  ],
  "$defs": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "planId",
        "inputRole",
        "inputSchemaDigest",
        "inputProjectionDigest",
        "variables",
        "resultSort",
        "evaluationMode"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "planId": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "inputRole": {
          "$ref": "common.schema.json#/$defs/artifactRole"
        },
        "inputSchemaDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "inputProjectionDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sort"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9_]*$"
              },
              "sort": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "uniqueItems": true
        },
        "resultSort": {
          "const": "Bool"
        },
        "evaluationMode": {
          "enum": [
            "finite-table-v1",
            "k-authored-v1"
          ]
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "queryId",
        "source",
        "plan"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "queryId": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "digest"
          ],
          "properties": {
            "role": {
              "const": "predicate-source"
            },
            "digest": {
              "$ref": "common.schema.json#/$defs/digest"
            }
          }
        },
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "digest"
          ],
          "properties": {
            "role": {
              "const": "predicate-plan"
            },
            "digest": {
              "$ref": "common.schema.json#/$defs/digest"
            }
          }
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "tableId",
        "rows"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "tableId": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "query",
              "testInvocationDigest",
              "subject",
              "producerTrace",
              "input",
              "inputProjectionDigest",
              "bindings",
              "bindingsDigest",
              "result"
            ],
            "properties": {
              "query": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "digest"
                ],
                "properties": {
                  "role": {
                    "const": "predicate-query"
                  },
                  "digest": {
                    "$ref": "common.schema.json#/$defs/digest"
                  }
                }
              },
              "input": {
                "$ref": "common.schema.json#/$defs/artifactKey"
              },
              "inputProjectionDigest": {
                "$ref": "common.schema.json#/$defs/digest"
              },
              "testInvocationDigest": {
                "$ref": "common.schema.json#/$defs/digest"
              },
              "subject": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "side",
                      "definitionDigest"
                    ],
                    "properties": {
                      "side": {
                        "const": "baseline"
                      },
                      "definitionDigest": {
                        "$ref": "common.schema.json#/$defs/digest"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "side",
                      "baselineDefinitionDigest",
                      "mutantId",
                      "mutantDefinitionDigest"
                    ],
                    "properties": {
                      "side": {
                        "const": "mutant"
                      },
                      "baselineDefinitionDigest": {
                        "$ref": "common.schema.json#/$defs/digest"
                      },
                      "mutantId": {
                        "$ref": "common.schema.json#/$defs/digest"
                      },
                      "mutantDefinitionDigest": {
                        "$ref": "common.schema.json#/$defs/digest"
                      }
                    }
                  }
                ]
              },
              "producerTrace": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "digest"
                ],
                "properties": {
                  "role": {
                    "const": "event-trace"
                  },
                  "digest": {
                    "$ref": "common.schema.json#/$defs/digest"
                  }
                }
              },
              "bindings": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/binding"
                }
              },
              "bindingsDigest": {
                "$ref": "common.schema.json#/$defs/digest"
              },
              "result": {
                "type": "boolean"
              }
            }
          },
          "minItems": 1
        }
      }
    }
  }
}
