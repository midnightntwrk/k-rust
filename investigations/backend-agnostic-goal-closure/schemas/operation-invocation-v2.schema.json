{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v2/operation-invocation-v2.schema.json",
  "title": "Closed BAG-16 operation invocation union v2",
  "oneOf": [
    {"$ref": "#/$defs/executionAttempt"},
    {"$ref": "#/$defs/patternEvaluation"},
    {"$ref": "#/$defs/corpusDerivation"},
    {"$ref": "#/$defs/oracleOperandProduction"}
  ],
  "$defs": {
    "typedKey": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/bag16-common.schema.json#/$defs/artifactKey"},
    "artifactEdge": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/bag16-common.schema.json#/$defs/artifactEdge"},
    "receiptEdge": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/bag16-common.schema.json#/$defs/receiptEdge"},
    "subject": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/cache-semantics-v2.schema.json#/$defs/subject"},
    "invocationCommonProperties": {
      "schemaVersion": {"const": 2},
      "invocationDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
      "operationKind": {"enum": ["execution-attempt", "pattern-evaluation", "corpus-derivation", "oracle-operand-production"]},
      "operationVersion": {"enum": [1, 2]},
      "adapterContract": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/bag16-common.schema.json#/$defs/adapterContract"},
      "parameters": {"type": "object"},
      "inputs": {"type": "array"},
      "childReceipts": {"type": "array"},
      "outputRoles": {"type": "array"}
    },
    "executionParameters": {
      "type": "object", "additionalProperties": false,
      "required": ["executionKey", "keyDigest"],
      "properties": {"executionKey": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/cache-semantics-v2.schema.json#/$defs/executionAttemptKey"}, "keyDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}}
    },
    "executionAttempt": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "invocationDigest", "operationKind", "operationVersion", "adapterContract", "parameters", "inputs", "childReceipts", "outputRoles"],
      "properties": {
        "schemaVersion": {"const": 2}, "invocationDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}, "operationKind": {"const": "execution-attempt"}, "operationVersion": {"const": 2}, "adapterContract": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/bag16-common.schema.json#/$defs/adapterContract"},
        "parameters": {"$ref": "#/$defs/executionParameters"},
        "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactEdge"}},
        "childReceipts": {"type": "array", "maxItems": 0},
        "outputRoles": {"type": "array", "prefixItems": [{"const": "execution-attempt-result"}], "items": false, "minItems": 1, "maxItems": 1}
      }
    },
    "patternEvaluationParameters": {
      "type": "object", "additionalProperties": false,
      "required": ["collection", "executionResult", "patternSource", "patternPlan", "patternQuery", "sideConditionTable", "searchPolicy"],
      "properties": {
        "collection": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/collectionKey"},
        "executionResult": {"$ref": "#/$defs/executionResultKey"},
        "patternSource": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/patternSourceKey"},
        "patternPlan": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/patternPlanKey"},
        "patternQuery": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/patternQueryKey"},
        "sideConditionTable": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/sideConditionTableKey"},
        "searchPolicy": {"enum": ["exhaustive", "existential-first"]}
      }
    },
    "executionResultKey": {
      "type": "object", "additionalProperties": false, "required": ["role", "digest"],
      "properties": {"role": {"const": "execution-attempt-result"}, "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}}
    },
    "patternEvaluationResultKey": {
      "type": "object", "additionalProperties": false, "required": ["role", "digest"],
      "properties": {"role": {"const": "pattern-evaluation-result"}, "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}}
    },
    "patternResultKey": {
      "type": "object", "additionalProperties": false, "required": ["role", "digest"],
      "properties": {"role": {"const": "pattern-result"}, "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}}
    },
    "patternEvaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "invocationDigest", "operationKind", "operationVersion", "adapterContract", "parameters", "inputs", "childReceipts", "outputRoles"],
      "properties": {
        "schemaVersion": {"const": 2}, "invocationDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}, "operationKind": {"const": "pattern-evaluation"}, "operationVersion": {"const": 1}, "adapterContract": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/bag16-common.schema.json#/$defs/adapterContract"},
        "parameters": {"$ref": "#/$defs/patternEvaluationParameters"},
        "inputs": {
          "type": "array", "minItems": 6, "maxItems": 6, "items": false,
          "prefixItems": [
            {"$ref": "#/$defs/executionResultEdge"}, {"$ref": "#/$defs/collectionEdge"}, {"$ref": "#/$defs/patternSourceEdge"}, {"$ref": "#/$defs/patternPlanEdge"}, {"$ref": "#/$defs/patternQueryEdge"}, {"$ref": "#/$defs/sideConditionTableEdge"}
          ]
        },
        "childReceipts": {"type": "array", "prefixItems": [{"$ref": "#/$defs/executionProductionEdge"}], "items": false, "minItems": 1, "maxItems": 1},
        "outputRoles": {"type": "array", "prefixItems": [{"const": "pattern-evaluation-result"}], "items": false, "minItems": 1, "maxItems": 1}
      }
    },
    "corpusManifestKey": {
      "type": "object", "additionalProperties": false, "required": ["role", "digest"],
      "properties": {"role": {"const": "corpus-manifest"}, "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}}
    },
    "componentResultKey": {
      "type": "object", "additionalProperties": false, "required": ["role", "digest"],
      "properties": {"role": {"const": "corpus-component-result"}, "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}}
    },
    "corpusParameters": {
      "type": "object", "additionalProperties": false,
      "required": ["corpusManifest", "schedulingPolicy", "components"],
      "properties": {
        "corpusManifest": {"$ref": "#/$defs/corpusManifestKey"},
        "schedulingPolicy": {"enum": ["full", "stop-after-test-match"]},
        "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/componentResultKey"}}
      }
    },
    "corpusDerivation": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "invocationDigest", "operationKind", "operationVersion", "adapterContract", "parameters", "inputs", "childReceipts", "outputRoles"],
      "properties": {
        "schemaVersion": {"const": 2}, "invocationDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}, "operationKind": {"const": "corpus-derivation"}, "operationVersion": {"const": 1}, "adapterContract": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/bag16-common.schema.json#/$defs/adapterContract"},
        "parameters": {"$ref": "#/$defs/corpusParameters"},
        "inputs": {"type": "array", "minItems": 2, "prefixItems": [{"$ref": "#/$defs/corpusManifestEdge"}], "items": {"$ref": "#/$defs/componentResultEdge"}},
        "childReceipts": {"type": "array", "items": {"$ref": "#/$defs/corpusChildReceiptEdge"}},
        "outputRoles": {"type": "array", "prefixItems": [{"const": "corpus-derivation-result"}], "items": false, "minItems": 1, "maxItems": 1}
      }
    },
    "occurrenceJoin": {
      "type": "object", "additionalProperties": false,
      "required": ["collection", "branchKey", "traceOccurrence"],
      "properties": {"collection": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/collectionKey"}, "branchKey": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}, "traceOccurrence": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}}
    },
    "oraclePatternParameters": {
      "type": "object", "additionalProperties": false,
      "required": ["projectionKind", "declaration", "subject", "patternEvaluationInvocation", "patternEvaluationResult", "patternResult", "collection", "patternSource", "patternPlan", "patternQuery", "sideConditionTable", "searchPolicy"],
      "properties": {
        "projectionKind": {"const": "execution-pattern"}, "declaration": {"$ref": "#/$defs/declarationKey"}, "subject": {"$ref": "#/$defs/subject"},
        "patternEvaluationInvocation": {"$ref": "#/$defs/patternEvaluation"}, "patternEvaluationResult": {"$ref": "#/$defs/patternEvaluationResultKey"}, "patternResult": {"$ref": "#/$defs/patternResultKey"}, "collection": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/collectionKey"},
        "patternSource": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/patternSourceKey"}, "patternPlan": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/patternPlanKey"}, "patternQuery": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/patternQueryKey"}, "sideConditionTable": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/sideConditionTableKey"}, "searchPolicy": {"enum": ["exhaustive", "existential-first"]}
      }
    },
    "oracleFiniteParameters": {
      "type": "object", "additionalProperties": false,
      "required": ["projectionKind", "declaration", "subject", "executionInvocation", "executionResult", "collection", "finiteTable", "finiteRow", "occurrences"],
      "properties": {
        "projectionKind": {"enum": ["concrete-output", "reachability", "structured-predicate"]}, "declaration": {"$ref": "#/$defs/declarationKey"}, "subject": {"$ref": "#/$defs/subject"},
        "executionInvocation": {"$ref": "#/$defs/executionAttempt"}, "executionResult": {"$ref": "#/$defs/executionResultKey"}, "collection": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/collectionKey"},
        "finiteTable": {"$ref": "#/$defs/typedKey"},
        "finiteRow": {"oneOf": [
          {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/oracle-semantics.schema.json#/$defs/outputFiniteTable/properties/rows/items"},
          {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/reachability-semantics.schema.json#/$defs/table/properties/rows/items"},
          {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/predicate-semantics.schema.json#/$defs/table/properties/rows/items"}
        ]},
        "occurrences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/occurrenceJoin"}}
      },
      "oneOf": [
        {"properties": {
          "projectionKind": {"const": "concrete-output"},
          "finiteTable": {"type": "object", "required": ["role"], "properties": {"role": {"const": "semantic-output-finite-table"}}},
          "finiteRow": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/oracle-semantics.schema.json#/$defs/outputFiniteTable/properties/rows/items"}
        }},
        {"properties": {
          "projectionKind": {"const": "reachability"},
          "finiteTable": {"type": "object", "required": ["role"], "properties": {"role": {"const": "reachability-conformance-table"}}},
          "finiteRow": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/reachability-semantics.schema.json#/$defs/table/properties/rows/items"}
        }},
        {"properties": {
          "projectionKind": {"const": "structured-predicate"},
          "finiteTable": {"type": "object", "required": ["role"], "properties": {"role": {"const": "predicate-conformance-table"}}},
          "finiteRow": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/predicate-semantics.schema.json#/$defs/table/properties/rows/items"}
        }}
      ]
    },
    "oracleOperandProduction": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "invocationDigest", "operationKind", "operationVersion", "adapterContract", "parameters", "inputs", "childReceipts", "outputRoles"],
      "properties": {
        "schemaVersion": {"const": 2}, "invocationDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}, "operationKind": {"const": "oracle-operand-production"}, "operationVersion": {"const": 2}, "adapterContract": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/bag16-common.schema.json#/$defs/adapterContract"},
        "parameters": {"oneOf": [{"$ref": "#/$defs/oraclePatternParameters"}, {"$ref": "#/$defs/oracleFiniteParameters"}]},
        "inputs": {"oneOf": [{"$ref": "#/$defs/oraclePatternInputs"}, {"$ref": "#/$defs/concreteOutputInputs"}, {"$ref": "#/$defs/reachabilityInputs"}, {"$ref": "#/$defs/predicateInputs"}]},
        "childReceipts": {"type": "array", "prefixItems": [{"$ref": "#/$defs/oracleChildReceiptEdge"}], "items": false, "minItems": 1, "maxItems": 1},
        "outputRoles": {"type": "array", "prefixItems": [{"const": "oracle-operand-production-result"}], "items": false, "minItems": 1, "maxItems": 1}
      }
    },
    "declarationKey": {"type": "object", "additionalProperties": false, "required": ["role", "digest"], "properties": {"role": {"const": "oracle-declaration"}, "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}}},
    "specificArtifactEdge": {"type": "object", "additionalProperties": false, "required": ["edgeRole", "artifact"], "properties": {"edgeRole": {"type": "string"}, "artifact": {"$ref": "#/$defs/typedKey"}}},
    "executionResultEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "execution-result"}, "artifact": {"$ref": "#/$defs/executionResultKey"}}}]},
    "collectionEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "branch-collection"}, "artifact": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/collectionKey"}}}]},
    "patternSourceEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "pattern-source"}, "artifact": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/patternSourceKey"}}}]},
    "patternPlanEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "pattern-plan"}, "artifact": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/patternPlanKey"}}}]},
    "patternQueryEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "pattern-query"}, "artifact": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/patternQueryKey"}}}]},
    "sideConditionTableEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "side-condition-conformance-table"}, "artifact": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/sideConditionTableKey"}}}]},
    "corpusManifestEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "corpus-manifest"}, "artifact": {"$ref": "#/$defs/corpusManifestKey"}}}]},
    "componentResultEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "component-result"}, "artifact": {"$ref": "#/$defs/componentResultKey"}}}]},
    "executionProductionEdge": {"allOf": [{"$ref": "#/$defs/receiptEdge"}, {"properties": {"edgeRole": {"const": "execution-production"}}}]},
    "oracleChildReceiptEdge": {"allOf": [{"$ref": "#/$defs/receiptEdge"}, {"properties": {"edgeRole": {"enum": ["execution-production", "pattern-evaluation-production"]}}}]},
    "corpusChildReceiptEdge": {"allOf": [{"$ref": "#/$defs/receiptEdge"}, {"properties": {"edgeRole": {"enum": ["execution-production", "pattern-evaluation-production"]}}}]},
    "oraclePatternInputs": {"type": "array", "minItems": 4, "maxItems": 4, "items": false, "prefixItems": [{"$ref": "#/$defs/declarationEdge"}, {"$ref": "#/$defs/patternEvaluationResultEdge"}, {"$ref": "#/$defs/patternResultEdge"}, {"$ref": "#/$defs/collectionEdge"}]},
    "concreteOutputInputs": {"type": "array", "minItems": 5, "maxItems": 5, "items": false, "prefixItems": [{"$ref": "#/$defs/declarationEdge"}, {"$ref": "#/$defs/executionResultEdge"}, {"$ref": "#/$defs/collectionEdge"}, {"$ref": "#/$defs/outputTableEdge"}, {"$ref": "#/$defs/rowTerminalEdge"}]},
    "reachabilityInputs": {"type": "array", "minItems": 6, "prefixItems": [{"$ref": "#/$defs/declarationEdge"}, {"$ref": "#/$defs/executionResultEdge"}, {"$ref": "#/$defs/collectionEdge"}, {"$ref": "#/$defs/reachabilityTableEdge"}, {"$ref": "#/$defs/reachabilityQueryEdge"}], "items": {"$ref": "#/$defs/rowTerminalEdge"}},
    "predicateInputs": {"type": "array", "minItems": 6, "maxItems": 6, "items": false, "prefixItems": [{"$ref": "#/$defs/declarationEdge"}, {"$ref": "#/$defs/executionResultEdge"}, {"$ref": "#/$defs/collectionEdge"}, {"$ref": "#/$defs/predicateTableEdge"}, {"$ref": "#/$defs/predicateQueryEdge"}, {"$ref": "#/$defs/predicateInputEdge"}]},
    "declarationEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "declaration"}, "artifact": {"$ref": "#/$defs/declarationKey"}}}]},
    "patternEvaluationResultEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "pattern-evaluation-result"}, "artifact": {"$ref": "#/$defs/patternEvaluationResultKey"}}}]},
    "patternResultEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "pattern-result"}, "artifact": {"$ref": "#/$defs/patternResultKey"}}}]},
    "outputTableEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "semantic-output-finite-table"}, "artifact": {"properties": {"role": {"const": "semantic-output-finite-table"}}}}}]},
    "reachabilityTableEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "reachability-conformance-table"}, "artifact": {"properties": {"role": {"const": "reachability-conformance-table"}}}}}]},
    "reachabilityQueryEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "reachability-query"}, "artifact": {"properties": {"role": {"const": "reachability-query"}}}}}]},
    "predicateTableEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "predicate-conformance-table"}, "artifact": {"properties": {"role": {"const": "predicate-conformance-table"}}}}}]},
    "predicateQueryEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "predicate-query"}, "artifact": {"properties": {"role": {"const": "predicate-query"}}}}}]},
    "rowTerminalEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "row-terminal"}, "artifact": {"properties": {"role": {"enum": ["terminal-state", "semantic-crash"]}}}}}]},
    "predicateInputEdge": {"allOf": [{"$ref": "#/$defs/specificArtifactEdge"}, {"properties": {"edgeRole": {"const": "predicate-input"}, "artifact": {"properties": {"role": {"const": "terminal-state"}}}}}]}
  }
}
