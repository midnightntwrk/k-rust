{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/portable-closure-root.schema.json",
  "title": "Sole advertised BAG-16 portable closure envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "closureId", "rootKind", "result", "receipt", "cacheRecords", "artifactRoleSpecs", "artifactCatalog", "registry"],
  "properties": {
    "schemaVersion": {"const": 1},
    "closureId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "rootKind": {"enum": ["execution-attempt-result", "pattern-evaluation-result", "corpus-derivation-result", "oracle-operand-production-result"]},
    "result": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false, "required": ["role", "digest"],
          "properties": {"role": {"enum": ["execution-attempt-result", "pattern-evaluation-result", "corpus-derivation-result", "oracle-operand-production-result"]}, "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}}
        }
      ]
    },
    "receipt": {
      "type": "object", "additionalProperties": false, "required": ["role", "digest"],
      "properties": {"role": {"const": "operation-receipt"}, "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}}
    },
    "cacheRecords": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["role", "digest"],
        "properties": {"role": {"const": "cache-record"}, "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}}
      }
    },
    "artifactRoleSpecs": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/artifact-role-specs-v2.schema.json"},
    "artifactCatalog": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/artifact-catalog-v2.schema.json"},
    "registry": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/replay-version-registry-v2.schema.json"}
  }
}
