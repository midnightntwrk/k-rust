{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/corpus-component-invocation.schema.json",
  "title": "Cycle-free corpus slot component invocation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "componentInvocationId", "corpusManifest", "slotId", "testOrdinal", "slotOrdinal", "executionAttemptKey", "patternEvaluationRequest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "componentInvocationId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "corpusManifest": {"$ref": "#/$defs/corpusManifestKey"},
    "slotId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "testOrdinal": {"type": "integer", "minimum": 0},
    "slotOrdinal": {"type": "integer", "minimum": 0},
    "executionAttemptKey": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/cache-semantics-v2.schema.json#/$defs/executionAttemptKey"},
    "patternEvaluationRequest": {"$ref": "#/$defs/patternEvaluationRequest"}
  },
  "$defs": {
    "corpusManifestKey": {
      "type": "object", "additionalProperties": false, "required": ["role", "digest"],
      "properties": {"role": {"const": "corpus-manifest"}, "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}}
    },
    "patternEvaluationRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["operationKind", "operationVersion", "patternSource", "patternPlan", "patternQuery", "sideConditionTable", "searchPolicy"],
      "properties": {
        "operationKind": {"const": "pattern-evaluation"},
        "operationVersion": {"const": 1},
        "patternSource": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/patternSourceKey"},
        "patternPlan": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/patternPlanKey"},
        "patternQuery": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/patternQueryKey"},
        "sideConditionTable": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/pattern-result-v2.schema.json#/$defs/sideConditionTableKey"},
        "searchPolicy": {"enum": ["exhaustive", "existential-first"]}
      }
    }
  }
}
