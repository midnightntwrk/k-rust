{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v2/artifact-catalog-v2.schema.json",
  "title": "Version-dispatched portable artifact catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "roleSpecRegistryId", "entries", "unboundRequirements"],
  "properties": {
    "schemaVersion": {"const": 2},
    "catalogId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "roleSpecRegistryId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "unboundRequirements": {"type": "array", "items": {"$ref": "#/$defs/unboundRequirement"}}
  },
  "$defs": {
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "digest", "contentModel", "mediaType", "contentSha256", "availability", "logicalPath", "resolverId"],
      "properties": {
        "role": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/bag16-common.schema.json#/$defs/artifactRole"},
        "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
        "contentModel": {"enum": ["canonical-json", "opaque-bytes"]},
        "mediaType": {"enum": ["application/json", "application/octet-stream"]},
        "contentSha256": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
        "availability": {"enum": ["bundled", "external-required"]},
        "logicalPath": {"type": "string", "pattern": "^(repo|artifact)://[^/].*$"},
        "resolverId": {"enum": ["repo-v1", "rust-artifact-store-v1"]}
      }
    },
    "unboundRequirement": {
      "type": "object", "additionalProperties": false,
      "required": ["requirementId", "role"],
      "properties": {"requirementId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "role": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/bag16-common.schema.json#/$defs/artifactRole"}}
    }
  }
}
