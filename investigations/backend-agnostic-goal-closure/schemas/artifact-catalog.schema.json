{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/artifact-catalog.schema.json",
  "title": "Portable role-typed artifact catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "entries", "unboundRequirements"],
  "properties": {
    "schemaVersion": {"const": 1},
    "catalogId": {"$ref": "common.schema.json#/$defs/digest"},
    "entries": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "digest", "contentModel", "mediaType", "contentSha256", "availability", "logicalPath", "resolverId"],
      "properties": {
        "role": {"$ref": "common.schema.json#/$defs/artifactRole"},
        "digest": {"$ref": "common.schema.json#/$defs/digest"},
        "contentModel": {"type": "string", "enum": ["canonical-json", "opaque-bytes"]},
        "mediaType": {"type": "string", "enum": ["application/json", "application/octet-stream"]},
        "contentSha256": {"$ref": "common.schema.json#/$defs/digest"},
        "availability": {"type": "string", "enum": ["bundled", "external-required"]},
        "logicalPath": {"type": "string", "pattern": "^(repo|artifact)://[^/].*$"},
        "resolverId": {"type": "string", "enum": ["repo-v1", "rust-artifact-store-v1"]}
      }
    }},
    "unboundRequirements": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["requirementId", "role"],
        "properties": {
          "requirementId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "role": {"$ref": "common.schema.json#/$defs/artifactRole"}
        }
      }
    }
  }
}
