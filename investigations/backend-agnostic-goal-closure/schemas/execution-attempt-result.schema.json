{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/execution-attempt-result.schema.json",
  "title": "Portable execution-attempt-result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resultId",
    "keyDigest",
    "invocationDigest",
    "terminalRecord",
    "producedArtifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "resultId": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "keyDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "invocationDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "terminalRecord": {
      "$ref": "cache-semantics.schema.json#/$defs/executionTerminalRecord"
    },
    "producedArtifacts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/artifactKey"
      },
      "uniqueItems": true
    }
  }
}
