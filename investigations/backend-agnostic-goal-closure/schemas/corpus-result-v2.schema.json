{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v2/corpus-result-v2.schema.json",
  "title": "Ordered collection-aware corpus result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusResultId", "corpusManifest", "schedulingPolicy", "components", "testResults", "decision"],
  "properties": {
    "schemaVersion": {"const": 2},
    "corpusResultId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "corpusManifest": {"$ref": "#/$defs/manifestKey"},
    "schedulingPolicy": {"enum": ["full", "stop-after-test-match"]},
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/componentKey"}},
    "testResults": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/testResult"}},
    "decision": {"$ref": "#/$defs/corpusDecision"}
  },
  "$defs": {
    "manifestKey": {
      "type": "object", "additionalProperties": false, "required": ["role", "digest"],
      "properties": {"role": {"const": "corpus-manifest"}, "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}}
    },
    "componentKey": {
      "type": "object", "additionalProperties": false, "required": ["role", "digest"],
      "properties": {"role": {"const": "corpus-component-result"}, "digest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}}
    },
    "selectedDecision": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["match", "no-match"]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "causeComponent", "cause"], "properties": {"kind": {"enum": ["unknown", "error"]}, "causeComponent": {"$ref": "#/$defs/componentKey"}, "cause": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/bag16-common.schema.json#/$defs/cause"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "schedulingReason"], "properties": {"kind": {"const": "skipped"}, "schedulingReason": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/corpus-component-result.schema.json#/$defs/schedulingReason"}}}
      ]
    },
    "testResult": {
      "type": "object", "additionalProperties": false,
      "required": ["testOrdinal", "slots", "decision"],
      "properties": {
        "testOrdinal": {"type": "integer", "minimum": 0},
        "slots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/componentKey"}},
        "decision": {"$ref": "#/$defs/selectedDecision"}
      }
    },
    "corpusDecision": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "completeCoverage"], "properties": {"kind": {"const": "match"}, "completeCoverage": {"type": "boolean"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "completeCoverage"], "properties": {"kind": {"const": "no-match"}, "completeCoverage": {"const": true}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "completeCoverage", "causeComponent", "cause"], "properties": {"kind": {"enum": ["unknown", "error"]}, "completeCoverage": {"const": false}, "causeComponent": {"$ref": "#/$defs/componentKey"}, "cause": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v2/bag16-common.schema.json#/$defs/cause"}}}
      ]
    }
  }
}
