{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/event-trace.schema.json",
  "title": "Branch-local semantic event trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "definitionDigest", "testId", "pathOrdinal", "pathKey", "pathIdentityDigest", "pathPredicate", "complete", "stopReason", "executionTerminal", "events"],
  "properties": {
    "schemaVersion": {"const": 1},
    "definitionDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "testId": {"type": "string", "minLength": 1},
    "pathOrdinal": {"type": "integer", "minimum": 0},
    "pathKey": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "pathIdentityDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "complete": {"type": "boolean"},
    "stopReason": {"type": "string", "enum": ["terminal", "stuck", "query-satisfied", "depth-limit", "time-limit", "branch-limit", "result-limit", "resource-limit", "solver-unknown", "error"]},
    "executionTerminal": {"$ref": "common.schema.json#/$defs/executionTerminal"},
    "pathPredicate": {"$ref": "common.schema.json#/$defs/term"},
    "events": {
      "type": "array",
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "transitionOrdinal", "emissionOrdinal", "constructor", "payload", "origin"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "transitionOrdinal": {"type": "integer", "minimum": 0},
        "emissionOrdinal": {"type": "integer", "minimum": 0},
        "constructor": {"type": "string", "minLength": 1},
        "payload": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/term"}},
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["emittingSentence", "semanticSite"],
          "properties": {
            "emittingSentence": {"$ref": "common.schema.json#/$defs/provenance"},
            "semanticSite": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["siteId", "role", "termPath"],
                  "properties": {
                    "siteId": {"$ref": "common.schema.json#/$defs/digest"},
                    "role": {"type": "string", "minLength": 1},
                    "termPath": {"$ref": "common.schema.json#/$defs/path"}
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
