{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/semantic-definition.schema.json",
  "title": "Portable semantic definition fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "representation", "family", "baselineFamilyId", "definitionDigest", "modules"],
  "properties": {
    "schemaVersion": {"const": 1},
    "representation": {"const": "portable-mutation-semantic-slice-v1"},
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["familyName", "entryModules", "compatibilityProfile"],
      "properties": {
        "familyName": {"type": "string", "minLength": 1},
        "entryModules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "compatibilityProfile": {"type": "string", "minLength": 1}
      }
    },
    "baselineFamilyId": {"$ref": "common.schema.json#/$defs/digest"},
    "definitionDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ordinal", "fingerprint", "imports", "sentences"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "ordinal": {"type": "integer", "minimum": 0},
          "fingerprint": {"$ref": "common.schema.json#/$defs/digest"},
          "imports": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "sentences": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceOccurrenceOrdinal", "generatedIdentity", "provenance", "value"],
              "properties": {
                "sourceOccurrenceOrdinal": {"type": ["integer", "null"], "minimum": 0},
                "generatedIdentity": {
                  "oneOf": [
                    {"type": "null"},
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["transformationId", "parentLineages", "anchorIdentity", "role", "ordinal"],
                      "properties": {
                        "transformationId": {"$ref": "common.schema.json#/$defs/digest"},
                        "parentLineages": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/digest"}},
                        "anchorIdentity": {"$ref": "common.schema.json#/$defs/digest"},
                        "role": {"type": "string", "enum": ["derived-claim", "derived-rule", "insert-after-lineage", "insert-before-lineage", "insert-module-end", "insert-module-start", "observation-update"]},
                        "ordinal": {"type": "integer", "minimum": 0}
                      },
                      "allOf": [
                        {"if": {"properties": {"role": {"enum": ["insert-module-end", "insert-module-start"]}}, "required": ["role"]}, "then": {"properties": {"parentLineages": {"maxItems": 0}}}, "else": {"properties": {"parentLineages": {"minItems": 1}}}}
                      ]
                    }
                  ]
                },
                "provenance": {"$ref": "common.schema.json#/$defs/provenance"},
                "value": {"$ref": "common.schema.json#/$defs/sentenceValue"}
              },
              "allOf": [
                {"if": {"properties": {"provenance": {"properties": {"generated": {"const": true}}, "required": ["generated"]}}, "required": ["provenance"]}, "then": {"properties": {"sourceOccurrenceOrdinal": {"type": "null"}, "generatedIdentity": {"type": "object"}}}},
                {"if": {"properties": {"provenance": {"properties": {"generated": {"const": false}}, "required": ["generated"]}}, "required": ["provenance"]}, "then": {"properties": {"sourceOccurrenceOrdinal": {"type": "integer", "minimum": 0}, "generatedIdentity": {"type": "null"}}}}
              ]
            }
          }
        }
      }
    }
  }
}
