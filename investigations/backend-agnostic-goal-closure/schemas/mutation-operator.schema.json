{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/mutation-operator.schema.json",
  "title": "Semantic mutation operator declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "operatorVersion", "operatorDigest", "moduleDigest", "phase", "sentenceKinds", "selectorDigest", "joinDigest", "policy", "expectedTupleCount", "expectedTupleArity", "candidateCap", "preconditionDigest", "postconditionDigest", "generatedSentencePolicy", "patchTemplateDigest", "patchTemplateRoles", "category", "rationale"],
  "properties": {
    "schemaVersion": {"const": 1},
    "operatorId": {"type": "string", "minLength": 1},
    "operatorVersion": {"type": "integer", "minimum": 1},
    "operatorDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "moduleDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "phase": {"type": "string", "enum": ["semantic-input"]},
    "sentenceKinds": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["rule", "claim", "context", "alias", "configuration"]}},
    "selectorDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "joinDigest": {"oneOf": [{"$ref": "common.schema.json#/$defs/digest"}, {"type": "null"}]},
    "policy": {"type": "string", "enum": ["exact", "each", "tuple-each", "all-matches"]},
    "expectedTupleCount": {"type": ["integer", "null"], "minimum": 1},
    "expectedTupleArity": {"type": "integer", "minimum": 1},
    "candidateCap": {"type": "integer", "minimum": 1},
    "preconditionDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "postconditionDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "generatedSentencePolicy": {"type": "string", "enum": ["exclude", "include", "only"]},
    "patchTemplateDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "patchTemplateRoles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "operation", "sourceSelectorRoles"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "operation": {"type": "string", "enum": ["replace-term", "replace-sentence", "delete-sentence", "insert-sentence", "replace-condition", "add-attribute", "remove-attribute", "replace-attribute"]},
          "sourceSelectorRoles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "category": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"policy": {"const": "exact"}}}, "then": {"properties": {"expectedTupleCount": {"type": "integer", "minimum": 1}}}},
    {"if": {"properties": {"policy": {"enum": ["each", "tuple-each", "all-matches"]}}}, "then": {"properties": {"expectedTupleCount": {"type": "null"}}}},
    {"if": {"properties": {"policy": {"enum": ["each", "all-matches"]}}}, "then": {"properties": {"joinDigest": {"type": "null"}, "expectedTupleArity": {"const": 1}}}},
    {"if": {"properties": {"policy": {"const": "tuple-each"}}}, "then": {"properties": {"joinDigest": {"$ref": "common.schema.json#/$defs/digest"}, "expectedTupleArity": {"type": "integer", "minimum": 2}}}}
  ]
}
