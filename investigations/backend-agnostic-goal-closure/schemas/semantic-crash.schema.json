{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/semantic-crash.schema.json",
  "title": "Object-language semantic crash v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "crashDigest", "executionProfileDigest", "terminalState", "classification"],
  "properties": {
    "schemaVersion": {"const": 1},
    "crashDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "executionProfileDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "terminalState": {"type": "object", "additionalProperties": false, "required": ["role", "digest"], "properties": {"role": {"const": "terminal-state"}, "digest": {"$ref": "common.schema.json#/$defs/digest"}}},
    "classification": {"const": "declared-object-language-crash"}
  }
}
