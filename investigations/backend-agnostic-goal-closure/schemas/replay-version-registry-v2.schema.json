{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v2/replay-version-registry-v2.schema.json",
  "title": "Exact recursive portable replay version registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryId", "schemas", "operations"],
  "properties": {
    "schemaVersion": {"const": 2},
    "registryId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "schemas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/schemaEntry"}},
    "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/operationEntry"}}
  },
  "$defs": {
    "schemaEntry": {
      "oneOf": [
        {"$ref": "#/$defs/historicalSchemaEntry"},
        {"$ref": "#/$defs/bag16V1SchemaEntry"},
        {"$ref": "#/$defs/bag16V2SchemaEntry"}
      ]
    },
    "entryShape": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaId", "schemaVersion", "schemaDigest"],
      "properties": {"schemaId": {"type": "string"}, "schemaVersion": {"type": "integer"}, "schemaDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"}}
    },
    "historicalSchemaEntry": {
      "allOf": [
        {"$ref": "#/$defs/entryShape"},
        {"properties": {
          "schemaId": {"enum": ["artifact-catalog.schema.json", "artifact-role-specs.schema.json", "baseline-admission-result.schema.json", "cache-semantics.schema.json", "campaign-derivation-result.schema.json", "claim-boundary.schema.json", "common.schema.json", "compatibility-profile.schema.json", "corpus-manifest.schema.json", "corpus-result.schema.json", "event-trace.schema.json", "execution-attempt-result.schema.json", "failure-taxonomy.schema.json", "lowering-cycle-proof.schema.json", "lowering-proof-check-receipt.schema.json", "mutation-campaign.schema.json", "mutation-execution-policy.schema.json", "mutation-manifest.schema.json", "mutation-materialization-result.schema.json", "mutation-operator.schema.json", "mutation-site-registry.schema.json", "observation-installation-result.schema.json", "observation-manifest.schema.json", "operation-receipt.schema.json", "oracle-comparison-production-result.schema.json", "oracle-operand-production-result.schema.json", "oracle-semantics.schema.json", "oracle-value.schema.json", "patch.schema.json", "pattern-plan.schema.json", "pattern-query.schema.json", "pattern-result.schema.json", "predicate-semantics.schema.json", "provenance-mutation-report.schema.json", "reachability-semantics.schema.json", "replay-closure.schema.json", "replay-manifest.schema.json", "replay-version-registry.schema.json", "report-publication-result.schema.json", "semantic-crash.schema.json", "semantic-definition.schema.json", "semantic-identity.schema.json", "side-condition-conformance-table.schema.json", "structural-diff.schema.json", "terminal-state.schema.json", "transformation.schema.json"]},
          "schemaVersion": {"const": 1}
        }}
      ]
    },
    "bag16V1SchemaEntry": {
      "allOf": [
        {"$ref": "#/$defs/entryShape"},
        {"properties": {"schemaId": {"enum": ["branch-trace-collection.schema.json", "corpus-component-invocation.schema.json", "corpus-component-result.schema.json", "corpus-derivation-result.schema.json", "empty-search-decision.schema.json", "pattern-evaluation-result.schema.json", "portable-closure-root.schema.json"]}, "schemaVersion": {"const": 1}}}
      ]
    },
    "bag16V2SchemaEntry": {
      "allOf": [
        {"$ref": "#/$defs/entryShape"},
        {"properties": {"schemaId": {"enum": ["artifact-catalog-v2.schema.json", "artifact-role-specs-v2.schema.json", "bag16-common.schema.json", "cache-semantics-v2.schema.json", "corpus-manifest-v2.schema.json", "corpus-result-v2.schema.json", "event-trace-v2.schema.json", "execution-attempt-result-v2.schema.json", "execution-test-invocation-v2.schema.json", "operation-invocation-v2.schema.json", "operation-receipt-v2.schema.json", "pattern-result-v2.schema.json", "replay-version-registry-v2.schema.json"]}, "schemaVersion": {"const": 2}}}
      ]
    },
    "operationEntry": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["operationKind", "operationVersion"], "properties": {"operationKind": {"enum": ["mutation-materialization", "execution-attempt", "oracle-operand-production", "baseline-admission", "oracle-comparison", "campaign-derivation", "report-publication"]}, "operationVersion": {"const": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["operationKind", "operationVersion"], "properties": {"operationKind": {"enum": ["execution-attempt", "oracle-operand-production"]}, "operationVersion": {"const": 2}}},
        {"type": "object", "additionalProperties": false, "required": ["operationKind", "operationVersion"], "properties": {"operationKind": {"enum": ["pattern-evaluation", "corpus-derivation"]}, "operationVersion": {"const": 1}}}
      ]
    }
  }
}
