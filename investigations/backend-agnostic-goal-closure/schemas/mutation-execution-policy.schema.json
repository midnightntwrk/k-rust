{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/mutation-execution-policy.schema.json",
  "title": "Portable mutation isolation policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "isolationPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "policyId": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "isolationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "isolationPolicyDigest",
        "baselineState",
        "mutantState",
        "sharedWritableState",
        "observerState"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "isolationPolicyDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "baselineState": {
          "const": "immutable"
        },
        "mutantState": {
          "const": "fresh-per-mutant"
        },
        "sharedWritableState": {
          "const": false
        },
        "observerState": {
          "const": "fresh-per-test-path"
        }
      }
    }
  }
}
