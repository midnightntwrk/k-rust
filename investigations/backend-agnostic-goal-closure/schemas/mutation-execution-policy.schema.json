{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v1/mutation-execution-policy.schema.json",
  "title": "Portable mutation isolation and cache identity policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "isolation", "cacheKey"],
  "properties": {
    "schemaVersion": {"const": 1},
    "policyId": {"$ref": "common.schema.json#/$defs/digest"},
    "isolation": {
      "type": "object", "additionalProperties": false,
      "required": ["baselineState", "mutantState", "sharedWritableState", "observerState"],
      "properties": {
        "baselineState": {"const": "immutable"},
        "mutantState": {"const": "fresh-per-mutant"},
        "sharedWritableState": {"const": false},
        "observerState": {"const": "fresh-per-test-path"}
      }
    },
    "cacheKey": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "baselineDefinitionDigest", "compatibilityProfileDigest", "operatorId", "operatorVersion", "patchId", "backendProfileDigest", "solverProfileDigest", "optionsDigest", "testManifestDigest", "oracleManifestDigest", "keyDigest"],
      "properties": {
        "domain": {"const": "k-in-k/mutation-cache-key/v1"},
        "baselineDefinitionDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "compatibilityProfileDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "operatorId": {"type": "string", "minLength": 1},
        "operatorVersion": {"type": "integer", "minimum": 1},
        "patchId": {"$ref": "common.schema.json#/$defs/digest"},
        "backendProfileDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "solverProfileDigest": {"oneOf": [{"$ref": "common.schema.json#/$defs/digest"}, {"type": "null"}]},
        "optionsDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "testManifestDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "oracleManifestDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "keyDigest": {"$ref": "common.schema.json#/$defs/digest"}
      }
    }
  }
}
