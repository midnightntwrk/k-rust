{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starstream.dev/k-in-k/backend-agnostic/v2/event-trace-v2.schema.json",
  "title": "Occurrence-neutral semantic event trace v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "traceId", "definitionDigest", "eventVocabularyDigest", "pathPredicate", "events"],
  "properties": {
    "schemaVersion": {"const": 2},
    "traceId": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "definitionDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "eventVocabularyDigest": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/digest"},
    "pathPredicate": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/common.schema.json#/$defs/term"},
    "events": {"type": "array", "items": {"$ref": "https://starstream.dev/k-in-k/backend-agnostic/v1/event-trace.schema.json#/$defs/event"}}
  }
}
