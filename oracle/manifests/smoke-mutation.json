      "expectedExitCodes": [1],
      "expectedStderrSubstrings": ["Uncaught exception", "GeneratedTopCell"],
      "artifacts": [
        { "id": "parsed-json", "path": "parsed.json", "profile": "k-json-v1" },
        { "id": "compiled-json", "path": "compiled.json", "profile": "k-json-v1" }
      ]
    },
    {
      "id": "full",
      "expectedExitCodes": [0],
      "artifacts": [
        { "id": "parsed-json", "path": "parsed.json", "profile": "k-json-v1" },
        { "id": "compiled-json", "path": "compiled.json", "profile": "k-json-v1" },
        { "id": "definition-kore", "path": "definition.kore", "profile": "kore-text-v1" },
        { "id": "syntax-kore", "path": "syntaxDefinition.kore", "profile": "kore-text-v1" },
        { "id": "macros-kore", "path": "macros.kore", "profile": "kore-text-v1" }
      ]
