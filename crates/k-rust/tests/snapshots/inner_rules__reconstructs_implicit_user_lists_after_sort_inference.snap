    "wrap(ids(#token(\"a\",\"Id\"),`.List{\"ids\"}`(.KList)))=>wrap(ids(#token(\"a\",\"Id\"),ids(#token(\"b\",\"Id\"),`.List{\"ids\"}`(.KList))))",
