---
source: crates/k-rust/tests/definition_regex.rs
description: "K regex:\n\n({Upper}{Lower})+|x(yz)?"
---
Regex {
    start_line: false,
    body: Union {
        left: OneOrMore(
            Concat(
                [
                    Named(
                        "Upper",
                    ),
                    Named(
                        "Lower",
                    ),
                ],
            ),
        ),
        right: Concat(
            [
                Char(
                    'x',
                ),
                ZeroOrOne(
                    Concat(
                        [
                            Char(
                                'y',
                            ),
                            Char(
                                'z',
                            ),
                        ],
                    ),
                ),
            ],
        ),
    },
    end_line: false,
}
