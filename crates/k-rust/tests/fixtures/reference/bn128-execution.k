module BN128-EXECUTION
  imports BOOL
  imports INT
  imports LIST

  syntax G1Point ::= "(" Int "," Int ")" [prefer]
  syntax G2Point ::= "(" Int "x" Int "," Int "x" Int ")"
  syntax G1Point ::= "BN128Add" "(" G1Point "," G1Point ")"
    [function, hook(KRYPTO.bn128add)]
                   | "BN128Mul" "(" G1Point "," Int ")"
    [function, hook(KRYPTO.bn128mul)]
  syntax Bool ::= "BN128AtePairing" "(" List "," List ")"
    [function, hook(KRYPTO.bn128ate)]
                | "isValidPoint" "(" G1Point ")"
    [function, hook(KRYPTO.bn128valid)]
                | "isValidG2Point" "(" G2Point ")"
    [function, hook(KRYPTO.bn128g2valid)]

  syntax Input ::= "ecadd-vector"
                 | "ecmul-vector"
                 | "ecmul-reduce"
                 | "pairing-cancel"
                 | "valid-infinity"
                 | G1Point
                 | Bool

  configuration <k> $PGM:Input </k>

  rule <k> ecadd-vector => BN128Add(
    (11169198337205317385038692134282557493133418158128574038999810944352461077961,
     2820885980102468247213289930888494165190958823101043243711917453290081841766),
    (3510227910005969626168871163796842095937160976810256674232777209574668193517,
     2885800476071299445182650755020278501280179672256593791439003311512581969879))
  </k>
  rule <k> ecmul-vector => BN128Mul((1, 2), 2) </k>
  rule <k> ecmul-reduce => BN128Mul(
    (1, 2),
    21888242871839275222246405745257275088548364400416034343698204186575808495619)
  </k>
  rule <k> pairing-cancel => BN128AtePairing(
    ListItem((1, 2))
      ListItem((1, 21888242871839275222246405745257275088696311157297823662689037894645226208581)),
    ListItem((
      10857046999023057135944570762232829481370756359578518086990519993285655852781
        x 11559732032986387107991004021392285783925812861821192530917403151452391805634,
      8495653923123431417604973247489272438418190587263600148770280649306958101930
        x 4082367875863433681332203403145435568316851327593401208105741076214120093531))
      ListItem((
        10857046999023057135944570762232829481370756359578518086990519993285655852781
          x 11559732032986387107991004021392285783925812861821192530917403151452391805634,
        8495653923123431417604973247489272438418190587263600148770280649306958101930
          x 4082367875863433681332203403145435568316851327593401208105741076214120093531)))
  </k>
  rule <k> valid-infinity => isValidPoint((0, 0)) </k>
endmodule
