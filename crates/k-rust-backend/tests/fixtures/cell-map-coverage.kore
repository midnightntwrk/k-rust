[]
module CELL-MAP-COVERAGE
  sort SortInt{} [hasDomainValues{}()]
  sort SortExp{} []
  sort SortStmt{} []
  sort SortKItem{} []
  sort SortK{} []
  sort SortKey{} [hasDomainValues{}()]
  sort SortThread{} []
  hooked-sort SortThreadMap{}
    [hook{}("MAP.Map"), unit{}(mapUnit{}()), element{}(mapItem{}()), concat{}(mapConcat{}())]
  sort SortState{} []
  symbol inj{From, To}(From) : To [sortInjection{}(), injective{}()]
  symbol dotk{}() : SortK{} [constructor{}(), total{}()]
  symbol kseq{}(SortKItem{}, SortK{}) : SortK{} [constructor{}(), total{}(), injective{}()]
  symbol expA{}() : SortExp{} [constructor{}(), total{}()]
  symbol expB{}() : SortExp{} [constructor{}(), total{}()]
  symbol stmt{}() : SortStmt{} [constructor{}(), total{}()]
  symbol heat{}(SortExp{}, SortExp{}) : SortExp{} [anywhere{}(), total{}(), injective{}()]
  symbol thread{}(SortKey{}, SortK{}) : SortThread{} [constructor{}(), total{}(), injective{}()]
  hooked-symbol mapUnit{}() : SortThreadMap{}
    [function{}(), total{}(), hook{}("MAP.unit")]
  hooked-symbol mapItem{}(SortKey{}, SortThread{}) : SortThreadMap{}
    [function{}(), total{}(), hook{}("MAP.element")]
  hooked-symbol mapConcat{}(SortThreadMap{}, SortThreadMap{}) : SortThreadMap{}
    [function{}(), hook{}("MAP.concat"), assoc{}(), comm{}()]
  symbol cellState{}(SortThreadMap{}) : SortState{} [constructor{}(), total{}()]
  symbol heated{}(SortKey{}, SortExp{}, SortExp{}, SortThreadMap{}) : SortState{}
    [constructor{}(), total{}()]
  symbol fallback{}() : SortState{} [constructor{}(), total{}()]
  axiom{R} \exists{R}(E:SortExp{}, \equals{SortExp{}, R}(
    E:SortExp{}, inj{SortInt{}, SortExp{}}(I:SortInt{})
  )) [subsort{SortInt{}, SortExp{}}()]
  axiom{R} \exists{R}(K:SortKItem{}, \equals{SortKItem{}, R}(
    K:SortKItem{}, inj{SortExp{}, SortKItem{}}(E:SortExp{})
  )) [subsort{SortExp{}, SortKItem{}}()]
  axiom{R} \exists{R}(K:SortKItem{}, \equals{SortKItem{}, R}(
    K:SortKItem{}, inj{SortStmt{}, SortKItem{}}(S:SortStmt{})
  )) [subsort{SortStmt{}, SortKItem{}}()]
  axiom{} \rewrites{SortState{}}(
    \and{SortState{}}(
      cellState{}(
        mapConcat{}(
          mapItem{}(
            KEY:SortKey{},
            thread{}(
              KEY:SortKey{},
              kseq{}(
                inj{SortExp{}, SortKItem{}}(heat{}(HOLE:SortExp{}, K1:SortExp{})),
                REST:SortK{}
              )
            )
          ),
          FRAME:SortThreadMap{}
        )
      ),
      \top{SortState{}}()
    ),
    heated{}(KEY:SortKey{}, HOLE:SortExp{}, K1:SortExp{}, FRAME:SortThreadMap{})
  ) [label{}("heat"), priority{}("40")]
  axiom{} \rewrites{SortState{}}(
    \and{SortState{}}(cellState{}(M:SortThreadMap{}), \top{SortState{}}()),
    fallback{}()
  ) [label{}("fallback"), priority{}("50")]
endmodule []
